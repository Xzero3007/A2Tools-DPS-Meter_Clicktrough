From 91b39717c2e236aa797eab18e5624a3b42a47f2a Mon Sep 17 00:00:00 2001
From: A2Tools-patch <patch@localhost>
Date: Tue, 27 Oct 2026 00:48:48 +0000
Subject: [PATCH] Pet Soul Tracker: no links to websites

This build links to no website the player hasn't chosen: a pet's row no
longer links to Aion 2 Timers' live map, and the credit to Aion 2 Timers
for the map pictures stays as text, not a link.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RahWACwaxzLAcYgwc9jk8C
---
 plugins/pet-souls/index.html  | 2 +-
 plugins/pet-souls/plugin.js   | 5 +++++
 plugins/pet-souls/style.css   | 5 +++++
 plugins/pet-souls/widget.css  | 5 +++++
 plugins/pet-souls/widget.html | 2 +-
 5 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/plugins/pet-souls/index.html b/plugins/pet-souls/index.html
index 711e566..c69ef62 100644
--- a/plugins/pet-souls/index.html
+++ b/plugins/pet-souls/index.html
@@ -53,7 +53,7 @@
           <button type="button" class="follow" title="Back to you" aria-label="Back to you" hidden>⌖</button>
         </div>
         <p class="mapNote" hidden></p>
-        <a class="mapCredit" href="https://www.aion2timers.com/" title="Open the live map on aion2timers.com"><img class="creditLogo" src="a2t-logo.webp" alt="Aion 2 Timers" /><span class="creditText"><span class="creditLive">Live map ↗</span><span class="creditBy">by Aion 2 Timers</span></span></a>
+        <a class="mapCredit" title="Map pictures: Aion 2 Timers"><img class="creditLogo" src="a2t-logo.webp" alt="Aion 2 Timers" /><span class="creditText"><span class="creditLive">Live map ↗</span><span class="creditBy">by Aion 2 Timers</span></span></a>
         <div class="mapPictures" hidden><!-- map pictures -->
       <img class="mapPic" data-map="20" src="maps/20.webp" alt="" loading="lazy" />
       <img class="mapPic" data-map="22" src="maps/22.webp" alt="" loading="lazy" />
diff --git a/plugins/pet-souls/plugin.js b/plugins/pet-souls/plugin.js
index 134eda5..cd2a1dd 100644
--- a/plugins/pet-souls/plugin.js
+++ b/plugins/pet-souls/plugin.js
@@ -1152,6 +1152,8 @@ const MAP_LANGUAGES = new Set(["de", "fr", "es", "it", "ja", "ko", "pl", "pt", "
 // English, as their map reads it. Spec: homelessguynabox/a2tools-integration,
 // reference/map-links.md.
 function mapLink(d, k) {
+  // Clicktrough: no links to websites (Aion 2 Timers' live map).
+  if (!MAP_LINKS) return "";
   if (!d.npcId) return null;
   const q = new URLSearchParams();
   if (d.mapId) q.set("map", String(d.mapId));
@@ -1171,6 +1173,9 @@ function mapLink(d, k) {
   return "https://www.aion2timers.com/map/?" + q.toString();
 }
 
+// Clicktrough: off; see mapLink.
+const MAP_LINKS = false;
+
 // A filter row (genus or level): All, then each choice with how many of
 // `pets` it holds, given the other filters.
 function renderChips(row, pref, pets, valueOf, choices) {
diff --git a/plugins/pet-souls/style.css b/plugins/pet-souls/style.css
index c0b69c9..ceef18e 100644
--- a/plugins/pet-souls/style.css
+++ b/plugins/pet-souls/style.css
@@ -1105,3 +1105,8 @@ body.farmOnly .nearby {
   border-radius: 0;
   background: none;
 }
+
+/* Clicktrough: the credit to Aion 2 Timers (their map pictures) is text, not
+   a link to their site. */
+.mapCredit { cursor: default; }
+.mapCredit .creditLive { display: none; }
diff --git a/plugins/pet-souls/widget.css b/plugins/pet-souls/widget.css
index b1f8c9e..61d5320 100644
--- a/plugins/pet-souls/widget.css
+++ b/plugins/pet-souls/widget.css
@@ -180,3 +180,8 @@ body.locked .bar {
   color: rgba(255, 255, 255, 0.5);
   pointer-events: none;
 }
+
+/* Clicktrough: the credit to Aion 2 Timers (their map pictures) is text, not
+   a link to their site. */
+.mapCredit { cursor: default; }
+.mapCredit .creditLive { display: none; }
diff --git a/plugins/pet-souls/widget.html b/plugins/pet-souls/widget.html
index e14c08e..7cead27 100644
--- a/plugins/pet-souls/widget.html
+++ b/plugins/pet-souls/widget.html
@@ -37,7 +37,7 @@
           <button type="button" class="follow" title="Back to you" aria-label="Back to you" hidden>⌖</button>
         </div>
         <p class="mapNote" hidden></p>
-        <a class="mapCredit" href="https://www.aion2timers.com/" title="Open the live map on aion2timers.com"><img class="creditLogo" src="a2t-logo.webp" alt="Aion 2 Timers" /><span class="creditText"><span class="creditLive">Live map ↗</span><span class="creditBy">by Aion 2 Timers</span></span></a>
+        <a class="mapCredit" title="Map pictures: Aion 2 Timers"><img class="creditLogo" src="a2t-logo.webp" alt="Aion 2 Timers" /><span class="creditText"><span class="creditLive">Live map ↗</span><span class="creditBy">by Aion 2 Timers</span></span></a>
       </div>
     </div>
     <script src="/_sdk/a2.js"></script>
