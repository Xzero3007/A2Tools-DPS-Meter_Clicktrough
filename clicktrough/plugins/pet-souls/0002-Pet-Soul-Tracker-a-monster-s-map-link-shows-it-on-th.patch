From 5bb98b0fcd245801e70aa4f1a59f1a88cf3cfdac Mon Sep 17 00:00:00 2001
From: A2Tools-patch <patch@localhost>
Date: Sat, 24 Oct 2026 17:21:13 +0000
Subject: [PATCH] Pet Soul Tracker: a monster's map link shows it on the Map
 plugin

With the Clicktrough meter (a2.share), the map link under a drop's
monster no longer opens the Aion 2 Timers website: it asks the Map plugin
to show that monster's spawn points (on its region's map), and the Map
comes forward. Meters without a2.share keep the website link.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RBQati3x8VviBbpY9juEWf
---
 plugins/pet-souls/README.md |  2 +-
 plugins/pet-souls/plugin.js | 24 ++++++++++++++++++++----
 2 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/plugins/pet-souls/README.md b/plugins/pet-souls/README.md
index e81ff73..b2b4aad 100644
--- a/plugins/pet-souls/README.md
+++ b/plugins/pet-souls/README.md
@@ -54,7 +54,7 @@ Every name in a pet's sources (monsters, zones, maps, Kibelisks, chests) shows i
 - `decoder:pet-list`, `decoder:soul-gained`, `decoder:level-up`: read your own pets' levels and soul gains.
 - `events:character`: keep a separate list per server.
 - `window`: show the window when you pick up a soul for a pet you are farming, fitted to that list, and hide it again (only with **Pop up while farming** on).
-- `share` (Clicktrough): hand the pinned pets and those you are farming to the Map plugin, which shows where their monsters are.
+- `share` (Clicktrough): hand the pinned pets and those you are farming to the Map plugin, which shows where their monsters are; there, a monster's map link shows its spawn points on the Map instead of opening the website.
 - `storage`: save the counts (with the last 200 changes per server, to trace a count that drifts from the game's), your pet names, the sort order, pins, region choice, filters, layout and the pets you are farming on this computer.
 
 ## Try it (developer mode)
diff --git a/plugins/pet-souls/plugin.js b/plugins/pet-souls/plugin.js
index 41c4984..d3446ac 100644
--- a/plugins/pet-souls/plugin.js
+++ b/plugins/pet-souls/plugin.js
@@ -299,19 +299,26 @@ function render() {
 }
 
 // Clicktrough: the pets pinned and those being farmed, for the Map plugin
-// (a2.share, permission "share"), each time they change.
+// (a2.share, permission "share"), each time they change; and a map link
+// clicked (`focus`), which the Map shows.
 let sharedKey = "";
+let sharedPets = [];
+let focusRequest = null;
+function showOnMap(what) {
+  focusRequest = { ...what, at: Date.now() };
+  a2.share({ source: "Pet Soul Tracker", pets: sharedPets, focus: focusRequest }).catch(() => {});
+}
 function shareWithMap(pinned) {
   if (typeof a2.share !== "function") return;
   const pets = pinned.map((id) => ({ id: Number(id), name: petName(id), mark: "pinned" }));
   for (const p of farmedPets()) {
     if (!pinned.includes(p.id) && p.level < MAX_LEVEL) pets.push({ id: Number(p.id), name: p.name, mark: "farming" });
   }
-  const value = { source: "Pet Soul Tracker", pets };
-  const k = JSON.stringify(value);
+  const k = JSON.stringify(pets);
   if (k === sharedKey) return;
   sharedKey = k;
-  a2.share(value).catch(() => {});
+  sharedPets = pets;
+  a2.share({ source: "Pet Soul Tracker", pets, focus: focusRequest }).catch(() => {});
 }
 
 // A pet's row in the chosen layout, its sources under it while open.
@@ -652,6 +659,15 @@ function whereOf(id) {
       link.append(icon, words.map);
       // Aion 2 Timers' map, which the address shows.
       link.title = href;
+      // Clicktrough: with the Map plugin's meter, the monster's spawn points
+      // on the Map instead of the website.
+      if (typeof a2.share === "function") {
+        link.title = "Show its spawn points on the Map";
+        link.addEventListener("click", (e) => {
+          e.preventDefault();
+          showOnMap({ npc: d.npcId, name: SOURCE_TEXT[d.npc]?.en || text(d.npc), region: regionOf(d) });
+        });
+      }
       at.append(" · ", link);
     }
     box.append(at);
