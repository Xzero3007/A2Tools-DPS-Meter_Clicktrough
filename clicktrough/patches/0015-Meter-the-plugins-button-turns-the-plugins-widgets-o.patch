+/// Clicktrough: the plugins turned off with the meter's plugins button
+/// (`dock::dock_toggle`): the dock hidden, and every plugin's widgets with
+/// it (a Map overlay stayed over the game). Kept across restarts, so widgets
+/// opened while it is set start hidden; the button or the dock shown again
+/// any other way brings them back.
+pub const PLUGINS_HIDDEN_KEY: &str = "ct.pluginsHidden";
+
+/// The widgets the plugins button hid, by label.
+fn held_by_button_set() -> &'static Mutex<std::collections::HashSet<String>> {
+    static HELD: std::sync::OnceLock<Mutex<std::collections::HashSet<String>>> = std::sync::OnceLock::new();
+    HELD.get_or_init(Mutex::default)
+}
+
+/// Whether the plugins button has the plugins off.
+pub fn plugins_hidden(app: &tauri::AppHandle) -> bool {
+    app.try_state::<AppState>().is_some_and(|s| s.settings.get(PLUGINS_HIDDEN_KEY).as_deref() == Some("true"))
+}
+
+/// Whether the plugins button hid widget `label` (nothing else may show it).
+pub fn held_by_button(label: &str) -> bool {
+    held_by_button_set().lock().unwrap_or_else(|p| p.into_inner()).contains(label)
+}
+
+/// Hide one widget for the plugins button.
+fn hold_by_button(window: &tauri::WebviewWindow) {
+    if window.is_visible().unwrap_or(false) && !crate::platform::window::is_hidden_in_place(window) {
+        crate::platform::window::hide_in_place(window);
+    }
+    held_by_button_set().lock().unwrap_or_else(|p| p.into_inner()).insert(window.label().to_string());
+}
+
+/// The plugins button: every plugin's widgets hidden (`off`), or the ones it
+/// hid shown again, but those their plugins closed meanwhile or the game
+/// keeps hidden.
+pub fn set_plugins_hidden(app: &tauri::AppHandle, off: bool) {
+    if let Some(state) = app.try_state::<AppState>() {
+        state.settings.set(PLUGINS_HIDDEN_KEY, if off { "true" } else { "false" });
+    }
+    if off {
+        for (label, window) in app.webview_windows() {
+            if parse_label(&label).is_some() && !is_closed(&label) {
+                hold_by_button(&window);
+            }
+        }
+        return;
+    }
+    let held: Vec<String> = held_by_button_set().lock().unwrap_or_else(|p| p.into_inner()).drain().collect();
+    for label in held {
+        let Some(window) = app.get_webview_window(&label) else { continue };
+        let Some((id, _)) = parse_label(&label) else { continue };
+        if is_closed(&label) {
+            continue;
+        }
+        if super::game_hides(app, &id) {
+            super::hold_for_game(&window);
+            continue;
+        }
+        if !crate::platform::window::reveal_in_place(&window) {
+            crate::platform::window::show_on_top_without_focus(&window);
+        }
+        relock(app, &window);
+    }
+}
+
 /// The parts of each widget that take the mouse, as its page reported them
 /// (`a2.widget.area`, `a2.widget.areas`): rectangles in CSS px, and the
 /// page's scale. Unlocked, clicks elsewhere in its window go through (by an
@@ -201,6 +265,9 @@ pub async fn plugin_widget_open(
         crate::platform::window::set_size(&widget, tauri::LogicalSize::new(width, height).into());
         if super::game_hides(&app, &id) {
             super::hold_for_game(&widget);
+        } else if plugins_hidden(&app) || held_by_button(widget.label()) {
+            // Clicktrough: the plugins are off (the meter's plugins button).
+            hold_by_button(&widget);
         } else if !crate::platform::window::reveal_in_place(&widget) {
             crate::platform::window::show_on_top_without_focus(&widget);
         }
@@ -275,6 +342,10 @@ pub async fn plugin_widget_open(
     if super::game_hides(&app, &id) {
         super::hold_for_game(&widget);
     }
+    // Clicktrough: the plugins are off (the meter's plugins button).
+    if plugins_hidden(&app) {
+        hold_by_button(&widget);
+    }
     Ok(())
