index 0000000..14e9daa
--- /dev/null
+++ b/src-tauri/src/plugins/jellyfin.rs
@@ -0,0 +1,692 @@
+//! Clicktrough: the player's own Jellyfin server in the Streams plugin
+//! (permission "video").
+//!
+//! The plugin lists what the server has (libraries, Continue watching, Next
+//! up, a search) and plays it in its overlay with the meter's mpv
+//! (`plugins::video`). The server is the player's own, **in the home
+//! network only**: its address must be a private one (10.x, 172.16-31.x,
+//! 192.168.x, 127.x, fc00::/7, fe80::/10) or a local name (localhost,
+//! `*.local`, `*.lan`, `*.home.arpa`, a name without a dot), and a name
+//! counts only when every address it has is such a private one. This
+//! module's client reaches nothing else (its own lookups refuse any other
+//! name or address, no proxy, no redirects), so nothing of it can go out to
+//! the internet, even by a typo.
+//!
+//! The address, the user and the server's key (from a sign-in with the
+//! user's name and password) are kept in `jellyfin.json` in the meter's own
+//! data folder, readable by the player alone; the password isn't kept, and
+//! the key never goes to the plugin's page. What the server is told: the
+//! sign-in, what plays and how far (so Continue watching and "watched" are
+//! right in every Jellyfin app), and an item marked watched or not.
+
+use std::time::Duration;
+
+use serde_json::{json, Value};
+
+use super::{require, window_plugin};
+
+/// Whether `ip` is in a home network: private, loopback or link-local.
+pub fn local_ip(ip: std::net::IpAddr) -> bool {
+    use std::net::IpAddr;
+    match ip {
+        IpAddr::V4(v) => v.is_private() || v.is_loopback() || v.is_link_local(),
+        IpAddr::V6(v) => {
+            let first = v.segments()[0];
+            v.is_loopback()
+                || (first & 0xfe00) == 0xfc00
+                || (first & 0xffc0) == 0xfe80
+                || v.to_ipv4_mapped().is_some_and(|m| local_ip(IpAddr::V4(m)))
+        }
+    }
+}
+
+/// Whether `host` is a home network's name: localhost, a name without a
+/// dot, or one ending in a local suffix. Its addresses are checked too.
+pub fn local_name(host: &str) -> bool {
+    let host = host.trim_end_matches('.').to_ascii_lowercase();
+    if host.is_empty() || host.len() > 253 || !host.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '.') {
+        return false;
+    }
+    if host.split('.').any(|l| l.is_empty() || l.starts_with('-') || l.ends_with('-')) {
+        return false;
+    }
+    host == "localhost"
+        || !host.contains('.')
+        || [".local", ".lan", ".home", ".home.arpa", ".internal", ".localdomain", ".localhost"]
+            .iter()
+            .any(|s| host.ends_with(s))
+}
+
+/// The host of a server address, as written in it.
+#[derive(Debug, PartialEq)]
+pub enum Host {
+    Ip(std::net::IpAddr),
+    Name(String),
+}
+
+/// A server address taken apart: http or https, a host in the home network,
+/// a port, and a base path (a reverse proxy's `/jellyfin`).
+#[derive(Debug, PartialEq)]
+pub struct Server {
+    pub https: bool,
+    pub host: Host,
+    pub port: Option<u16>,
+    pub path: String,
+}
+
+impl Server {
+    /// The address with `host` written in place of the one given.
+    fn with_host(&self, host: &str) -> String {
+        let port = self.port.map(|p| format!(":{p}")).unwrap_or_default();
+        format!("{}://{host}{port}{}", if self.https { "https" } else { "http" }, self.path)
+    }
+
+    fn host_text(&self) -> String {
+        match &self.host {
+            Host::Ip(std::net::IpAddr::V6(v)) => format!("[{v}]"),
+            Host::Ip(ip) => ip.to_string(),
+            Host::Name(n) => n.clone(),
+        }
+    }
+
+    /// The address, written the one way.
+    pub fn base(&self) -> String {
+        self.with_host(&self.host_text())
+    }
+}
+
+/// A server address the player typed (`192.168.1.20:8096`,
+/// `http://nas.local:8096`, `https://media.lan/jellyfin`), checked: only a
+/// home network's. Anything else is refused.
+pub fn parse_server(input: &str) -> Result<Server, String> {
+    const NOT_LOCAL: &str = "Only a Jellyfin server in your home network works here (192.168.x.x, 10.x.x.x, 172.16-31.x.x, localhost, or a name like nas.local).";
+    let text = input.trim();
+    if text.is_empty() || text.len() > 200 || text.chars().any(|c| c.is_whitespace() || c.is_control()) {
+        return Err("Type the server's address, like 192.168.1.20:8096.".into());
+    }
+    let (https, rest) = if let Some(r) = text.strip_prefix("http://") {
+        (false, r)
+    } else if let Some(r) = text.strip_prefix("https://") {
+        (true, r)
+    } else if text.contains("://") {
+        return Err("the address starts with http:// or https://".into());
+    } else {
+        (false, text)
+    };
+    let (authority, path) = match rest.find('/') {
+        Some(i) => (&rest[..i], &rest[i..]),
+        None => (rest, ""),
+    };
+    if authority.contains('@') || path.contains(['?', '#', '%', '\\']) || path.contains("..") {
+        return Err("just the server's address, no user, query or extras".into());
+    }
+    let path = path.trim_end_matches('/');
+    if !path.chars().all(|c| c.is_ascii_alphanumeric() || matches!(c, '/' | '-' | '_' | '.')) || path.len() > 64 {
+        return Err("the address's path has characters it can't have".into());
+    }
+    // [v6]:port, v4:port, name:port
+    let (host, port) = if let Some(r) = authority.strip_prefix('[') {
+        let end = r.find(']').ok_or("an IPv6 address goes in [ ]")?;
+        let port = r[end + 1..].strip_prefix(':');
+        if !r[end + 1..].is_empty() && port.is_none() {
+            return Err("not an address".into());
+        }
+        (&r[..end], port)
+    } else {
+        match authority.rsplit_once(':') {
+            Some((h, p)) => (h, Some(p)),
+            None => (authority, None),
+        }
+    };
+    let port = match port {
+        Some(p) => Some(p.parse::<u16>().ok().filter(|p| *p > 0).ok_or("the port is a number from 1 to 65535")?),
+        None => None,
+    };
+    let host = match host.parse::<std::net::IpAddr>() {
+        Ok(ip) if local_ip(ip) => Host::Ip(ip),
+        Ok(_) => return Err(NOT_LOCAL.into()),
+        Err(_) if local_name(host) => Host::Name(host.trim_end_matches('.').to_ascii_lowercase()),
+        Err(_) => return Err(NOT_LOCAL.into()),
+    };
+    Ok(Server { https, host, port, path: path.to_string() })
+}
+
+/// A Jellyfin item id: 32 hex digits, or 36 with dashes.
+pub fn item_ok(id: &str) -> bool {
+    matches!(id.len(), 32 | 36) && id.chars().all(|c| c.is_ascii_hexdigit() || c == '-')
+}
+
+/// The paths a plugin may read (GET), `{user}` standing for the signed-in
+/// user's id: the user's libraries and items, shows' seasons, episodes and
+/// Next up, an item's intro and credits (Media Segments, and the Intro
+/// Skipper plugin's own), and the user's settings.
+pub fn get_path_ok(path: &str) -> bool {
+    const PREFIXES: &[&str] = &[
+        "/Users/{user}/Items", "/Users/{user}/Views", "/UserViews", "/UserItems/", "/Items", "/Shows/",
+        "/MediaSegments/", "/Episode/", "/Genres",
+    ];
+    path.len() <= 200
+        && !path.contains("..")
+        && path.chars().all(|c| c.is_ascii_alphanumeric() || matches!(c, '/' | '-' | '_' | '{' | '}'))
+        && (path == "/Users/{user}" || PREFIXES.iter().any(|p| path.starts_with(p)))
+        && !path.contains("/Images/")
+        && !path.contains("/Download")
+}
+
+/// Percent-encoding for a query's names and values.
+fn encode(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for b in s.bytes() {
+        if b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.' | b'~') {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
+
+/// A query from the plugin's `{ name: value }`: names of letters, values
+/// strings, numbers or yes/no, at most 30.
+pub fn query_of(query: &Value) -> Result<String, String> {
+    let Some(map) = query.as_object() else {
+        return if query.is_null() { Ok(String::new()) } else { Err("the query is { name: value }".into()) };
+    };
+    if map.len() > 30 {
+        return Err("too many query values".into());
+    }
+    let mut parts = Vec::new();
+    for (k, v) in map {
+        if k.is_empty() || k.len() > 40 || !k.chars().all(|c| c.is_ascii_alphanumeric()) {
+            return Err(format!("not a query name: {k}"));
+        }
+        let v = match v {
+            Value::String(s) if s.len() <= 300 => s.clone(),
+            Value::Number(n) => n.to_string(),
+            Value::Bool(b) => b.to_string(),
+            Value::Null => continue,
+            _ => return Err(format!("not a query value for {k}")),
+        };
+        parts.push(format!("{}={}", encode(k), encode(&v)));
+    }
+    Ok(parts.join("&"))
+}
+
+/// What the meter keeps of the sign-in.
+#[derive(Clone, serde::Serialize, serde::Deserialize, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct Account {
+    pub server: String,
+    pub server_name: String,
+    pub user: String,
+    pub user_id: String,
+    pub token: String,
+    pub device_id: String,
+}
+
+impl Account {
+    /// What the plugin sees: no key.
+    fn public(&self) -> Value {
+        json!({ "server": self.server, "serverName": self.server_name, "user": self.user, "userId": self.user_id })
+    }
+
+    /// The header Jellyfin reads who asks from.
+    pub fn authorization(&self) -> String {
+        let mut h = format!(
+            "MediaBrowser Client=\"A2Tools Streams\", Device=\"A2Tools DPS Meter\", DeviceId=\"{}\", Version=\"{}\"",
+            self.device_id,
+            env!("CARGO_PKG_VERSION")
+        );
+        if !self.token.is_empty() {
+            h.push_str(&format!(", Token=\"{}\"", self.token));
+        }
+        h
+    }
+}
+
+/// How a video is fetched: the server's file as it is ("original"), sound
+/// only, or the server's conversion down to a height (HLS).
+pub fn stream_path(item: &str, source: &str, session: &str, quality: &str, audio_index: Option<u32>) -> String {
+    let src = if source.is_empty() { item } else { source };
+    let bitrate = match quality {
+        "1080" => Some((1080, 10_000_000)),
+        "720" => Some((720, 4_000_000)),
+        "480" => Some((480, 2_000_000)),
+        "360" => Some((360, 1_000_000)),
+        _ => None,
+    };
+    match bitrate {
+        Some((h, br)) => {
+            let mut p = format!(
+                "/Videos/{item}/master.m3u8?MediaSourceId={src}&VideoCodec=h264&AudioCodec=aac,mp3&MaxHeight={h}\
+                 &VideoBitrate={br}&AudioBitrate=192000&TranscodingMaxAudioChannels=2&SegmentContainer=ts\
+                 &BreakOnNonKeyFrames=true"
+            );
+            if !session.is_empty() {
+                p.push_str(&format!("&PlaySessionId={session}"));
+            }
+            if let Some(a) = audio_index {
+                p.push_str(&format!("&AudioStreamIndex={a}"));
+            }
+            p
+        }
+        None => format!("/Videos/{item}/stream?static=true&mediaSourceId={src}"),
+    }
+}
+
+fn file(app: &tauri::AppHandle) -> Result<std::path::PathBuf, String> {
+    use tauri::Manager;
+    let state = app.try_state::<crate::app::AppState>().ok_or("no app state")?;
+    Ok(state.app_data_dir.join("jellyfin.json"))
+}
+
+fn load(app: &tauri::AppHandle) -> Option<Account> {
+    let text = std::fs::read_to_string(file(app).ok()?).ok()?;
+    let a: Account = serde_json::from_str(&text).ok()?;
+    // Read again, checked again: an address that isn't local is never used.
+    (parse_server(&a.server).is_ok() && !a.token.is_empty()).then_some(a)
+}
+
+fn store(app: &tauri::AppHandle, account: &Account) -> Result<(), String> {
+    let path = file(app)?;
+    let text = serde_json::to_string_pretty(account).map_err(|e| e.to_string())?;
+    let tmp = path.with_extension("json.tmp");
+    {
+        use std::io::Write;
+        let mut opts = std::fs::OpenOptions::new();
+        opts.write(true).create(true).truncate(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            opts.mode(0o600);
+        }
+        let mut f = opts.open(&tmp).map_err(|e| e.to_string())?;
+        f.write_all(text.as_bytes()).map_err(|e| e.to_string())?;
+    }
+    std::fs::rename(&tmp, &path).map_err(|e| e.to_string())
+}
+
+fn device_id() -> String {
+    use sha2::{Digest, Sha256};
+    let mut h = Sha256::new();
+    h.update(format!("{:?}{}", std::time::SystemTime::now(), std::process::id()).as_bytes());
+    if let Ok(name) = std::fs::read_to_string("/etc/machine-id") {
+        h.update(name.as_bytes());
+    }
+    h.finalize().iter().take(16).map(|b| format!("{b:02x}")).collect()
+}
+
+/// The address mpv gets for the signed-in server, with the header it sends
+/// along (the key goes in the header, never in the address). A local name is
+/// looked up here and only a home network's address handed on, for plain
+/// http (https keeps its name, which its certificate needs; its addresses
+/// are checked all the same).
+pub async fn mpv_source(app: &tauri::AppHandle, path: &str) -> Result<(String, String), String> {
+    let account = load(app).ok_or("sign in to your Jellyfin server first")?;
+    let server = parse_server(&account.server)?;
+    let base = match &server.host {
+        Host::Ip(_) => server.base(),
+        Host::Name(name) => {
+            let ip = net::local_addresses(name, server.port.unwrap_or(if server.https { 443 } else { 80 })).await?
+                .into_iter().next().ok_or("the server's name has no home network address")?;
+            if server.https {
+                server.base()
+            } else {
+                server.with_host(&match ip {
+                    std::net::IpAddr::V6(v) => format!("[{v}]"),
+                    v4 => v4.to_string(),
+                })
+            }
+        }
+    };
+    Ok((format!("{base}{path}"), format!("Authorization: {}", account.authorization())))
+}
+
+/// `a2.video.jellyfin(action, arg)`: the plugin's calls for the server.
+///
+/// - `status`: who is signed in, where (`{ server, serverName, user }`), or null
+/// - `login` `{ server, user, password }`: sign in (the key is kept here)
+/// - `logout`: sign out, the key forgotten
+/// - `get` `{ path, query }`: one of the readable paths (`get_path_ok`)
+/// - `playbackInfo` `{ item }`: an item's files and tracks
+/// - `report` `{ kind: start | progress | stopped, item, source, session, position, paused, muted, method }`
+/// - `played` `{ item, on }`: mark it watched or not
+/// - `image` `{ item, type, height }`: an item's picture, as a data: URL
+#[tauri::command]
+pub async fn plugin_video_jellyfin(
+    app: tauri::AppHandle,
+    window: tauri::WebviewWindow,
+    plugin: Option<String>,
+    action: String,
+    arg: Option<Value>,
+) -> Result<Value, String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, "video")?;
+    let arg = arg.unwrap_or(Value::Null);
+    let s = |k: &str| arg.get(k).and_then(Value::as_str).unwrap_or("").to_string();
+    match action.as_str() {
+        "status" => Ok(load(&app).map(|a| a.public()).unwrap_or(Value::Null)),
+        "login" => {
+            let server = parse_server(&s("server"))?;
+            let user = s("user");
+            if user.trim().is_empty() || user.len() > 100 {
+                return Err("type your Jellyfin user name".into());
+            }
+            let password = s("password");
+            if password.len() > 200 {
+                return Err("the password is too long".into());
+            }
+            let mut account = Account {
+                server: server.base(),
+                device_id: load(&app).map(|a| a.device_id).filter(|d| !d.is_empty()).unwrap_or_else(device_id),
+                ..Default::default()
+            };
+            let info = net::request(&account, "GET", "/System/Info/Public", None).await
+                .map_err(|e| format!("no Jellyfin server answered at {}: {e}", account.server))?;
+            if info.get("Id").and_then(Value::as_str).is_none() {
+                return Err("that is not a Jellyfin server".into());
+            }
+            account.server_name = info.get("ServerName").and_then(Value::as_str).unwrap_or("Jellyfin").chars().take(80).collect();
+            let auth = net::request(&account, "POST", "/Users/AuthenticateByName", Some(json!({ "Username": user.trim(), "Pw": password }))).await
+                .map_err(|e| if e.contains("401") { "wrong user name or password".to_string() } else { e })?;
+            account.token = auth.get("AccessToken").and_then(Value::as_str).filter(|t| t.len() <= 200 && t.chars().all(|c| c.is_ascii_alphanumeric())).ok_or("the server gave no key")?.to_string();
+            account.user_id = auth.pointer("/User/Id").and_then(Value::as_str).filter(|u| item_ok(u)).ok_or("the server gave no user")?.to_string();
+            account.user = auth.pointer("/User/Name").and_then(Value::as_str).unwrap_or(user.trim()).chars().take(100).collect();
+            store(&app, &account)?;
+            tracing::info!("Jellyfin: signed in");
+            Ok(account.public())
+        }
+        "logout" => {
+            if let Some(a) = load(&app) {
+                let _ = net::request(&a, "POST", "/Sessions/Logout", None).await;
+            }
+            let _ = std::fs::remove_file(file(&app)?);
+            Ok(Value::Null)
+        }
+        _ => {
+            let account = load(&app).ok_or("sign in to your Jellyfin server first")?;
+            let user = account.user_id.clone();
+            match action.as_str() {
+                "get" => {
+                    let path = s("path");
+                    if !get_path_ok(&path) {
+                        return Err("the plugin can't read that".into());
+                    }
+                    let query = query_of(arg.get("query").unwrap_or(&Value::Null))?;
+                    let path = path.replace("{user}", &user);
+                    let full = if query.is_empty() { path } else { format!("{path}?{query}") };
+                    net::request(&account, "GET", &full, None).await
+                }
+                "playbackInfo" => {
+                    let item = s("item");
+                    if !item_ok(&item) {
+                        return Err("not an item".into());
+                    }
+                    net::request(&account, "POST", &format!("/Items/{item}/PlaybackInfo?UserId={user}"), Some(json!({}))).await
+                }
+                "report" => {
+                    let (item, source, session) = (s("item"), s("source"), s("session"));
+                    if !item_ok(&item) || (!source.is_empty() && !source.chars().all(|c| c.is_ascii_alphanumeric() || c == '-'))
+                        || session.len() > 64 || !session.chars().all(|c| c.is_ascii_alphanumeric() || c == '-')
+                    {
+                        return Err("not an item".into());
+                    }
+                    let path = match s("kind").as_str() {
+                        "start" => "/Sessions/Playing",
+                        "progress" => "/Sessions/Playing/Progress",
+                        "stopped" => "/Sessions/Playing/Stopped",
+                        _ => return Err("report start, progress or stopped".into()),
+                    };
+                    let seconds = arg.get("position").and_then(Value::as_f64).filter(|v| v.is_finite() && *v >= 0.0).unwrap_or(0.0);
+                    let method = if s("method") == "Transcode" { "Transcode" } else { "DirectPlay" };
+                    let mut body = json!({
+                        "ItemId": item,
+                        "MediaSourceId": if source.is_empty() { item.clone() } else { source },
+                        "PositionTicks": (seconds * 10_000_000.0) as u64,
+                        "IsPaused": arg.get("paused").and_then(Value::as_bool).unwrap_or(false),
+                        "IsMuted": arg.get("muted").and_then(Value::as_bool).unwrap_or(false),
+                        "PlayMethod": method,
+                        "CanSeek": true,
+                    });
+                    if !session.is_empty() {
+                        body["PlaySessionId"] = json!(session);
+                    }
+                    net::request(&account, "POST", path, Some(body)).await.map(|_| Value::Null)
+                }
+                "played" => {
+                    let item = s("item");
+                    if !item_ok(&item) {
+                        return Err("not an item".into());
+                    }
+                    let on = arg.get("on").and_then(Value::as_bool).unwrap_or(true);
+                    net::request(&account, if on { "POST" } else { "DELETE" }, &format!("/Users/{user}/PlayedItems/{item}"), None).await
+                }
+                "image" => {
+                    let item = s("item");
+                    let kind = s("type");
+                    if !item_ok(&item) || !["Primary", "Thumb", "Backdrop"].contains(&kind.as_str()) {
+                        return Err("not a picture".into());
+                    }
+                    let height = arg.get("height").and_then(Value::as_u64).unwrap_or(300).clamp(40, 720);
+                    net::image(&account, &format!("/Items/{item}/Images/{kind}?fillHeight={height}&quality=85")).await.map(Value::String)
+                }
+                _ => Err("unknown Jellyfin call".into()),
+            }
+        }
+    }
+}
+
+/// The client, for the home network only.
+#[cfg(feature = "net")]
+mod net {
+    use super::*;
+    use std::collections::HashMap;
+    use std::net::{IpAddr, SocketAddr};
+    use std::sync::{Arc, Mutex, OnceLock};
+
+    /// A local name's addresses, the home network's only (none: refused).
+    pub async fn local_addresses(name: &str, port: u16) -> Result<Vec<IpAddr>, String> {
+        if !local_name(name) {
+            return Err(format!("{name}: not a name in your home network"));
+        }
+        let all: Vec<IpAddr> = tokio::net::lookup_host((name, port)).await
+            .map_err(|e| format!("{name}: {e}"))?
+            .map(|a| a.ip())
+            .collect();
+        if all.is_empty() || !all.iter().all(|ip| local_ip(*ip)) {
+            tracing::warn!("Jellyfin: refused {name} (not only home network addresses)");
+            return Err(format!("{name} isn't only in your home network"));
+        }
+        Ok(all)
+    }
+
+    /// Lookups for local names only, answered with home network addresses only.
+    struct LocalOnly;
+    impl reqwest::dns::Resolve for LocalOnly {
+        fn resolve(&self, name: reqwest::dns::Name) -> reqwest::dns::Resolving {
+            let host = name.as_str().to_string();
+            Box::pin(async move {
+                let ips = local_addresses(&host, 0).await?;
+                Ok(Box::new(ips.into_iter().map(|ip| SocketAddr::new(ip, 0))) as reqwest::dns::Addrs)
+            })
+        }
+    }
+
+    pub fn client() -> &'static reqwest::Client {
+        static C: OnceLock<reqwest::Client> = OnceLock::new();
+        C.get_or_init(|| {
+            reqwest::Client::builder()
+                .user_agent(concat!("A2Tools-DPS-Meter/", env!("CARGO_PKG_VERSION"), " Clicktrough"))
+                .connect_timeout(Duration::from_secs(5))
+                .timeout(Duration::from_secs(30))
+                .dns_resolver(Arc::new(LocalOnly))
+                .no_proxy()
+                .redirect(reqwest::redirect::Policy::none())
+                .build()
+                .unwrap_or_else(|e| {
+                    tracing::error!("Jellyfin: the client could not be built ({e})");
+                    reqwest::Client::builder().dns_resolver(Arc::new(LocalOnly)).no_proxy()
+                        .redirect(reqwest::redirect::Policy::none()).build().expect("a client")
+                })
+        })
+    }
+
+    /// The full address of `path` on the account's server, checked again.
+    fn url(account: &Account, path: &str) -> Result<String, String> {
+        let server = parse_server(&account.server)?;
+        if let Host::Ip(ip) = server.host {
+            if !local_ip(ip) {
+                return Err("not a home network address".into());
+            }
+        }
+        Ok(format!("{}{path}", server.base()))
+    }
+
+    pub async fn request(account: &Account, method: &str, path: &str, body: Option<Value>) -> Result<Value, String> {
+        let url = url(account, path)?;
+        let m = reqwest::Method::from_bytes(method.as_bytes()).map_err(|e| e.to_string())?;
+        let mut req = client().request(m, &url)
+            .header("Authorization", account.authorization())
+            .header("Accept", "application/json");
+        if let Some(b) = body {
+            req = req.header("Content-Type", "application/json").body(b.to_string());
+        }
+        let res = req.send().await.map_err(|e| super::super::web_error(&e))?;
+        let status = res.status();
+        if !status.is_success() {
+            return Err(format!("the server answered {status}"));
+        }
+        let bytes = res.bytes().await.map_err(|e| e.to_string())?;
+        if bytes.len() > 8 * 1024 * 1024 {
+            return Err("the answer is too large".into());
+        }
+        if bytes.is_empty() {
+            return Ok(Value::Null);
+        }
+        serde_json::from_slice(&bytes).or(Ok(Value::Null))
+    }
+
+    pub async fn image(account: &Account, path: &str) -> Result<String, String> {
+        static CACHE: OnceLock<Mutex<HashMap<String, String>>> = OnceLock::new();
+        let cache = CACHE.get_or_init(Mutex::default);
+        let key = format!("{}{path}", account.server);
+        if let Some(hit) = cache.lock().unwrap_or_else(|p| p.into_inner()).get(&key) {
+            return Ok(hit.clone());
+        }
+        let res = client().get(url(account, path)?)
+            .header("Authorization", account.authorization())
+            .header("Accept", "image/webp,image/jpeg,image/png")
+            .send().await.map_err(|e| super::super::web_error(&e))?;
+        if !res.status().is_success() {
+            return Err("no such picture".into());
+        }
+        let kind = res.headers().get(reqwest::header::CONTENT_TYPE).and_then(|v| v.to_str().ok())
+            .and_then(super::super::picture_kind).ok_or("not a picture")?;
+        let bytes = res.bytes().await.map_err(|e| e.to_string())?;
+        if bytes.len() > 3 * 1024 * 1024 {
+            return Err("the picture is too large".into());
+        }
+        let data = format!("data:{kind};base64,{}", super::super::base64(&bytes));
+        let mut c = cache.lock().unwrap_or_else(|p| p.into_inner());
+        if c.len() >= 600 {
+            c.clear();
+        }
+        c.insert(key, data.clone());
+        Ok(data)
+    }
+}
+
+#[cfg(not(feature = "net"))]
+mod net {
+    use super::*;
+    pub async fn local_addresses(_: &str, _: u16) -> Result<Vec<std::net::IpAddr>, String> {
+        Err("this meter is built without network features".into())
+    }
+    pub async fn request(_: &Account, _: &str, _: &str, _: Option<Value>) -> Result<Value, String> {
+        Err("this meter is built without network features".into())
+    }
+    pub async fn image(_: &Account, _: &str) -> Result<String, String> {
+        Err("this meter is built without network features".into())
+    }
+}
