-/// The removed ones as Settings lists them (each with its manifest's words).
-fn removed_bundled_info(app: &tauri::AppHandle) -> Vec<PluginInfo> {
-    bundled_removed(app)
-        .iter()
+/// This build's plugins that don't run, as Available lists them (each with
+/// its manifest's words): removed ones, and the original's not installed.
+fn offered_bundled(app: &tauri::AppHandle, host: &PluginHost) -> Vec<PluginInfo> {
+    let running: Vec<String> = host.list().into_iter().map(|p| p.id).collect();
+    let Some(root) = app.try_state::<AppState>().and_then(|s| s.i18n_data_dir.as_ref().map(|d| d.join("ct-plugins"))) else {
+        return Vec::new();
+    };
+    let mut ids: Vec<String> = std::fs::read_dir(root)
+        .into_iter()
+        .flatten()
+        .flatten()
+        .filter(|e| e.path().is_dir())
+        .map(|e| e.file_name().to_string_lossy().into_owned())
+        .filter(|id| !id.starts_with('.') && !running.contains(id))
+        .collect();
+    ids.sort();
+    ids.iter()
         .filter_map(|id| load_folder(&bundled_dir(app, id)?).ok())
         .map(|l| PluginInfo { reviewed: true, bundled: true, ..info(&l) })
         .collect()
@@ -774,6 +811,7 @@ impl PluginHost {
             .unwrap_or_default();
         let installed_root = plugins_dir(app).ok();
         let removed = bundled_removed(app);
+        let added = bundled_added(app);
         let bundled = bundled_root
             .and_then(|dir| std::fs::read_dir(dir).ok())
             .into_iter()
@@ -784,7 +822,10 @@ impl PluginHost {
         for dir in bundled {
             let name = dir.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
             let only_installed = installed_only.iter().any(|id| id == &name);
-            if only_installed && !installed_root.as_ref().is_some_and(|root| root.join(&name).is_dir()) {
+            if only_installed
+                && !added.iter().any(|id| id == &name)
+                && !installed_root.as_ref().is_some_and(|root| root.join(&name).is_dir())
+            {
                 continue;
             }
             // Removed in Settings: not until added again.
@@ -1644,8 +1685,12 @@ pub fn plugin_uninstall(app: tauri::AppHandle, id: String) -> Result<PluginsView
     }
     // Clicktrough: this build's own copy stays away too, until added again
     // (one that runs only where installed is gone with the installed copy).
-    if bundled_dir(&app, &id).is_some() && !installed_only(&app).contains(&id) {
-        set_bundled_removed(&app, &id, true);
+    if bundled_dir(&app, &id).is_some() {
+        if installed_only(&app).contains(&id) {
+            set_bundled_added(&app, &id, false);
+        } else {
+            set_bundled_removed(&app, &id, true);
+        }
     }
     let host = host(&app)?;
     host.reload(&app);
