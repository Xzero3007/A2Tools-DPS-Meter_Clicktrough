-        tag.title = "Comes with this build of the meter: added again, it runs as before, with its saved data.";
+        tag.title = "Comes with this build of the meter (the Clicktrough fork): installs without a download, its updates come with the meter's, and saved data from before stays.";
         catalogList.append(
           pluginRow({
             id: p.id,
