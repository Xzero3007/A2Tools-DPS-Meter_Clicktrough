+/// The page's `media-src`: the stream servers above for a plugin with the
+/// permission "radio", else none.
+fn media_policy(radio: bool) -> String {
+    if !radio {
+        return "media-src 'none'".into();
+    }
+    let mut sources = String::from("media-src");
+    for host in RADIO_HOSTS {
+        sources.push_str(&format!(" https://{host} http://{host}"));
+    }
+    sources
+}
+
+/// Whether the plugin `id` may play the radio stations' streams.
+fn plays_radio(app: &tauri::AppHandle, id: &str) -> bool {
+    host(app)
+        .ok()
+        .and_then(|h| h.with(id, |l| l.manifest.permissions.iter().any(|p| p == "radio")))
+        .unwrap_or(false)
+}
