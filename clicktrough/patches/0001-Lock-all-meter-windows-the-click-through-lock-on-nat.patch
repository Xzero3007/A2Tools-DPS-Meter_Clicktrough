+}
+
+type Keep = Option<(f64, f64, f64, f64, f64)>;
+
+/// What each window was last told by `click_through_except`, by label.
+fn wanted_regions() -> &'static std::sync::Mutex<std::collections::HashMap<String, (bool, Keep)>> {
+    static WANTED: std::sync::OnceLock<std::sync::Mutex<std::collections::HashMap<String, (bool, Keep)>>> =
+        std::sync::OnceLock::new();
+    WANTED.get_or_init(Default::default)
+}
+
+fn apply_input_region(gtk_window: &gtk::ApplicationWindow, ignore: bool, keep: Keep) {
