+
+/// "Lock all meter windows": while the overlay is locked, Details, Battle
+/// History, plugins' windows and plugins' icons let clicks through too, and
+/// the lock's hotkey (or the overlay's lock button) gives them the mouse back.
+/// Settings never locks: it is where the lock is turned off.
+pub const LOCK_ALL_WINDOWS_KEY: &str = "dpsMeter.lockAllWindows";
+
+/// The overlay is locked and "Lock all meter windows" is on.
+static ALL_WINDOWS_LOCKED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn all_windows_locked() -> bool {
+    ALL_WINDOWS_LOCKED.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// Whether a meter window other than the overlay ignores the mouse, or None
+/// for a window this does not manage (the overlay, plugins' icons).
+fn other_window_ignores(label: &str, screenshot: bool, all_locked: bool) -> Option<bool> {
+    if label == "settings" {
+        return Some(screenshot);
+    }
+    let tool = TOOL_WINDOWS.contains(&label) || label.starts_with("details-") || crate::plugins::is_plugin_window(label);
+    tool.then_some(screenshot || all_locked)
+}
+
+/// Every window besides the overlay as the screenshot tool and the lock say:
+/// all or nothing for the tool windows, by their lock and area for plugins'
+/// icons. Called when either changes, and when a tool window opens.
+pub fn sync_other_windows(app: &tauri::AppHandle) {
+    use std::sync::atomic::Ordering;
+    let locked = app.try_state::<AppState>().is_some_and(|s| {
+        s.overlay_lock.locked.load(Ordering::SeqCst)
+            && s.settings.get(LOCK_ALL_WINDOWS_KEY).as_deref() == Some("true")
+    });
+    ALL_WINDOWS_LOCKED.store(locked, Ordering::Relaxed);
+    let screenshot = screenshot_tool_in_front();
     for (label, window) in app.webview_windows() {
-        let tool = TOOL_WINDOWS.contains(&label.as_str()) || label.starts_with("details-") || crate::plugins::is_plugin_window(&label);
-        if tool && !platform::window::click_through_except(&window, in_front, None) && !cfg!(target_os = "linux") {
-            let _ = window.set_ignore_cursor_events(in_front);
+        let Some(ignore) = other_window_ignores(&label, screenshot, locked) else { continue };
+        if !platform::window::click_through_except(&window, ignore, None) && !cfg!(target_os = "linux") {
+            let _ = window.set_ignore_cursor_events(ignore);
         }
     }
+    crate::plugins::widgets::reapply_locks(app);
+}
+
+/// Whether the click-through lock can work here. On Linux it is an input
+/// region (`platform::window::click_through_except`), which needs no pointer
+/// position and so works on native Wayland too; elsewhere the pointer watch
+/// needs the pointer's position outside the window (see `OverlayLock`).
+fn lock_supported() -> bool {
+    cfg!(target_os = "linux") || platform::window::cursor_position().is_some()
 }
 
