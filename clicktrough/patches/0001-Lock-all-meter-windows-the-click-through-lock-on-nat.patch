-        if !ignore {
-            gtk_window.input_shape_combine_region(None);
-            return Some(());
-        }
-        let surface = gtk_window.window()?;
+        let label = window.label().to_string();
+        wanted_regions().lock().unwrap_or_else(|p| p.into_inner()).insert(label.clone(), (ignore, keep));
+        // Hidden in place it ignores the mouse whatever it is told (an
+        // invisible window must not take the game's clicks); revealed, it
+        // gets what it was told meanwhile (`reveal_in_place`).
+        let hidden = hidden_in_place().lock().unwrap_or_else(|p| p.into_inner()).contains(&label);
+        let (ignore, keep) = if hidden { (true, None) } else { (ignore, keep) };
+        apply_input_region(&gtk_window, ignore, keep);
