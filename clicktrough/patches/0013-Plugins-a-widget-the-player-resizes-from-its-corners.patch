+/// The smallest a player can make a widget by dragging its edge.
+const MIN_RESIZE: f64 = 120.0;
+
+/// The widgets being resized right now, by label.
+fn resizing() -> &'static Mutex<std::collections::HashSet<String>> {
+    static RESIZING: std::sync::OnceLock<Mutex<std::collections::HashSet<String>>> = std::sync::OnceLock::new();
+    RESIZING.get_or_init(Default::default)
+}
+
+/// The window edge a widget is resized from ("n", "s", "e", "w", "ne", "nw",
+/// "se" or "sw"), as the window API names it (startResizeDragging).
+fn resize_direction(edge: &str) -> Option<&'static str> {
+    Some(match edge {
+        "n" => "North",
+        "s" => "South",
+        "e" => "East",
+        "w" => "West",
+        "ne" => "NorthEast",
+        "nw" => "NorthWest",
+        "se" => "SouthEast",
+        "sw" => "SouthWest",
+        _ => return None,
+    })
+}
+
+/// Clicktrough: a widget about to be resized by the window manager from one of
+/// its edges while the button stays down (a2.widget.resize, on mousedown),
+/// the way the meter's own windows are resized (begin_window_resize,
+/// begin_tool_resize): its size is unpinned and the direction to drag in is
+/// the answer (the host page starts the drag, startResizeDragging). Its size
+/// is pinned again once the button is up, and the widget hears it as a
+/// "resized" event ({ width, height }, CSS px). A page that grows its own
+/// window as the pointer moves fights the window manager (KWin moved such a
+/// window about, 2026-10-17; a player called the Map overlay's corner
+/// "buggy", 2026-10-24). None when it can't be done now: the widgets are
+/// locked, the button is already up, a resize is under way, or the widget's
+/// window can't be resized (Windows: its border is the window manager's).
+#[tauri::command]
+pub async fn plugin_widget_resize(app: tauri::AppHandle, window: tauri::WebviewWindow, edge: String) -> Result<Option<&'static str>, String> {
+    let (id, _) = widget_of(&window)?;
+    let direction = resize_direction(&edge).ok_or("an edge is n, s, e, w, ne, nw, se or sw")?;
+    if is_locked(&app, &id) || !cfg!(target_os = "linux") {
+        return Ok(None);
+    }
+    if !resizing().lock().unwrap_or_else(|p| p.into_inner()).insert(window.label().to_string()) {
+        return Ok(None);
+    }
+    let done = |window: &tauri::WebviewWindow| {
+        resizing().lock().unwrap_or_else(|p| p.into_inner()).remove(window.label());
+    };
+    let min = tauri::LogicalSize::new(MIN_RESIZE, MIN_RESIZE);
+    let compositor = crate::platform::window::compositor_resize_supported(&window);
+    if compositor {
+        if let Err(e) = crate::platform::window::prepare_resize(&window, min).await {
+            pin_size(&window);
+            done(&window);
+            return Err(e);
+        }
+        // Released while the hints went out: no resize.
+        if crate::platform::window::resize_pointer_down(&window) != Some(true) {
+            pin_size(&window);
+            done(&window);
+            return Ok(None);
+        }
+    } else {
+        crate::platform::window::release_size(&window, min);
+    }
+    // The drag starts from the page now; should it not, the button is up or
+    // the size stays put, and the watch below pins it again.
+    std::thread::spawn(move || {
+        std::thread::sleep(Duration::from_millis(150));
+        let mut last = window.inner_size().ok();
+        let mut still = 0;
+        // At most a minute; then its size is pinned as it stands.
+        for _ in 0..1200 {
+            std::thread::sleep(Duration::from_millis(50));
+            // Through the compositor GTK hides the button while the resize
+            // goes on: it is up once GTK sees it up over the widget again.
+            // Elsewhere the X server tells, or the size has stopped changing.
+            let down = if compositor {
+                crate::platform::window::resize_pointer_down(&window)
+            } else {
+                crate::platform::window::primary_button_down()
+            };
+            match down {
+                Some(true) => still = 0,
+                Some(false) => break,
+                None if compositor => {}
+                None => {
+                    let now = window.inner_size().ok();
+                    still = if now == last { still + 1 } else { 0 };
+                    last = now;
+                    if still >= 10 {
+                        break;
+                    }
+                }
+            }
+        }
+        let size = pin_size(&window);
+        done(&window);
+        if let Some((width, height)) = size {
+            let event = serde_json::json!({ "plugin": id, "event": "resized", "data": { "width": width, "height": height } });
+            let _ = window.emit("plugin-event", event);
+        }
+    });
+    Ok(Some(direction))
+}
+
+/// Pin a widget's size where it stands; its logical size.
+fn pin_size(window: &tauri::WebviewWindow) -> Option<(f64, f64)> {
+    let size = window.inner_size().ok()?;
+    crate::platform::window::set_size(window, tauri::Size::Physical(size));
+    let logical = size.to_logical::<f64>(window.scale_factor().unwrap_or(1.0));
+    Some((logical.width.round(), logical.height.round()))
+}
