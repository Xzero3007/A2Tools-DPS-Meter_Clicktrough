+    /// Clicktrough: a login's Kinah that comes after the self record (the
+    /// list, then the record, then `a5 ff`) is theirs at once; it waited for
+    /// the next self record, minutes later.
+    #[test]
+    fn a_logins_kinah_after_the_self_record_is_theirs() {
+        let (storage, mut p) = processor();
+        let now = 1_792_929_600_000;
+        p.set_override_timestamp(Some(now));
+        storage.set_local_identity_from_game(1030, Some("Main".into()));
+        storage.set_kinah_today(400, now, false);
+        // Alt's login: the list, the self record, then its Kinah.
+        storage.set_content_counts(vec![(1, [12, 9])], true);
+        storage.set_local_identity_from_game(4294, Some("Alt".into()));
+        p.parse_perfect_packet(&hex("13a5ff00000000000000000983c072a1010000"));
+        assert_eq!(storage.kinah_today_at(now), Some(0));
+        assert_eq!(storage.entry_list().owner.as_deref(), Some("Alt"));
+    }
+
+    /// Clicktrough: a character's shop limits and crafts come back when they
+    /// play again (the game sends them only as the shop or crafting window
+    /// opens), and each value says when the game last reported it.
+    #[test]
+    fn shop_limits_and_crafts_come_back_with_their_character() {
+        let (storage, _p) = processor();
+        let now = 1_792_929_600_000;
+        storage.set_local_identity_from_game(1030, Some("Main".into()));
+        storage.set_content_counts(vec![(1, [12, 9])], false);
+        storage.set_shop_limits(&[(100_134, 5, now + 86_400_000)], true);
+        storage.set_craft_counts(&[(32_070_002, 2)], true);
+        let seen = storage.entry_list().seen;
+        assert!(seen.shop_limits.contains_key(&100_134) && seen.crafts.contains_key(&32_070_002));
+        assert!(seen.counts.contains_key(&1));
+        // Alt logs in: not theirs.
+        storage.set_content_counts(vec![(1, [3, 0])], true);
+        storage.set_local_identity_from_game(4294, Some("Alt".into()));
+        assert!(storage.entry_list().shop_limits.is_empty());
+        assert!(storage.craft_counts().is_empty());
+        // Main again: theirs are back.
+        storage.set_content_counts(vec![(1, [12, 9])], true);
+        storage.set_local_identity_from_game(1030, Some("Main".into()));
+        assert_eq!(storage.craft_counts().get(&32_070_002), Some(&2));
+        assert_eq!(storage.shop_limits_at(now).get(&100_134), Some(&(5, Some(now + 86_400_000))));
+        assert!(storage.entry_list().seen.crafts.contains_key(&32_070_002));
+    }
+
