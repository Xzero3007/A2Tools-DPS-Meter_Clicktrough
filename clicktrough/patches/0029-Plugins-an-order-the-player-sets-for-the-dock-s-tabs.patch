+/// Clicktrough: the plugins' order as the player set it, ids.
+pub const ORDER_KEY: &str = "dpsMeter.pluginOrder";
+
+/// Clicktrough: the plugins' order as the player set it (Settings' arrows,
+/// or a dock tab dragged): the dock's tabs follow it.
+pub fn order(app: &tauri::AppHandle) -> Vec<String> {
+    listed(app, ORDER_KEY)
+}
+
+/// Clicktrough: set the plugins' order (ids, each once); the dock's tabs
+/// follow at once, and Settings' list when the dock set it (a tab dragged).
+/// Answers what Settings shows.
+#[tauri::command]
+pub fn plugin_set_order(app: tauri::AppHandle, window: tauri::WebviewWindow, order: Vec<String>) -> Result<PluginsView, String> {
+    let mut ids: Vec<String> = Vec::new();
+    for id in order {
+        if valid_id(&id) && !ids.contains(&id) {
+            ids.push(id);
+        }
+    }
+    if ids.len() > 500 {
+        return Err("too many plugins".into());
+    }
+    let state = app.try_state::<AppState>().ok_or("no app state")?;
+    state.settings.set(ORDER_KEY, &serde_json::to_string(&ids).unwrap_or_default());
+    dock::sync(&app, None);
+    if window.label() != "settings" {
+        let _ = app.emit_to("settings", "plugins-changed", ());
+    }
+    let host = host(&app)?;
+    Ok(view(&app, &host))
+}
+
