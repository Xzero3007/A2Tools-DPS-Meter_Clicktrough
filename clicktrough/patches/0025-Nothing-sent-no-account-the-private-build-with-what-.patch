--- /dev/null
+++ b/src-tauri/src/net_guard.rs
@@ -0,0 +1,164 @@
+//! Clicktrough: the only places this build's network client reaches.
+//!
+//! The meter here downloads and sends nothing else: its own updates (this
+//! fork's releases), the market prices plugins read (`a2.web.get`), and the
+//! world boss and Abyss siege timers players share (a plain download of the
+//! file; nothing is reported back). Every client is built through `builder`:
+//! its name lookups answer only for the hosts below, and it follows a
+//! redirect only to an address `allowed` takes. Each request also checks
+//! its own address first (`check`). Anything else is refused, so code the
+//! original adds later can't reach out through this client either.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+use std::time::Duration;
+
+/// Each place as (host, path prefix), over https only.
+const ALLOWED: &[(&str, &str)] = &[
+    // This fork's update manifest and packages.
+    ("github.com", "/Xzero3007/A2Tools-DPS-Meter_Clicktrough/releases/"),
+    // Where GitHub sends a release download (a signed, short-lived address).
+    ("release-assets.githubusercontent.com", "/"),
+    ("objects.githubusercontent.com", "/"),
+    // The fork's hourly copy of the market prices (branch market-data).
+    ("raw.githubusercontent.com", "/Xzero3007/A2Tools-DPS-Meter_Clicktrough/market-data/"),
+    // The market prices themselves.
+    ("aion2.exchange", "/"),
+    // The shared world boss and Abyss siege timers: the files, read only.
+    ("cdn.a2tools.app", "/feeds/boss-timers/"),
+    ("cdn.a2tools.app", "/feeds/abyss-artifacts/"),
+];
+
+/// Whether `url` is one of the places above: https, no port, user or
+/// password, and no way out of the path.
+pub fn allowed(url: &str) -> bool {
+    let Some(rest) = url.strip_prefix("https://") else { return false };
+    let (host, path) = match rest.find('/') {
+        Some(i) => (&rest[..i], &rest[i..]),
+        None => (rest, "/"),
+    };
+    if host.contains(['@', ':']) || path.contains("..") || path.to_ascii_lowercase().contains("%2e") || path.contains('\\') {
+        return false;
+    }
+    let host = host.to_ascii_lowercase();
+    ALLOWED.iter().any(|(h, prefix)| host == *h && path.starts_with(prefix))
+}
+
+/// `Ok` for an allowed address, else why not.
+pub fn check(url: &str) -> Result<(), String> {
+    if allowed(url) {
+        Ok(())
+    } else {
+        tracing::warn!("Network: refused {url} (not on this build's list)");
+        Err("this build doesn't connect there".into())
+    }
+}
+
+fn host_allowed(host: &str) -> bool {
+    let host = host.trim_end_matches('.').to_ascii_lowercase();
+    ALLOWED.iter().any(|(h, _)| host == *h)
+}
+
+/// Name lookups for the allowed hosts only: any other host doesn't resolve.
+struct Resolver;
+
+impl reqwest::dns::Resolve for Resolver {
+    fn resolve(&self, name: reqwest::dns::Name) -> reqwest::dns::Resolving {
+        let host = name.as_str().to_string();
+        Box::pin(async move {
+            if !host_allowed(&host) {
+                tracing::warn!("Network: refused {host} (not on this build's list)");
+                return Err(format!("{host}: this build doesn't connect there").into());
+            }
+            let addrs: Vec<SocketAddr> = tokio::net::lookup_host((host.as_str(), 0)).await?.collect();
+            Ok(Box::new(addrs.into_iter()) as reqwest::dns::Addrs)
+        })
+    }
+}
+
+/// A client builder that reaches only the allowed places (see the top).
+pub fn builder() -> reqwest::ClientBuilder {
+    reqwest::Client::builder()
+        .user_agent(concat!("A2Tools-DPS-Meter/", env!("CARGO_PKG_VERSION")))
+        .connect_timeout(Duration::from_secs(10))
+        .timeout(Duration::from_secs(30))
+        .dns_resolver(Arc::new(Resolver))
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::custom(|attempt| {
+            if attempt.previous().len() >= 10 {
+                attempt.error("too many redirects")
+            } else if allowed(attempt.url().as_str()) {
+                attempt.follow()
+            } else {
+                tracing::warn!("Network: refused a redirect to {}", attempt.url());
+                attempt.stop()
+            }
+        }))
+}
+
+/// Build `builder`'s client. Never a plain client in its place: one that
+/// can't be built with the guard isn't built at all.
+pub fn build(builder: reqwest::ClientBuilder) -> reqwest::Client {
+    builder.build().unwrap_or_else(|e| {
+        tracing::error!("Network: the client could not be built ({e}); nothing goes out");
+        // The guard alone, which takes nothing: every lookup fails.
+        reqwest::Client::builder()
+            .dns_resolver(Arc::new(Resolver))
+            .redirect(reqwest::redirect::Policy::none())
+            .build()
+            .expect("a network client")
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_the_listed_places() {
+        for ok in [
+            "https://github.com/Xzero3007/A2Tools-DPS-Meter_Clicktrough/releases/latest/download/latest-v2.json",
+            "https://release-assets.githubusercontent.com/github-production-release-asset/1/2?x=y",
+            "https://raw.githubusercontent.com/Xzero3007/A2Tools-DPS-Meter_Clicktrough/market-data/prices/12305.json",
+            "https://aion2.exchange/api/items?server=12305",
+            "https://cdn.a2tools.app/feeds/boss-timers/2001.json",
+            "https://cdn.a2tools.app/feeds/abyss-artifacts/2001.json",
+        ] {
+            assert!(allowed(ok), "{ok}");
+        }
+        for bad in [
+            "https://a2tools.app/api/logs",
+            "https://a2tools.app/api/device/code",
+            "https://cdn.a2tools.app/plugins/index.json",
+            "https://cdn.a2tools.app/patrons-v2.bin",
+            "https://cdn.a2tools.app/latest-v2.json",
+            "https://cdn.a2tools.app/feeds/boss-timers/../../api/x",
+            "https://cdn.a2tools.app/feeds/boss-timers/%2e%2e/x",
+            "http://cdn.a2tools.app/feeds/boss-timers/2001.json",
+            "https://github.com/taengu/A2Tools-DPS-Meter/releases/latest",
+            "https://user@aion2.exchange/api",
+            "https://aion2.exchange:8443/api",
+            "https://aion2.exchange.evil.example/api",
+            "https://discord.gg/x",
+            "wss://a2tools.app/api/boss-timers/live?server=2001",
+        ] {
+            assert!(!allowed(bad), "{bad}");
+        }
+        assert!(host_allowed("github.com"));
+        assert!(host_allowed("AION2.exchange."));
+        assert!(!host_allowed("a2tools.app"));
+        assert!(!host_allowed("logs.a2tools.app"));
+    }
+
+    /// The client itself, not only `allowed`: a host off the list isn't
+    /// even looked up, so nothing leaves the PC for it.
+    #[tokio::test]
+    async fn the_client_reaches_no_other_host() {
+        let client = build(builder());
+        for url in ["https://a2tools.app/api/logs", "https://logs.a2tools.app/", "https://discord.com/"] {
+            let e = client.post(url).body("x").send().await.unwrap_err();
+            let text = format!("{e:?}");
+            assert!(text.contains("doesn't connect there"), "{url}: {text}");
+        }
+    }
+}
