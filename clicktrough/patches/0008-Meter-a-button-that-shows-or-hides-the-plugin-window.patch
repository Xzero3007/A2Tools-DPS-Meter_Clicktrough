diff --git a/public/src/js/pluginsButton.js b/public/src/js/pluginsButton.js
new file mode 100644
index 0000000..9327a0d
--- /dev/null
+++ b/public/src/js/pluginsButton.js
@@ -0,0 +1,39 @@
+// Clicktrough: a button in the meter's header that shows or hides the plugin
+// window (the dock), as its × hides it; lit while it is shown, absent while no
+// plugin is in it. While the meter is locked it stays clickable with the other
+// header buttons (lockedButtons.js). The backend: plugins/dock.rs, dock_toggle.
+(() => {
+  const view = window.A2_VIEW || window.__A2_VIEW__ || "main";
+  const invoke = window.__TAURI__?.core?.invoke;
+  const listen = window.__TAURI__?.event?.listen;
+  if (view !== "main" || typeof invoke !== "function") return;
+
+  const start = () => {
+    const btn = document.querySelector(".pluginsBtn");
+    if (!btn) return;
+    const show = (status) => {
+      if (!status || typeof status !== "object") return;
+      const wasHidden = btn.hidden;
+      btn.hidden = !status.available;
+      btn.classList.toggle("isActive", !!status.shown);
+      btn.setAttribute("aria-pressed", String(!!status.shown));
+      btn.title = btn.getAttribute("aria-label") || "";
+      // The header's buttons moved: the lock button's place is sent again.
+      if (wasHidden !== btn.hidden) requestAnimationFrame(() => window._dpsApp?._sendLockBtnRect?.());
+    };
+    const toggle = () => Promise.resolve(invoke("dock_toggle")).then(show).catch(() => {});
+    btn.addEventListener("click", (event) => {
+      event.stopPropagation();
+      toggle();
+    });
+    btn.addEventListener("keydown", (event) => {
+      if (event.key !== "Enter" && event.key !== " ") return;
+      event.preventDefault();
+      toggle();
+    });
+    Promise.resolve(invoke("dock_status")).then(show).catch(() => {});
+    Promise.resolve(listen?.("dock-status", (event) => show(event?.payload))).catch(() => {});
+  };
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
+  else start();
+})();
