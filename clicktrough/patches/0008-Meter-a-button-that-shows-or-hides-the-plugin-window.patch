diff --git a/tests/plugins-button.test.mjs b/tests/plugins-button.test.mjs
new file mode 100644
index 0000000..41d2a5d
--- /dev/null
+++ b/tests/plugins-button.test.mjs
@@ -0,0 +1,70 @@
+// Clicktrough: the meter's plugins button (pluginsButton.js) shows or hides
+// the plugin window through dock_toggle and follows dock-status.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../public/src/js/pluginsButton.js", import.meta.url), "utf8");
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+function setup({ view = "main", status = { available: true, shown: false }, toggled = { available: true, shown: true } } = {}) {
+  const calls = [];
+  const listeners = {};
+  const attrs = { "aria-label": "Show or hide the plugin window" };
+  const classes = new Set();
+  const handlers = {};
+  const btn = {
+    hidden: true,
+    title: "",
+    classList: { toggle: (name, on) => (on ? classes.add(name) : classes.delete(name)) },
+    setAttribute: (k, v) => { attrs[k] = v; },
+    getAttribute: (k) => attrs[k],
+    addEventListener: (name, handler) => { handlers[name] = handler; },
+  };
+  const window = {
+    A2_VIEW: view,
+    _dpsApp: { _sendLockBtnRect: () => calls.push("lockRect") },
+    __TAURI__: {
+      core: { invoke: (command) => { calls.push(command); return Promise.resolve(command === "dock_toggle" ? toggled : status); } },
+      event: { listen: (name, handler) => { listeners[name] = handler; return Promise.resolve(); } },
+    },
+  };
+  const document = { readyState: "complete", querySelector: (s) => (s === ".pluginsBtn" ? btn : null) };
+  vm.runInContext(source, vm.createContext({ window, document, Promise, requestAnimationFrame: (f) => f() }));
+  return { btn, calls, listeners, handlers, attrs, classes };
+}
+
+test("shows the button while the dock has plugins, lit while it is shown", async () => {
+  const app = setup({ status: { available: true, shown: true } });
+  await tick();
+  assert.equal(app.btn.hidden, false);
+  assert.ok(app.classes.has("isActive"));
+  assert.equal(app.attrs["aria-pressed"], "true");
+  assert.ok(app.calls.includes("lockRect"), "the lock button's place is sent again");
+});
+
+test("a click toggles the dock and follows its answer", async () => {
+  const app = setup();
+  await tick();
+  assert.equal(app.classes.has("isActive"), false);
+  let stopped = false;
+  app.handlers.click({ stopPropagation: () => { stopped = true; } });
+  await tick();
+  assert.equal(stopped, true, "the click doesn't reach the header (no drag)");
+  assert.ok(app.calls.includes("dock_toggle"));
+  assert.ok(app.classes.has("isActive"));
+});
+
+test("follows dock-status from the backend, and hides with no plugins", async () => {
+  const app = setup();
+  await tick();
+  app.listeners["dock-status"]({ payload: { available: false, shown: false } });
+  assert.equal(app.btn.hidden, true);
+});
+
+test("only in the meter's window", async () => {
+  const app = setup({ view: "details" });
+  await tick();
+  assert.deepEqual(app.calls, []);
+});
