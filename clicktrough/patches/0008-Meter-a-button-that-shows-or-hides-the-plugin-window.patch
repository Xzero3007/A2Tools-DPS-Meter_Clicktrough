+/// Clicktrough: whether the dock has plugins, and whether any tab is shown,
+/// for the meter's plugins button.
+pub fn status(app: &tauri::AppHandle) -> Value {
+    serde_json::json!({ "available": !members(app).is_empty(), "shown": !shown_members(app).is_empty() })
+}
+
+#[tauri::command]
+pub fn dock_status(app: tauri::AppHandle) -> Value {
+    status(&app)
+}
+
+/// The meter's plugins button: the dock hidden as by its ×, or shown again
+/// with the tabs it was hidden with (all of them if it never was).
+#[tauri::command]
+pub fn dock_toggle(app: tauri::AppHandle) -> Value {
+    let members = members(&app);
+    if members.is_empty() {
+        return status(&app);
+    }
+    if !shown_members(&app).is_empty() {
+        dock_close(app.clone());
+        return status(&app);
+    }
+    let closed_with: Vec<String> = listed(&app, CLOSED_WITH_KEY).into_iter().filter(|id| members.contains(id)).collect();
+    if let Some(state) = app.try_state::<AppState>() {
+        state.settings.set(CLOSED_WITH_KEY, "[]");
+    }
+    for id in if closed_with.is_empty() { &members } else { &closed_with } {
+        super::remember_window(&app, id, Some("shown"));
+    }
+    sync(&app, None);
+    status(&app)
+}
