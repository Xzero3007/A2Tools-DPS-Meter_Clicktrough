--- a/public/src/js/pluginDock.css
+++ b/public/src/js/pluginDock.css
@@ -227,3 +227,46 @@ body.dockFolded .dockStage {
 .dockTabTarget {
   box-shadow: inset 2px 0 0 #e2b54f;
 }
+
+/* Clicktrough: full opacity and this window's lock, beside the slider.
+   Pressed in gold, as the meter's pressed buttons (no blue). */
+.dockOpaque,
+.dockLock {
+  flex: none;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 15px;
+  height: 15px;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: rgba(255, 255, 255, 0.55);
+  cursor: pointer;
+  transition: color 120ms ease;
+}
+.dockOpaque svg,
+.dockLock svg {
+  width: 15px;
+  height: 15px;
+}
+.dockOpaque:hover,
+.dockOpaque:focus-visible,
+.dockLock:hover,
+.dockLock:focus-visible {
+  color: #fff;
+}
+.dockOpaque[aria-pressed="true"],
+.dockLock[aria-pressed="true"] {
+  color: #e2b54f;
+}
+.dockOpaque[aria-pressed="true"] .dockOpaqueFill {
+  fill: currentColor;
+}
+.dockLock .dockLockShut,
+.dockLock[aria-pressed="true"] .dockLockOpen {
+  display: none;
+}
+.dockLock[aria-pressed="true"] .dockLockShut {
+  display: inline;
+}
