+  // One opacity for the whole dock. Clicktrough: the button beside the
+  // slider makes it fully opaque, and the slider's value again at the next
+  // press; moving the slider lets go of it.
+  const opaqueBtn = document.querySelector(".dockOpaque");
+  const applyOpacity = () => {
+    document.body.style.setProperty("--panel-alpha", String(prefs.opaque ? 1 : prefs.opacity / 100));
+    opaqueBtn?.setAttribute("aria-pressed", String(!!prefs.opaque));
+    if (opaqueBtn) setLabel(opaqueBtn, prefs.opaque
+      ? t("opaqueOff", "Back to the slider's opacity")
+      : t("opaque", "Full opacity (press again for the slider's)"));
+  };
   opacity.value = String(prefs.opacity);
   applyOpacity();
   opacity.addEventListener("input", () => {
     prefs.opacity = Number(opacity.value) || 100;
+    prefs.opaque = false;
+    applyOpacity();
+    savePrefs();
+  });
+  opaqueBtn?.addEventListener("click", () => {
+    prefs.opaque = !prefs.opaque;
     applyOpacity();
     savePrefs();
   });
 
+  // Clicktrough: this window's own lock. With every meter window locked, it
+  // frees this one alone (clicks and scrolling in the plugins), and locks it
+  // again; with them free, it locks this one alone. The meter keeps it until
+  // the lock of all windows changes, then this window follows that again.
+  const lockBtn = document.querySelector(".dockLock");
+  const showLock = (locked) => {
+    if (!lockBtn) return;
+    lockBtn.setAttribute("aria-pressed", String(!!locked));
+    setLabel(lockBtn, locked
+      ? t("unlockDock", "Free this window (clicks stay here; the meter stays locked)")
+      : t("lockDock", "Lock this window (clicks go to the game)"));
+  };
+  lockBtn?.addEventListener("click", () => {
+    invoke("dock_lock_toggle").then(showLock).catch(() => {});
+  });
+  listen("dock-locked", (event) => showLock(event.payload === true));
+  invoke("dock_lock_state").then(showLock).catch(() => showLock(false));
+
