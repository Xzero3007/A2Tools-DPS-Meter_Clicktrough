diff --git a/src-tauri/src/app.rs b/src-tauri/src/app.rs
index 50b2864..fffb15e 100644
--- a/src-tauri/src/app.rs
+++ b/src-tauri/src/app.rs
@@ -435,6 +435,40 @@ fn other_window_ignores(label: &str, screenshot: bool, all_locked: bool) -> Opti
     tool.then_some(screenshot || all_locked)
 }
 
+/// Clicktrough: the plugin dock's own lock, set by its lock button: 0 as
+/// the other windows, 1 locked, 2 free. Back to 0 when the lock of all
+/// windows changes, so the dock follows it again.
+static DOCK_LOCK: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+/// The lock of all windows when last synced: 0 off, 1 on, 2 not yet.
+static LAST_ALL_LOCKED: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(2);
+
+/// Clicktrough: whether the plugin dock lets clicks through now: its own
+/// lock where its button set one, else as the other windows.
+fn dock_locked(all_locked: bool) -> bool {
+    match DOCK_LOCK.load(std::sync::atomic::Ordering::Relaxed) {
+        1 => true,
+        2 => false,
+        _ => all_locked,
+    }
+}
+
+/// Clicktrough: the dock's lock button. Locked: clicks go through it to the
+/// game; free: it takes them, while the other windows stay as they are.
+/// Answers whether it is locked now.
+#[tauri::command]
+fn dock_lock_toggle(app: tauri::AppHandle) -> bool {
+    let locked = !dock_locked(ALL_WINDOWS_LOCKED.load(std::sync::atomic::Ordering::Relaxed));
+    DOCK_LOCK.store(if locked { 1 } else { 2 }, std::sync::atomic::Ordering::Relaxed);
+    sync_other_windows(&app);
+    locked
+}
+
+/// Clicktrough: whether the dock is locked now, for its lock button.
+#[tauri::command]
+fn dock_lock_state() -> bool {
+    dock_locked(ALL_WINDOWS_LOCKED.load(std::sync::atomic::Ordering::Relaxed))
+}
+
 /// Every window besides the overlay as the screenshot tool and the lock say:
 /// all or nothing for the tool windows, by their lock and area for plugins'
 /// icons. Called when either changes, and when a tool window opens.
@@ -445,6 +479,13 @@ pub fn sync_other_windows(app: &tauri::AppHandle) {
             && s.settings.get(LOCK_ALL_WINDOWS_KEY).as_deref() == Some("true")
     });
     ALL_WINDOWS_LOCKED.store(locked, Ordering::Relaxed);
+    // Clicktrough: the lock of all windows changed: the dock follows it again.
+    let was = LAST_ALL_LOCKED.swap(locked as u8, Ordering::Relaxed);
+    if was != 2 && was != locked as u8 {
+        DOCK_LOCK.store(0, Ordering::Relaxed);
+    }
+    let dock = dock_locked(locked);
+    let _ = app.emit_to(crate::plugins::dock::LABEL, "dock-locked", dock);
     // The pages stop offering their resize edges while locked: the right
     // one is the strip that scrolls them (tauriBridge.js).
     let _ = app.emit("meter-windows-locked", locked);
@@ -454,6 +495,8 @@ pub fn sync_other_windows(app: &tauri::AppHandle) {
         .is_none_or(|s| s.settings.get(LOCK_SCROLL_EDGE_KEY).as_deref() != Some("false"));
     let buttons = lock_buttons_on(app);
     for (label, window) in app.webview_windows() {
+        // Clicktrough: the dock by its own lock.
+        let locked = if label == crate::plugins::dock::LABEL { dock } else { locked };
         let Some(ignore) = other_window_ignores(&label, screenshot, locked) else { continue };
         // Locked, not while a screenshot tool is in front (its selection is
         // dragged across them).
@@ -4449,6 +4492,8 @@ pub fn run() {
             crate::plugins::plugin_window_size,
             crate::plugins::plugin_restore_bundled,
             crate::plugins::plugin_set_order,
+            dock_lock_toggle,
+            dock_lock_state,
