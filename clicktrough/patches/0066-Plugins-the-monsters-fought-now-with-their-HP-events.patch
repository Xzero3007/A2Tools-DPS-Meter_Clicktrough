+/// Clicktrough: how often `events:combat` looks, and its heartbeat.
+const COMBAT_EVERY: Duration = Duration::from_millis(250);
+const COMBAT_BEAT: Duration = Duration::from_secs(2);
+/// A monster not hit for this long is no longer fought; long enough for a
+/// boss's phase it can't be hit in.
+const COMBAT_WITHIN_MS: i64 = 20_000;
+
+/// Clicktrough: the `combat` event: `{ at, fought: [{ entity, npc, name, boss,
+/// hp, maxHp, since, lastHit }] }`, bosses first (`DataStorage::fought_now`).
+fn combat_event(app: &tauri::AppHandle) -> Option<Value> {
+    let state = app.try_state::<AppState>()?;
+    let now = crate::clock::now_ms();
+    let fought: Vec<Value> = state
+        .data_storage
+        .fought_now(now, COMBAT_WITHIN_MS, 8)
+        .into_iter()
+        .map(|f| {
+            serde_json::json!({
+                "entity": f.entity,
+                "npc": f.npc,
+                "name": state.npc_lookup.get_npc_name(f.npc),
+                "boss": f.boss,
+                "hp": f.hp,
+                "maxHp": f.max_hp,
+                "since": f.first_hit,
+                "lastHit": f.last_hit,
+            })
+        })
+        .collect();
+    Some(serde_json::json!({ "at": now, "fought": fought }))
+}
