+    /// Clicktrough: the monsters fought now, for plugins (`events:combat`):
+    /// each that took damage in the last `within_ms`, not dead, with its NPC
+    /// code, HP as the meter last read it and max HP (from its spawn, else the
+    /// highest reading). Bosses (the NPC table's) first, then the most recently
+    /// hit; at most `limit`.
+    pub fn fought_now(&self, now_ms: i64, within_ms: i64, limit: usize) -> Vec<Fought> {
+        let inner = self.inner.read();
+        let mut out: Vec<Fought> = inner
+            .target_combat
+            .values()
+            .filter(|t| now_ms - t.last_damage_time <= within_ms)
+            .filter(|t| is_mob(&inner, t.target_id) && !inner.dead_entity_ids.contains(&t.target_id))
+            .filter_map(|t| {
+                let id = t.target_id;
+                Some(Fought {
+                    entity: id,
+                    npc: *inner.mob_storage.get(&id)?,
+                    hp: inner.mob_current_hp.get(&id).copied(),
+                    max_hp: inner.mob_hp_data.get(&id).copied().filter(|&m| m > 0),
+                    boss: inner.boss_entity_ids.contains(&id),
+                    first_hit: t.first_damage_time,
+                    last_hit: t.last_damage_time,
+                })
+            })
+            .collect();
+        out.sort_by(|a, b| b.boss.cmp(&a.boss).then(b.last_hit.cmp(&a.last_hit)));
+        out.truncate(limit);
+        out
+    }
