+/// Clicktrough: a monster being fought, for plugins (`fought_now`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Fought {
+    pub entity: i32,
+    /// Its NPC code.
+    pub npc: i32,
+    /// Its HP as last read; none before the first reading.
+    pub hp: Option<i32>,
+    pub max_hp: Option<i32>,
+    /// A boss in the NPC table.
+    pub boss: bool,
+    /// When this fight with it began and when it was last hit (ms).
+    pub first_hit: i64,
+    pub last_hit: i64,
+}
