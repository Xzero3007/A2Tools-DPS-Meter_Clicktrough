     use super::*;
 
+    #[test]
+    fn the_monsters_fought_now_bosses_first_with_their_hp() {
+        let s = DataStorage::new();
+        let hit = |target: i32, at: i64| {
+            let mut p = ParsedDamagePacket::new();
+            p.set_actor_id(1792);
+            p.set_target_id(target);
+            p.set_skill_code(16_010_000);
+            p.set_damage(100);
+            p.set_timestamp(at);
+            s.append_damage(p);
+        };
+        s.append_mob(500, 2_100_079);
+        s.register_boss(500);
+        s.append_mob_hp(500, 1_000_000);
+        s.set_mob_current_hp(500, 640_000);
+        s.append_mob(501, 2_000_123);
+        s.append_mob(502, 2_000_124);
+        s.mark_entity_dead(502);
+        hit(500, 10_000);
+        hit(501, 12_000);
+        hit(502, 12_000);
+        hit(1792, 12_000); // a player: not a monster
+        let now = s.fought_now(13_000, 10_000, 8);
+        assert_eq!(now.iter().map(|f| f.entity).collect::<Vec<_>>(), vec![500, 501]);
+        assert_eq!((now[0].npc, now[0].hp, now[0].max_hp, now[0].boss), (2_100_079, Some(640_000), Some(1_000_000), true));
+        assert_eq!((now[1].hp, now[1].max_hp, now[1].boss), (None, None, false));
+        // Not hit for longer than the window: no longer fought.
+        assert_eq!(s.fought_now(21_000, 10_000, 8).iter().map(|f| f.entity).collect::<Vec<_>>(), vec![501]);
+    }
