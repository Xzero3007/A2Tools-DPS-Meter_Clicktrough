From 7f0f41cf733ede2318cecbb85cccf65c5f057940 Mon Sep 17 00:00:00 2001
From: A2Tools-patch <patch@localhost>
Date: Wed, 11 Nov 2026 20:54:21 +0000
Subject: [PATCH] Plugins: one widget open at a time, never two windows for one
 widget

Two a2.widgets.open calls at once both found no window and both built
one: the second, unknown to the meter, stayed on screen empty and could
not be closed (the Closet window at the shop, two tabs told in one
moment). The opens now run one after the other.
---
 src-tauri/src/plugins/widgets.rs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src-tauri/src/plugins/widgets.rs b/src-tauri/src/plugins/widgets.rs
index 26fa6fd..7188eb7 100644
--- a/src-tauri/src/plugins/widgets.rs
+++ b/src-tauri/src/plugins/widgets.rs
@@ -361,6 +361,12 @@ pub async fn plugin_widget_open(
     if !valid_name(&name) {
         return Err("a widget name is 1 to 32 lowercase letters, digits and '-'".into());
     }
+    // Clicktrough: one open at a time. Two calls at once (a plugin told of
+    // two shop tabs in one moment) both found no window and both built one:
+    // the second, unknown to the meter, stayed on screen empty and could not
+    // be closed (Closet, 2026-11-11).
+    static OPENING: Mutex<()> = Mutex::new(());
+    let _opening = OPENING.lock().unwrap_or_else(|p| p.into_inner());
     let size = |v: f64| if v.is_finite() { v.clamp(24.0, 800.0) } else { 64.0 };
     let (width, height) = (size(width), size(height));
     if let Some(widget) = app.get_webview_window(&label(&id, &name)) {
-- 
