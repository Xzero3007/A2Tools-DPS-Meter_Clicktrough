diff --git a/public/src/js/lockedButtons.js b/public/src/js/lockedButtons.js
index ed9e2e7..5336469 100644
--- a/public/src/js/lockedButtons.js
+++ b/public/src/js/lockedButtons.js
@@ -16,10 +16,10 @@
     : window.A2_VIEW || window.__A2_VIEW__ || "main";
 
   // What stays clickable in each window: the controls that open, close and
-  // switch windows, views and tabs, and the menus they open. Not the meter's
