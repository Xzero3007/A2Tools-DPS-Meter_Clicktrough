diff --git a/public/src/js/mediaRow.js b/public/src/js/mediaRow.js
index 20d0d54..819d328 100644
--- a/public/src/js/mediaRow.js
+++ b/public/src/js/mediaRow.js
@@ -79,7 +79,9 @@
     const bar = header.querySelector(".headerBtns");
     const placeBtn = () => {
       if (!bar || rowBtn.parentNode === bar) return;
-      const before = bar.querySelector(".overlayBtn, .pluginsBtn");
+      // Where the Streams plugin stands in the plugins' order (its overlay's
+      // slot, overlayButtons.js), else before the overlay buttons.
+      const before = bar.querySelector(".overlaySlot") || bar.querySelector(".overlayBtn, .pluginsBtn");
       bar.insertBefore(rowBtn, before && before.parentNode === bar ? before : null);
       try { window.lucide?.createIcons?.({ root: rowBtn }); } catch {}
     };
diff --git a/public/src/js/overlayButtons.js b/public/src/js/overlayButtons.js
index 65b93be..c9255b5 100644
--- a/public/src/js/overlayButtons.js
+++ b/public/src/js/overlayButtons.js
@@ -4,6 +4,10 @@
 // overlay alone, the plugin window staying as it is. Gold while the overlay
 // is on. While the meter is locked it stays clickable with the other header
 // buttons (lockedButtons.js). The backend: plugins/overlays.rs.
+//
+// The buttons follow the plugins' order (the dock's tabs). An overlay without
+// a button of its own (the Streams plugin's video) leaves a hidden slot, and
+// the player row's TV button (mediaRow.js) stands there.
 (() => {
   const view = window.A2_VIEW || window.__A2_VIEW__ || "main";
   const invoke = window.__TAURI__?.core?.invoke;
@@ -17,11 +21,20 @@
     let shownKey = "";
     const render = (list) => {
       if (!Array.isArray(list)) return;
-      const key = JSON.stringify(list.map((o) => [o.id, o.icon, o.title]));
+      const key = JSON.stringify(list.map((o) => [o.id, o.icon, o.title, o.button !== false]));
       if (key !== shownKey) {
         shownKey = key;
-        for (const old of bar.querySelectorAll(".overlayBtn")) old.remove();
+        for (const old of bar.querySelectorAll(".overlayBtn, .overlaySlot")) old.remove();
+        const at = before && before.parentNode === bar ? before : null;
         for (const o of list) {
+          if (o.button === false) {
+            const slot = document.createElement("span");
+            slot.className = "overlaySlot";
+            slot.dataset.plugin = o.id;
+            slot.hidden = true;
+            bar.insertBefore(slot, at);
+            continue;
+          }
           const btn = document.createElement("div");
           btn.className = "headerBtn overlayBtn";
           btn.dataset.plugin = o.id;
@@ -41,8 +54,12 @@
             event.preventDefault();
             toggle();
           });
-          bar.insertBefore(btn, before && before.parentNode === bar ? before : null);
+          bar.insertBefore(btn, at);
         }
+        // The player row's TV button in the first slot.
+        const slot = bar.querySelector(".overlaySlot");
+        const tv = bar.querySelector(".mediaRowBtn");
+        if (slot && tv) bar.insertBefore(tv, slot);
         try { window.lucide?.createIcons?.({ root: bar }); } catch {}
         // The header's buttons moved: the lock button's place is sent again.
         requestAnimationFrame(() => window._dpsApp?._sendLockBtnRect?.());
diff --git a/src-tauri/src/plugins/mod.rs b/src-tauri/src/plugins/mod.rs
index 695ac40..0db0241 100644
--- a/src-tauri/src/plugins/mod.rs
+++ b/src-tauri/src/plugins/mod.rs
@@ -384,6 +384,8 @@ pub fn plugin_set_order(app: tauri::AppHandle, window: tauri::WebviewWindow, ord
     let state = app.try_state::<AppState>().ok_or("no app state")?;
     state.settings.set(ORDER_KEY, &serde_json::to_string(&ids).unwrap_or_default());
     dock::sync(&app, None);
+    // Clicktrough: the meter's header buttons follow the new order at once.
+    overlays::notify(&app);
     if window.label() != "settings" {
         let _ = app.emit_to("settings", "plugins-changed", ());
     }
diff --git a/src-tauri/src/plugins/overlays.rs b/src-tauri/src/plugins/overlays.rs
index 071441e..6e57d30 100644
--- a/src-tauri/src/plugins/overlays.rs
+++ b/src-tauri/src/plugins/overlays.rs
@@ -14,6 +14,11 @@
 //! `"button": false` leaves the header button out (the Streams plugin's
 //! video: the meter's player row has its own button), the overlay keeping
 //! the rest (Settings' places to hide it, the plugins button leaving it).
+//!
+//! The header's buttons follow the plugins' order (the dock's tabs, Settings).
+//! An overlay without a button of its own is still listed (`"button":
+//! false`): the header puts the player row's TV button in its place, so the
+//! TV stands where the Streams plugin stands in that order.
 
 use serde_json::Value;
 use tauri::Emitter;
@@ -96,16 +101,17 @@ pub fn is_overlay(app: &tauri::AppHandle, label: &str) -> bool {
 fn listed(app: &tauri::AppHandle) -> Value {
     let list: Vec<Value> = declared(app)
         .into_iter()
-        .filter(|o| o.button)
         .map(|o| {
             let on = is_on(app, &super::widgets::label(&o.id, &o.widget));
-            serde_json::json!({ "id": o.id, "name": o.name, "title": o.title, "icon": o.icon, "on": on })
+            serde_json::json!({ "id": o.id, "name": o.name, "title": o.title, "icon": o.icon, "on": on, "button": o.button })
         })
         .collect();
     Value::Array(list)
 }
 
-/// The header's overlay buttons: `[{ id, name, title, icon, on }]`.
+/// The header's overlay buttons, in the plugins' order: `[{ id, name,
+/// title, icon, on, button }]` (`button: false`: no button of its own, the
+/// player row's TV button takes its place).
 #[tauri::command]
 pub fn plugin_overlays(app: tauri::AppHandle) -> Value {
     listed(&app)
