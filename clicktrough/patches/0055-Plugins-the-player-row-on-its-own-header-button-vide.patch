 src-tauri/src/plugins/overlays.rs |  14 ++-
 src-tauri/src/plugins/video.rs    | 200 ++++++++++++++++++++++++++++--
 src-tauri/src/plugins/widgets.rs  |   8 +-
 src/styles.css                    |   4 +
 5 files changed, 282 insertions(+), 18 deletions(-)

