+    /// A GL function by name: the context's loader, else the GL libraries.
+    fn gl_fn(name: &CStr) -> usize {
+        let p = get_proc_address(std::ptr::null_mut(), name.as_ptr());
+        if !p.is_null() {
+            return p as usize;
+        }
+        static LIBS: OnceLock<Vec<libloading::Library>> = OnceLock::new();
+        let libs = LIBS.get_or_init(|| {
+            ["libOpenGL.so.0", "libGL.so.1", "libGLESv2.so.2"].iter().filter_map(|l| unsafe { libloading::Library::new(l).ok() }).collect()
+        });
+        for l in libs {
+            if let Ok(f) = unsafe { l.get::<*mut c_void>(name.to_bytes_with_nul()) } {
+                if !f.is_null() {
+                    return *f as usize;
+                }
+            }
+        }
+        0
+    }
