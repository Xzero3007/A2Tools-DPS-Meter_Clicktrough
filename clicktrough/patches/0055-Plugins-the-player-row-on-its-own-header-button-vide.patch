+    /// The video's opacity: mpv draws it opaque, then one pass over the
+    /// area multiplies every pixel (colour and alpha) by the opacity, so
+    /// the area's picture is see-through as GTK puts it on the window. A
+    /// window's or widget's own opacity did nothing on KDE (Wayland).
+    /// The program: a triangle over the whole area, colour nothing; the
+    /// blend (zero, constant alpha) does the multiplying.
+    fn fade_program(area: &gtk::GLArea) -> Option<(u32, u32)> {
+        type CreateShader = unsafe extern "C" fn(u32) -> u32;
+        type ShaderSource = unsafe extern "C" fn(u32, c_int, *const *const c_char, *const c_int);
+        type Uint = unsafe extern "C" fn(u32);
+        type GetShaderiv = unsafe extern "C" fn(u32, u32, *mut c_int);
+        type CreateProgram = unsafe extern "C" fn() -> u32;
+        type Attach = unsafe extern "C" fn(u32, u32);
+        type GenVertexArrays = unsafe extern "C" fn(c_int, *mut u32);
+        const VERTEX: u32 = 0x8B31;
+        const FRAGMENT: u32 = 0x8B30;
+        const COMPILE_STATUS: u32 = 0x8B81;
+        const LINK_STATUS: u32 = 0x8B82;
+        let f = |n: &CStr| gl_fn(n);
+        let (cs, src, comp, gsi, cp, att, link, gpi, gva, del) = (
+            f(c"glCreateShader"), f(c"glShaderSource"), f(c"glCompileShader"), f(c"glGetShaderiv"),
+            f(c"glCreateProgram"), f(c"glAttachShader"), f(c"glLinkProgram"), f(c"glGetProgramiv"),
+            f(c"glGenVertexArrays"), f(c"glDeleteShader"),
+        );
+        if [cs, src, comp, gsi, cp, att, link, gpi, gva, del].contains(&0) {
+            return None;
+        }
+        let es = area.context().is_some_and(|c| c.uses_es());
+        let head = if es { "#version 300 es\nprecision mediump float;\n" } else { "#version 150\n" };
+        let vs = format!("{head}void main() {{ vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2)); gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0); }}\0");
+        let fs = format!("{head}out vec4 colour; void main() {{ colour = vec4(0.0); }}\0");
+        unsafe {
+            let create: CreateShader = std::mem::transmute(cs);
+            let source: ShaderSource = std::mem::transmute(src);
+            let compile: Uint = std::mem::transmute(comp);
+            let shader_iv: GetShaderiv = std::mem::transmute(gsi);
+            let program_iv: GetShaderiv = std::mem::transmute(gpi);
+            let attach: Attach = std::mem::transmute(att);
+            let link_program: Uint = std::mem::transmute(link);
+            let delete: Uint = std::mem::transmute(del);
+            let build = |kind: u32, text: &str| -> Option<u32> {
+                let sh = create(kind);
+                let ptr = text.as_ptr() as *const c_char;
+                source(sh, 1, &ptr, std::ptr::null());
+                compile(sh);
+                let mut ok: c_int = 0;
+                shader_iv(sh, COMPILE_STATUS, &mut ok);
+                (ok != 0).then_some(sh)
+            };
+            let v = build(VERTEX, &vs)?;
+            let fr = build(FRAGMENT, &fs)?;
+            let program = (std::mem::transmute::<usize, CreateProgram>(cp))();
+            attach(program, v);
+            attach(program, fr);
+            link_program(program);
+            delete(v);
+            delete(fr);
+            let mut ok: c_int = 0;
+            program_iv(program, LINK_STATUS, &mut ok);
+            if ok == 0 {
+                return None;
+            }
+            let mut vao = 0u32;
+            (std::mem::transmute::<usize, GenVertexArrays>(gva))(1, &mut vao);
+            Some((program, vao))
+        }
+    }
+
+    fn fade_draw(area: &gtk::GLArea, fbo: c_int, program: u32, vao: u32, opacity: f64) {
+        type Uint = unsafe extern "C" fn(u32);
+        type BlendFunc = unsafe extern "C" fn(u32, u32);
+        type BlendColor = unsafe extern "C" fn(f32, f32, f32, f32);
+        type Viewport = unsafe extern "C" fn(c_int, c_int, c_int, c_int);
+        type DrawArrays = unsafe extern "C" fn(u32, c_int, c_int);
+        const BLEND: u32 = 0x0BE2;
+        const ZERO: u32 = 0;
+        const CONSTANT_ALPHA: u32 = 0x8003;
+        const TRIANGLES: u32 = 0x0004;
+        type BindFramebuffer = unsafe extern "C" fn(u32, u32);
+        const FRAMEBUFFER: u32 = 0x8D40;
+        static FNS: OnceLock<[usize; 9]> = OnceLock::new();
+        let fns = FNS.get_or_init(|| [
+            gl_fn(c"glUseProgram"), gl_fn(c"glBindVertexArray"), gl_fn(c"glEnable"), gl_fn(c"glDisable"),
+            gl_fn(c"glBlendFunc"), gl_fn(c"glBlendColor"), gl_fn(c"glViewport"), gl_fn(c"glDrawArrays"),
+            gl_fn(c"glBindFramebuffer"),
+        ]);
+        if fns.contains(&0) {
+            return;
+        }
+        let scale = area.scale_factor();
+        unsafe {
+            let use_program: Uint = std::mem::transmute(fns[0]);
+            let bind_vao: Uint = std::mem::transmute(fns[1]);
+            let enable: Uint = std::mem::transmute(fns[2]);
+            let disable: Uint = std::mem::transmute(fns[3]);
+            let blend_func: BlendFunc = std::mem::transmute(fns[4]);
+            let blend_color: BlendColor = std::mem::transmute(fns[5]);
+            let viewport: Viewport = std::mem::transmute(fns[6]);
+            let draw_arrays: DrawArrays = std::mem::transmute(fns[7]);
+            // mpv leaves its own framebuffer bound, not the area's.
+            (std::mem::transmute::<usize, BindFramebuffer>(fns[8]))(FRAMEBUFFER, fbo as u32);
+            viewport(0, 0, area.allocated_width() * scale, area.allocated_height() * scale);
+            use_program(program);
+            bind_vao(vao);
+            enable(BLEND);
+            blend_func(ZERO, CONSTANT_ALPHA);
+            blend_color(0.0, 0.0, 0.0, opacity.clamp(0.0, 1.0) as f32);
+            draw_arrays(TRIANGLES, 0, 3);
+            disable(BLEND);
+            bind_vao(0);
+            use_program(0);
+        }
     }
 
