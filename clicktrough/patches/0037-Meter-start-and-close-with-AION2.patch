diff --git a/src-tauri/src/platform/game_watch.rs b/src-tauri/src/platform/game_watch.rs
new file mode 100644
index 0000000..d269a21
--- /dev/null
+++ b/src-tauri/src/platform/game_watch.rs
@@ -0,0 +1,197 @@
+//! Clicktrough: the meter starts with AION2 and closes with it.
+//!
+//! A small watcher (`a2tools-game-watch`, tools/a2t_game_watch.rs) runs from
+//! the desktop's autostart while "Start and close with AION2" is on. When the
+//! game starts and no meter runs, it starts one with `--with-game`; only such
+//! a meter closes again once the game is gone. A meter started by hand behaves
+//! as always. The decisions live here, plain and tested on every build; the
+//! watcher includes this file, so it needs nothing else of the meter.
+
+use std::time::Duration;
+
+/// The argument the watcher starts the meter with.
+pub const WITH_GAME_ARG: &str = "--with-game";
+
+/// The watcher's file name, next to the meter's.
+pub const WATCHER_NAME: &str = "a2tools-game-watch";
+
+/// The meter's file name.
+pub const METER_NAME: &str = "a2tools-dps-meter";
+
+/// The autostart entry's file name (in `~/.config/autostart/`).
+pub const AUTOSTART_FILE: &str = "a2tools-game-watch.desktop";
+
+/// How often the watcher, and a meter started with the game, look for it.
+pub const POLL: Duration = Duration::from_secs(3);
+
+/// How long the game must be gone before a meter started with it closes: a
+/// game restarted at once keeps its meter.
+pub const GONE_FOR: Duration = Duration::from_secs(10);
+
+/// How long a meter started with the game waits to see it at all. Not seen
+/// by then (the game closed at once), it stays, as one started by hand.
+pub const FIRST_SEEN_WITHIN: Duration = Duration::from_secs(60);
+
+/// Whether a process is a meter, from its `/proc/<pid>/comm` (the kernel
+/// keeps the first 15 bytes of the name).
+pub fn is_meter_comm(comm: &str) -> bool {
+    let comm = comm.trim();
+    !comm.is_empty() && METER_NAME.starts_with(comm) && comm.len() >= 15.min(METER_NAME.len())
+}
+
+/// Where the autostart entry lies: `$XDG_CONFIG_HOME/autostart`, or
+/// `~/.config/autostart`.
+pub fn autostart_path() -> Option<std::path::PathBuf> {
+    std::env::var_os("XDG_CONFIG_HOME")
+        .filter(|dir| !dir.is_empty())
+        .map(std::path::PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|home| std::path::PathBuf::from(home).join(".config")))
+        .map(|dir| dir.join("autostart").join(AUTOSTART_FILE))
+}
+
+/// The autostart entry that runs the watcher at each login.
+pub fn autostart_entry(watcher: &str) -> String {
+    format!(
+        "[Desktop Entry]\n\
+         Type=Application\n\
+         Name=A2Tools DPS Meter: start with AION2\n\
+         Comment=Starts the meter when AION2 starts. Turn it off in the meter's Settings.\n\
+         Exec=\"{watcher}\"\n\
+         Icon={METER_NAME}\n\
+         NoDisplay=true\n\
+         Terminal=false\n\
+         X-GNOME-Autostart-enabled=true\n"
+    )
+}
+
+/// The watcher's decision: start a meter at the moment the game appears, if
+/// none runs. Once per start of the game, so a meter closed by hand while
+/// the game runs stays closed.
+#[derive(Debug, Default)]
+pub struct Watcher {
+    game_was_running: bool,
+}
+
+impl Watcher {
+    /// `game` and `meter`: whether each runs now. True: start the meter.
+    pub fn step(&mut self, game: bool, meter: bool) -> bool {
+        let started = game && !self.game_was_running;
+        self.game_was_running = game;
+        started && !meter
+    }
+}
+
+/// A meter started with the game: whether to close now.
+#[derive(Debug)]
+pub struct WithGame {
+    started: Duration,
+    seen: bool,
+    gone_since: Option<Duration>,
+}
+
+impl WithGame {
+    /// `now`: time since some fixed moment (the meter's start, say).
+    pub fn new(now: Duration) -> Self {
+        WithGame { started: now, seen: false, gone_since: None }
+    }
+
+    /// Whether the game was seen at all, or there is still time to.
+    pub fn waiting(&self, now: Duration) -> bool {
+        self.seen || now.saturating_sub(self.started) < FIRST_SEEN_WITHIN
+    }
+
+    /// `game`: whether it runs now. True: close the meter.
+    pub fn step(&mut self, game: bool, now: Duration) -> bool {
+        if game {
+            self.seen = true;
+            self.gone_since = None;
+            return false;
+        }
+        if !self.seen {
+            return false;
+        }
+        let since = *self.gone_since.get_or_insert(now);
+        now.saturating_sub(since) >= GONE_FOR
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn s(secs: u64) -> Duration {
+        Duration::from_secs(secs)
+    }
+
+    #[test]
+    fn the_meter_s_process_name() {
+        assert!(is_meter_comm("a2tools-dps-met\n"));
+        assert!(is_meter_comm("a2tools-dps-meter"));
+        assert!(!is_meter_comm("a2tools-game-wa"));
+        assert!(!is_meter_comm("a2tools-hotkeys"));
+        assert!(!is_meter_comm("a2tools"));
+        assert!(!is_meter_comm(""));
+    }
+
+    #[test]
+    fn the_watcher_starts_a_meter_once_per_game_start() {
+        let mut w = Watcher::default();
+        assert!(!w.step(false, false));
+        assert!(w.step(true, false), "the game started, no meter");
+        assert!(!w.step(true, false), "closed by hand meanwhile: not again");
+        assert!(!w.step(false, false));
+        assert!(w.step(true, false), "the next start of the game");
+    }
+
+    #[test]
+    fn a_running_meter_is_left_alone() {
+        let mut w = Watcher::default();
+        assert!(!w.step(true, true));
+        assert!(!w.step(true, false));
+    }
+
+    #[test]
+    fn running_at_the_watcher_s_start_counts_as_a_start() {
+        // Turned on in Settings while playing: the meter runs, so nothing.
+        let mut w = Watcher::default();
+        assert!(!w.step(true, true));
+    }
+
+    #[test]
+    fn closes_ten_seconds_after_the_game() {
+        let mut g = WithGame::new(s(0));
+        assert!(!g.step(true, s(3)));
+        assert!(!g.step(false, s(6)));
+        assert!(!g.step(false, s(12)));
+        assert!(g.step(false, s(16)));
+    }
+
+    #[test]
+    fn a_quick_restart_of_the_game_keeps_the_meter() {
+        let mut g = WithGame::new(s(0));
+        g.step(true, s(3));
+        assert!(!g.step(false, s(6)));
+        assert!(!g.step(true, s(12)));
+        assert!(!g.step(false, s(15)));
+        assert!(!g.step(false, s(24)));
+        assert!(g.step(false, s(25)));
+    }
+
+    #[test]
+    fn never_seen_it_stays() {
+        let mut g = WithGame::new(s(0));
+        for t in (0..300).step_by(3) {
+            assert!(!g.step(false, s(t)));
+        }
+        assert!(!g.waiting(s(61)));
+        assert!(g.waiting(s(59)));
+    }
+
+    #[test]
+    fn the_autostart_entry() {
+        let entry = autostart_entry("/usr/bin/a2tools-game-watch");
+        assert!(entry.starts_with("[Desktop Entry]\n"));
+        assert!(entry.contains("\nExec=\"/usr/bin/a2tools-game-watch\"\n"));
+        assert!(entry.contains("\nType=Application\n"));
+    }
+}
diff --git a/src-tauri/src/platform/linux/game_launch.rs b/src-tauri/src/platform/linux/game_launch.rs
new file mode 100644
index 0000000..606a2c5
--- /dev/null
+++ b/src-tauri/src/platform/linux/game_launch.rs
@@ -0,0 +1,60 @@
+//! Starting the meter with the game (see `platform::game_watch`): the
+//! watcher's autostart entry, and the watcher started at once.
+
+use crate::platform::game_watch::{autostart_entry, autostart_path, WATCHER_NAME};
+use std::os::unix::process::CommandExt;
+
+/// Turn the watcher on (autostart entry, and running now) or off (entry
+/// removed: the watcher sees it gone and stops by itself).
+pub fn set_autostart(on: bool) {
+    let Some(entry) = autostart_path() else {
+        tracing::warn!("Start with AION2: no home folder to put the autostart entry in");
+        return;
+    };
+    if !on {
+        match std::fs::remove_file(&entry) {
+            Ok(()) => tracing::info!("Start with AION2: off, autostart entry removed"),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => tracing::warn!("Start with AION2: {} not removed: {error}", entry.display()),
+        }
+        return;
+    }
+    let Some(watcher) = std::env::current_exe()
+        .ok()
+        .and_then(|exe| Some(exe.parent()?.join(WATCHER_NAME)))
+        .filter(|path| path.is_file())
+    else {
+        tracing::info!("Start with AION2: no {WATCHER_NAME} next to the meter (a build without it)");
+        return;
+    };
+    let text = autostart_entry(&watcher.to_string_lossy());
+    if std::fs::read_to_string(&entry).ok().as_deref() != Some(text.as_str()) {
+        let written = entry
+            .parent()
+            .map_or(Ok(()), std::fs::create_dir_all)
+            .and_then(|()| std::fs::write(&entry, &text));
+        match written {
+            Ok(()) => tracing::info!("Start with AION2: on, autostart entry {}", entry.display()),
+            Err(error) => {
+                tracing::warn!("Start with AION2: {} not written: {error}", entry.display());
+                return;
+            }
+        }
+    }
+    // Running now too, not only from the next login. A second one stops at
+    // once (it holds a lock), so starting it each time is harmless.
+    let spawned = std::process::Command::new(&watcher)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .process_group(0)
+        .spawn();
+    match spawned {
+        Ok(mut child) => {
+            std::thread::spawn(move || {
+                let _ = child.wait();
+            });
+        }
+        Err(error) => tracing::warn!("Start with AION2: {} not started: {error}", watcher.display()),
+    }
+}
