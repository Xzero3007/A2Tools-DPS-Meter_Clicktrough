diff --git a/src-tauri/tools/a2t_game_watch.rs b/src-tauri/tools/a2t_game_watch.rs
new file mode 100644
index 0000000..c2213d6
--- /dev/null
+++ b/src-tauri/tools/a2t_game_watch.rs
@@ -0,0 +1,108 @@
+//! Clicktrough: `a2tools-game-watch`, the meter started with AION2.
+//!
+//! Runs from the desktop's autostart while Settings' "Start and close with
+//! AION2" is on (the meter writes and removes the entry). Every 3 s it looks
+//! through `/proc` for the game; when the game starts and no meter runs, it
+//! starts one with `--with-game`, and that meter closes once the game is gone.
+//! It opens no window, sends nothing, and stops when the entry is removed.
+//! One runs at a time (a lock in the runtime folder).
+//!
+//! Only plain std: the decisions and the game's name come from the meter's
+//! own files, included here.
+
+#[allow(dead_code)]
+#[path = "../src/platform/game_watch.rs"]
+mod game_watch;
+#[allow(dead_code)]
+#[path = "../src/platform/procfs.rs"]
+mod procfs;
+
+use game_watch::{autostart_path, is_meter_comm, Watcher, METER_NAME, POLL, WITH_GAME_ARG};
+use std::path::{Path, PathBuf};
+
+fn main() {
+    let Some(entry) = autostart_path() else { return };
+    // One watcher: the lock holds while this process lives.
+    let lock_dir = std::env::var_os("XDG_RUNTIME_DIR")
+        .filter(|dir| !dir.is_empty())
+        .map(PathBuf::from)
+        .unwrap_or_else(std::env::temp_dir);
+    let Ok(lock) = std::fs::OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .write(true)
+        .open(lock_dir.join("a2tools-game-watch.lock"))
+    else {
+        return;
+    };
+    if lock.try_lock().is_err() {
+        return;
+    }
+    let meter = std::env::current_exe()
+        .ok()
+        .and_then(|exe| Some(exe.parent()?.join(METER_NAME)))
+        .filter(|path| path.is_file())
+        .unwrap_or_else(|| PathBuf::from(METER_NAME));
+    let mut watcher = Watcher::default();
+    loop {
+        // Turned off in Settings (or the entry deleted): stop.
+        if !entry.exists() {
+            return;
+        }
+        let (game, meter_runs) = look();
+        if watcher.step(game, meter_runs) {
+            start(&meter);
+        }
+        std::thread::sleep(POLL);
+    }
+}
+
+/// Whether the game runs, and whether a meter does.
+fn look() -> (bool, bool) {
+    let (mut game, mut meter) = (false, false);
+    let Ok(entries) = std::fs::read_dir("/proc") else { return (false, false) };
+    for entry in entries.flatten() {
+        let dir = entry.path();
+        let is_pid = dir
+            .file_name()
+            .and_then(|n| n.to_str())
+            .is_some_and(|n| n.bytes().all(|b| b.is_ascii_digit()));
+        if !is_pid {
+            continue;
+        }
+        let comm = std::fs::read_to_string(dir.join("comm")).unwrap_or_default();
+        if is_meter_comm(&comm) {
+            meter = true;
+        } else if !game && is_game(&dir, &comm) {
+            game = true;
+        }
+        if game && meter {
+            break;
+        }
+    }
+    (game, meter)
+}
+
+/// As the meter finds it (platform/linux/window_detector.rs).
+fn is_game(dir: &Path, comm: &str) -> bool {
+    let cmdline = std::fs::read(dir.join("cmdline")).unwrap_or_default();
+    procfs::is_aion2_process(comm, &cmdline)
+}
+
+/// Start the meter, on its own: it outlives this watcher's checks.
+fn start(meter: &Path) {
+    use std::os::unix::process::CommandExt;
+    let spawned = std::process::Command::new(meter)
+        .arg(WITH_GAME_ARG)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .process_group(0)
+        .spawn();
+    if let Ok(mut child) = spawned {
+        // Reaped when it ends, so it leaves no zombie behind.
+        std::thread::spawn(move || {
+            let _ = child.wait();
+        });
+    }
+}
