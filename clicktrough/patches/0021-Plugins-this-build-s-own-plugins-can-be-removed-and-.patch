+/// Clicktrough: the ids of this build's plugins the player removed.
+fn bundled_removed(app: &tauri::AppHandle) -> Vec<String> {
+    listed(app, BUNDLED_REMOVED_KEY)
+}
+
+fn set_bundled_removed(app: &tauri::AppHandle, id: &str, removed: bool) {
+    let Some(state) = app.try_state::<AppState>() else { return };
+    let mut ids = bundled_removed(app);
+    ids.retain(|x| x != id);
+    if removed {
+        ids.push(id.to_string());
+    }
+    state.settings.set(BUNDLED_REMOVED_KEY, &serde_json::to_string(&ids).unwrap_or_default());
+}
+
+/// This build's copy of a plugin (data/ct-plugins/<id>), if it has one.
+fn bundled_dir(app: &tauri::AppHandle, id: &str) -> Option<PathBuf> {
+    let state = app.try_state::<AppState>()?;
+    let dir = state.i18n_data_dir.as_ref()?.join("ct-plugins").join(id);
+    (valid_id(id) && dir.join("manifest.json").is_file()).then_some(dir)
+}
+
+/// The original's plugins this build ships to run only where installed
+/// (data/ct-plugins/installed-only.txt).
+fn installed_only(app: &tauri::AppHandle) -> Vec<String> {
+    app.try_state::<AppState>()
+        .and_then(|s| s.i18n_data_dir.as_ref().map(|d| d.join("ct-plugins").join("installed-only.txt")))
+        .and_then(|f| std::fs::read_to_string(f).ok())
+        .map(|text| text.lines().map(str::trim).filter(|l| !l.is_empty()).map(String::from).collect())
+        .unwrap_or_default()
+}
+
+/// Clicktrough: one of this build's plugins removed in Settings, added again.
+#[tauri::command]
+pub fn plugin_restore_bundled(app: tauri::AppHandle, id: String) -> Result<PluginsView, String> {
+    if bundled_dir(&app, &id).is_none() {
+        return Err("this build has no such plugin".into());
+    }
+    set_bundled_removed(&app, &id, false);
+    let host = host(&app)?;
+    host.reload(&app);
+    refresh_windows(&app, &host);
+    restore_windows(&app);
+    dock::sync(&app, None);
+    Ok(view(&app, &host))
+}
+
+/// The removed ones as Settings lists them (each with its manifest's words).
+fn removed_bundled_info(app: &tauri::AppHandle) -> Vec<PluginInfo> {
+    bundled_removed(app)
+        .iter()
+        .filter_map(|id| load_folder(&bundled_dir(app, id)?).ok())
+        .map(|l| PluginInfo { reviewed: true, bundled: true, ..info(&l) })
+        .collect()
+}
