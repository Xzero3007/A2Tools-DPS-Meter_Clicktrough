+    fn the_docks_own_lock_is_read_back() {
+        assert_eq!(super::dock_lock_from(Some("locked")), 1);
+        assert_eq!(super::dock_lock_from(Some("free")), 2);
+        assert_eq!(super::dock_lock_from(None), 0);
+        assert_eq!(super::dock_lock_from(Some("junk")), 0);
+    }
+
     #[test]
     fn updates_come_only_from_the_cdn() {
         use super::{update_url_allowed as ok, version_shaped};
