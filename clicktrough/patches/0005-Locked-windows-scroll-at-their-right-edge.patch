     ].map(([edge, cur]) => `html.toolEdge-${edge}, html.toolEdge-${edge} * { cursor: ${cur}-resize !important; }`).join("\n");
     document.head.appendChild(style);
 
+    // Locked with the overlay ("Lock all meter windows"), the window is not
+    // resized from its edges: its right edge is the strip that scrolls it
