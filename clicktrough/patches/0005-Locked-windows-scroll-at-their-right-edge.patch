-fn apply_input_region(gtk_window: &gtk::ApplicationWindow, ignore: bool, keep: Option<Keep>) {
+/// How wide the strip at a locked window's right edge is that still takes
+/// the mouse (`set_scroll_edge`): where its scrollbar is, so the wheel there
+/// scrolls it. Locked, the page offers no resize at that edge
+/// (`meter-windows-locked`), so all of it scrolls.
+pub const SCROLL_EDGE_PX: i32 = 24;
+
+/// The windows that keep their scroll edge while they let clicks through.
+fn scroll_edges() -> &'static std::sync::Mutex<std::collections::HashSet<String>> {
+    static EDGES: std::sync::OnceLock<std::sync::Mutex<std::collections::HashSet<String>>> = std::sync::OnceLock::new();
+    EDGES.get_or_init(Default::default)
+}
+
+/// Whether a window, while it lets clicks through, still takes the mouse in
+/// a strip at its right edge, so it can be scrolled there. Applies with the
+/// next `click_through_except`.
+pub fn set_scroll_edge(window: &tauri::WebviewWindow, on: bool) {
+    let mut edges = scroll_edges().lock().unwrap_or_else(|p| p.into_inner());
+    if on {
+        edges.insert(window.label().to_string());
+    } else {
+        edges.remove(window.label());
+    }
+}
+
+/// The scroll edge follows the window's right edge as it is resized: its
+/// region is set again at each new size. Once per GTK window (a window
+/// closed and opened again under its label is a new one).
+fn follow_size(gtk_window: &gtk::ApplicationWindow, label: &str) {
+    use gtk::prelude::*;
+    const KEY: &str = "a2t-scroll-edge";
+    // SAFETY: the key is only ever set to a bool, here.
+    if unsafe { gtk_window.data::<bool>(KEY) }.is_some() {
+        return;
+    }
+    unsafe { gtk_window.set_data(KEY, true) };
+    let label = label.to_string();
+    let last = std::cell::Cell::new((0, 0));
+    gtk_window.connect_size_allocate(move |w, a| {
+        if last.replace((a.width(), a.height())) == (a.width(), a.height()) {
+            return;
+        }
+        let Some((true, keep)) = wanted_regions().lock().unwrap_or_else(|p| p.into_inner()).get(&label).cloned() else {
+            return;
+        };
+        if !scroll_edges().lock().unwrap_or_else(|p| p.into_inner()).contains(&label)
+            || hidden_in_place().lock().unwrap_or_else(|p| p.into_inner()).contains(&label)
+        {
+            return;
+        }
+        apply_input_region(w, true, keep, true);
+    });
+}
+
+fn apply_input_region(gtk_window: &gtk::ApplicationWindow, ignore: bool, keep: Option<Keep>, edge: bool) {
     use gtk::{cairo, prelude::*};
     if ignore {
         let region = cairo::Region::create();
@@ -240,6 +297,15 @@ fn apply_input_region(gtk_window: &gtk::ApplicationWindow, ignore: bool, keep: O
                 }
             }
         }
+        // The strip at the right edge of the page (the window's child).
+        let strip = edge.then(|| gtk_window.child()).flatten().and_then(|child| {
+            let a = child.allocation();
+            let w = SCROLL_EDGE_PX.min(a.width());
+            (w > 0 && a.height() > 0).then(|| cairo::RectangleInt::new(a.x() + a.width() - w, a.y(), w, a.height()))
+        });
+        if let Some(r) = strip {
+            let _ = region.union_rectangle(&r);
+        }
         if region.is_empty() {
             let _ = region.union_rectangle(&cairo::RectangleInt::new(0, 0, 1, 1));
         }
@@ -362,7 +428,7 @@ pub fn hide_in_place(window: &tauri::WebviewWindow) {
     let target = window.clone();
     super::dialog::on_gtk_thread(move || {
         if let Ok(gtk_window) = target.gtk_window() {
-            apply_input_region(&gtk_window, true, None);
+            apply_input_region(&gtk_window, true, None, false);
         }
     });
     let _ = window.set_skip_taskbar(true);
