       let edge = "";
       if (e.clientY < EDGE) edge += "n";
       else if (e.clientY >= window.innerHeight - EDGE) edge += "s";
@@ -1477,6 +1482,12 @@
       shownEdge = edge;
     };
 
+    invoke("meter_windows_locked").then((locked) => { windowsLocked = locked === true; }).catch(() => {});
+    listen("meter-windows-locked", (event) => {
+      windowsLocked = event?.payload === true;
+      if (windowsLocked) showEdge("");
+    });
+
     const DIRECTION = {
       n: "North", s: "South", e: "East", w: "West",
       ne: "NorthEast", nw: "NorthWest", se: "SouthEast", sw: "SouthWest",
@@ -1572,5 +1583,31 @@
     }
   }).catch((e) => console.error("[A2Tools] debug_status failed:", e));
 
+  // Locked, Details and Battle History still take the mouse at their right
+  // edge only (dpsMeter.lockScrollEdge, platform/linux/window.rs), where the
+  // page's own scrollbar is. A wheel there that nothing under the pointer
+  // would scroll scrolls what is under the middle of the window at that
+  // height: a panel that scrolls inside the page, not the page.
+  if (window.A2_VIEW !== "main") {
+    const scrolls = (el, down) => {
+      for (; el && el !== document.body && el !== document.documentElement; el = el.parentElement) {
+        const style = getComputedStyle(el);
+        if (!/(auto|scroll)/.test(style.overflowY) || el.scrollHeight <= el.clientHeight) continue;
+        if (down ? el.scrollTop + el.clientHeight < el.scrollHeight - 1 : el.scrollTop > 0) return el;
+      }
+      return null;
+    };
+    document.addEventListener("wheel", (e) => {
+      if (e.defaultPrevented || !e.deltaY || e.clientX < window.innerWidth - 48) return;
+      const down = e.deltaY > 0;
+      if (scrolls(e.target, down)) return;
+      const target = scrolls(document.elementFromPoint(window.innerWidth / 2, e.clientY), down);
+      if (!target) return;
+      const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? target.clientHeight : 1;
+      target.scrollBy({ top: e.deltaY * unit });
+      e.preventDefault();
+    }, { passive: false });
+  }
+
   console.log("[A2Tools] Tauri bridge adapter loaded (javaBridge + dpsData)");
 })();
