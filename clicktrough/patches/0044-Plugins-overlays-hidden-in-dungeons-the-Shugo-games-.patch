diff --git a/src-tauri/src/plugins/zones.rs b/src-tauri/src/plugins/zones.rs
new file mode 100644
index 0000000..01f1a8a
--- /dev/null
+++ b/src-tauri/src/plugins/zones.rs
@@ -0,0 +1,250 @@
+//! Clicktrough: plugin overlays (the Map's overlay, the Inventory's limits:
+//! `ui.overlay`, overlays.rs) hidden where the player has no use for them,
+//! by the kind of zone the game says he is in: dungeons, the Shugo
+//! festival's games and the Incursions, arenas. Leaving such a zone brings
+//! them back as they were. Read from the game's zone frame (`21 36`, as
+//! world.rs reads it), which comes with every loading screen; nothing is
+//! sent.
+//!
+//! Per plugin, in Settings → Plugins (an overlay's plugin only); every
+//! overlay hides in all three until the player turns one off. In such a
+//! zone, the overlay's header button shows it anyway, until the next zone.
+
+use std::collections::HashSet;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+use tauri::Manager;
+
+use crate::app::AppState;
+
+/// The kinds of zone an overlay can hide in.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    /// Dungeons and other instances (the Nightmare Altar's, the Abyss
+    /// Corridor's ...).
+    Dungeon,
+    /// The Shugo festival's games (Jump Jump, Defend Shugo Merchants ...) and
+    /// the Incursion of the Spirits.
+    Games,
+    /// The arenas.
+    Arena,
+}
+
+impl Kind {
+    pub const ALL: [Kind; 3] = [Kind::Dungeon, Kind::Games, Kind::Arena];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Kind::Dungeon => "dungeon",
+            Kind::Games => "games",
+            Kind::Arena => "arena",
+        }
+    }
+
+    pub fn from_name(name: &str) -> Option<Kind> {
+        Kind::ALL.into_iter().find(|k| k.name() == name)
+    }
+
+    /// The setting: the plugins whose overlay doesn't hide in this kind of
+    /// zone (every overlay hides until the player turns it off).
+    fn key(self) -> &'static str {
+        match self {
+            Kind::Dungeon => "ct.overlayShownInDungeons",
+            Kind::Games => "ct.overlayShownInGames",
+            Kind::Arena => "ct.overlayShownInArenas",
+        }
+    }
+}
+
+/// What kind of zone a zone id is, by the game's numbering (the zone names
+/// the Map's data has). The open world, its towns, airships, the Abyss and
+/// the small quest scenes are none of them.
+pub fn kind(zone: u32) -> Option<Kind> {
+    match zone {
+        // Fire Temple Arena, Impetusium Arena, Odyle Shard Cradle,
+        // Stormslumber Snowfield, Sandstorm Temple (two numbers each).
+        7 | 8 | 10 | 12 | 14 | 60..=64 => Some(Kind::Arena),
+        // The Incursion of the Spirits, the Shugo festival's protection.
+        76..=78 => Some(Kind::Games),
+        // The Abyss Corridor sits among the games' numbers.
+        503_000..=504_999 => Some(Kind::Dungeon),
+        // Beritra Air Raid, Jump Jump, Hidden Lugi, Nyerk Shooter, Incursion
+        // of the Spirits, Defend Shugo Merchants ...
+        500_000..=519_999 => Some(Kind::Games),
+        // Dream and illusion instances, quest dungeons, caves.
+        200_000..=499_999 => Some(Kind::Dungeon),
+        // The dungeons (Fire Temple, Draupnir, Deus Research Base ...).
+        600_000..=699_999 => Some(Kind::Dungeon),
+        // Daeva Bio-Research Base, Nightmare Altar, Tyrant's Hideout ...
+        900_000..=999_999 => Some(Kind::Dungeon),
+        _ => None,
+    }
+}
+
+/// The zone the game last said, 0 before it said one.
+static ZONE: AtomicU32 = AtomicU32::new(0);
+
+/// The overlays hidden for the zone, by window label.
+fn held() -> &'static Mutex<HashSet<String>> {
+    static HELD: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
+    HELD.get_or_init(Mutex::default)
+}
+
+/// The overlays the player showed anyway in this zone (their header
+/// button), by window label; forgotten at the next zone.
+fn shown_anyway() -> &'static Mutex<HashSet<String>> {
+    static SHOWN: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
+    SHOWN.get_or_init(Mutex::default)
+}
+
+fn lock<T>(m: &'static Mutex<T>) -> std::sync::MutexGuard<'static, T> {
+    m.lock().unwrap_or_else(|p| p.into_inner())
+}
+
+/// The plugins whose overlay stays in zones of `kind`.
+fn shown_in(app: &tauri::AppHandle, kind: Kind) -> Vec<String> {
+    app.try_state::<AppState>()
+        .and_then(|s| s.settings.get(kind.key()))
+        .and_then(|s| serde_json::from_str(&s).ok())
+        .unwrap_or_default()
+}
+
+/// Whether plugin `id`'s overlay hides in zones of `kind`.
+pub fn hides_in(app: &tauri::AppHandle, id: &str, kind: Kind) -> bool {
+    !shown_in(app, kind).iter().any(|x| x == id)
+}
+
+/// For Settings: per kind, the plugins whose overlay hides there.
+pub fn view(app: &tauri::AppHandle, ids: &[String]) -> serde_json::Value {
+    let mut out = serde_json::Map::new();
+    for kind in Kind::ALL {
+        let list: Vec<&String> = ids.iter().filter(|id| hides_in(app, id, kind)).collect();
+        out.insert(kind.name().to_string(), serde_json::json!(list));
+    }
+    serde_json::Value::Object(out)
+}
+
+/// Settings: plugin `id`'s overlay hides in zones of `kind`, or not.
+pub fn set_hides_in(app: &tauri::AppHandle, id: &str, kind: Kind, hide: bool) {
+    let Some(state) = app.try_state::<AppState>() else { return };
+    let mut ids = shown_in(app, kind);
+    ids.retain(|x| x != id);
+    if !hide {
+        ids.push(id.to_string());
+    }
+    state.settings.set(kind.key(), &serde_json::to_string(&ids).unwrap_or_default());
+    sync(app);
+}
+
+/// Whether the zone now hides overlay `label` (an overlay's window label),
+/// unless the player showed it anyway.
+pub fn hides(app: &tauri::AppHandle, label: &str) -> bool {
+    hides_ignoring_button(app, label) && !lock(shown_anyway()).contains(label)
+}
+
+/// Whether the zone's kind hides overlay `label`, whatever its button did.
+fn hides_ignoring_button(app: &tauri::AppHandle, label: &str) -> bool {
+    let Some(kind) = kind(ZONE.load(Ordering::Relaxed)) else { return false };
+    let Some((id, _)) = super::widgets::parse_label(label) else { return false };
+    super::overlays::is_overlay(app, label) && hides_in(app, &id, kind)
+}
+
+/// Whether overlay `label` is hidden for the zone now.
+pub fn holds(label: &str) -> bool {
+    lock(held()).contains(label)
+}
+
+/// Hide overlay `window` for the zone (its plugin keeps it open).
+pub fn hold(window: &tauri::WebviewWindow) {
+    if window.is_visible().unwrap_or(false) && !crate::platform::window::is_hidden_in_place(window) {
+        crate::platform::window::hide_in_place(window);
+    }
+    lock(held()).insert(window.label().to_string());
+}
+
+/// The game's zone frame (`21 36`): counter u32 | zone id u32 | ...
+pub fn saw_frame(app: &tauri::AppHandle, body: &[u8]) {
+    let Some(zone) = body.get(4..8).map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]])) else { return };
+    if zone == 0 || ZONE.swap(zone, Ordering::Relaxed) == zone {
+        return;
+    }
+    tracing::debug!("Plugins: zone {zone} ({:?}): the overlays as it says", kind(zone));
+    lock(shown_anyway()).clear();
+    let app = app.clone();
+    let main = app.clone();
+    let _ = main.run_on_main_thread(move || sync(&app));
+}
+
+/// The header button of overlay `label`, in a zone that hides it: shown
+/// anyway, or hidden again. False when the zone doesn't hide it (the button
+/// does as it always does then).
+pub fn button(app: &tauri::AppHandle, label: &str) -> bool {
+    if !hides_ignoring_button(app, label) {
+        return false;
+    }
+    let anyway = lock(shown_anyway()).contains(label);
+    if anyway {
+        // Shown anyway and open: hidden again for the zone; closed by its
+        // plugin meanwhile: the button opens it as always.
+        if super::widgets::is_closed(label) || app.get_webview_window(label).is_none() {
+            return false;
+        }
+        lock(shown_anyway()).remove(label);
+    } else {
+        lock(shown_anyway()).insert(label.to_string());
+        // Closed by its plugin: the button opens it as always.
+        if !holds(label) {
+            return false;
+        }
+    }
+    sync(app);
+    true
+}
+
+/// Hide the overlays the zone hides, or show again the ones it hid: on a
+/// new zone, a setting changed, a header button.
+pub fn sync(app: &tauri::AppHandle) {
+    for (label, window) in app.webview_windows() {
+        if super::widgets::parse_label(&label).is_none() {
+            continue;
+        }
+        if hides(app, &label) {
+            if !super::widgets::is_closed(&label) {
+                hold(&window);
+            }
+        } else if lock(held()).remove(&label) {
+            super::reveal_if_free(app, &window);
+        }
+    }
+    super::overlays::notify(app);
+}
