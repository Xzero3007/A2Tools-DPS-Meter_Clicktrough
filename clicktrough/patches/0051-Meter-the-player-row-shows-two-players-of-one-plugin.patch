@@ -82,6 +82,32 @@
       return box;
     };
 
+    // The quality as a button, not a <select>: its list is the desktop's
+    // menu, drawn in the desktop's colours. A click steps to the next one
+    // (right-click: back); it changes a moment after the last click, since
+    // each change starts the video again.
+    const QUALITY_NAMES = { audio: "Sound" };
+    const quality = (key, value, list) => {
+      const qs = Array.isArray(list) && list.length ? list : ["1080"];
+      let at = Math.max(0, qs.indexOf(value));
+      let timer = 0;
+      const b = el("button", "mediaQuality");
+      b.type = "button";
+      b.title = "Quality: click for the next, right-click for the one before (it starts again)";
+      b.setAttribute("aria-label", "Quality");
+      const show = () => { b.textContent = QUALITY_NAMES[qs[at]] || `${qs[at]}p`; };
+      const step = (by) => {
+        at = (at + by + qs.length) % qs.length;
+        show();
+        clearTimeout(timer);
+        timer = setTimeout(() => send(key, "quality", qs[at]), 900);
+      };
+      b.addEventListener("click", (event) => { event.stopPropagation(); step(1); });
+      b.addEventListener("contextmenu", (event) => { event.preventDefault(); event.stopPropagation(); step(-1); });
+      show();
+      return b;
+    };
+
     const render = () => {
       const playing = list.filter((p) => p && p.state);
       row.hidden = !playing.length;
@@ -90,26 +116,27 @@
         shownKey = "";
         return;
       }
-      if (!playing.some((p) => p.id === picked)) picked = playing[0].id;
-      const cur = playing.find((p) => p.id === picked);
+      if (!playing.some((p) => p.key === picked)) picked = playing[0].key;
+      const cur = playing.find((p) => p.key === picked);
       const s = cur.state;
       title.textContent = s.title || cur.name;
       sub.textContent = s.sub || "";
       now.title = [s.title, s.sub].filter(Boolean).join(" · ");
       // Rebuilt only when what is shown changes; a slider being dragged keeps its place.
-      const key = JSON.stringify([playing.map((p) => [p.id, p.state.icon, p.name]), picked, s.controls, s.paused, s.muted, s.playing, s.favourite]);
+      const key = JSON.stringify([playing.map((p) => [p.key, p.state.icon, p.name]), picked, s.controls, s.paused, s.muted, s.playing, s.favourite, s.quality]);
       if (key !== shownKey) {
         shownKey = key;
         tabs.replaceChildren(...playing.map((p) => {
           const b = el("button", "mediaTab");
           b.type = "button";
-          b.title = p.name;
-          b.setAttribute("aria-label", p.name);
-          b.setAttribute("aria-pressed", String(p.id === picked));
+          const name = p.state.sub ? `${p.name}: ${p.state.title || p.state.sub}` : p.name;
+          b.title = name;
+          b.setAttribute("aria-label", name);
+          b.setAttribute("aria-pressed", String(p.key === picked));
           b.append(icon(p.state.icon || "music"));
           b.addEventListener("click", (event) => {
             event.stopPropagation();
-            picked = p.id;
+            picked = p.key;
             try { localStorage.setItem(PICK_KEY, picked); } catch {}
             render();
           });
@@ -117,13 +144,14 @@
         }));
         const parts = [];
         for (const c of s.controls || []) {
-          if (c === "volume") parts.push(slider(cur.id, c, s.volume, 0, null));
-          else if (c === "opacity") parts.push(slider(cur.id, c, s.opacity, 20, "contrast"));
-          else if (c === "pause") parts.push(button(cur.id, c, s.paused ? "play" : "pause", NAMES[c], s.paused));
-          else if (c === "playStop") parts.push(button(cur.id, c, s.playing ? "square" : "play", NAMES[c], s.playing));
-          else if (c === "mute") parts.push(button(cur.id, c, s.muted ? "volume-x" : "volume-2", NAMES[c], s.muted));
-          else if (c === "favourite") parts.push(button(cur.id, c, "star", NAMES[c], s.favourite));
-          else parts.push(button(cur.id, c, ICONS[c] || "circle", NAMES[c] || c));
+          if (c === "volume") parts.push(slider(cur.key, c, s.volume, 0, null));
+          else if (c === "opacity") parts.push(slider(cur.key, c, s.opacity, 20, "contrast"));
+          else if (c === "quality") parts.push(quality(cur.key, s.quality, cur.qualities));
+          else if (c === "pause") parts.push(button(cur.key, c, s.paused ? "play" : "pause", NAMES[c], s.paused));
+          else if (c === "playStop") parts.push(button(cur.key, c, s.playing ? "square" : "play", NAMES[c], s.playing));
+          else if (c === "mute") parts.push(button(cur.key, c, s.muted ? "volume-x" : "volume-2", NAMES[c], s.muted));
+          else if (c === "favourite") parts.push(button(cur.key, c, "star", NAMES[c], s.favourite));
+          else parts.push(button(cur.key, c, ICONS[c] || "circle", NAMES[c] || c));
         }
         ctl.replaceChildren(...parts);
         try { window.lucide?.createIcons?.({ root: row }); } catch {}
