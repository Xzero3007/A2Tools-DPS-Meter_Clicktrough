@@ -5,11 +5,16 @@
 //! plugin, and the chosen one's controls. A control sends the plugin an
 //! event `media` (`{ action, value }`), which it handles as its own buttons.
 //!
+//! A plugin playing two things at once (the Streams plugin's Twitch and
+//! YouTube) gives each a slot of its own (`a2.media.set(state, "youtube")`):
+//! each is a button in the row, and its controls' events carry the slot.
+//!
 //! The state a plugin gives, every field optional:
 //!
 //! ```json
 //! { "icon": "tv", "title": "Stoopzz", "sub": "Twitch", "paused": false,
-//!   "muted": false, "volume": 0.7, "opacity": 1, "controls": ["pause", "mute", "volume", "opacity", "stop"] }
+//!   "muted": false, "volume": 0.7, "opacity": 1, "quality": "720",
+//!   "controls": ["pause", "mute", "volume", "opacity", "quality", "stop"] }
 //! ```
 //!
 //! `null` takes it away (nothing plays). Only the controls listed here exist.
@@ -21,7 +26,20 @@ use serde_json::{json, Value};
 use tauri::Emitter;
 
 /// The controls a plugin may show in the row.
-const CONTROLS: &[&str] = &["prev", "playStop", "pause", "next", "mute", "volume", "opacity", "favourite", "stop"];
+const CONTROLS: &[&str] = &["prev", "playStop", "pause", "next", "mute", "volume", "opacity", "quality", "favourite", "stop"];
+
+/// The qualities the row offers (the Streams plugin's).
+const QUALITIES: &[&str] = &["1080", "720", "480", "360", "audio"];
+
+/// A slot's name: short, lower case.
+fn slot_ok(s: &str) -> bool {
+    s.len() <= 16 && s.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-')
+}
+
+/// The row's key of a plugin's slot: "<id>" or "<id>/<slot>".
+fn key(id: &str, slot: &str) -> String {
+    if slot.is_empty() { id.to_string() } else { format!("{id}/{slot}") }
+}
 
 fn states() -> &'static Mutex<BTreeMap<String, Value>> {
     static S: std::sync::OnceLock<Mutex<BTreeMap<String, Value>>> = std::sync::OnceLock::new();
@@ -59,6 +77,7 @@ fn clean(state: &Value) -> Option<Value> {
         "favourite": s.get("favourite").and_then(Value::as_bool).unwrap_or(false),
         "volume": unit(s.get("volume"), 0.0),
         "opacity": unit(s.get("opacity"), 0.2),
+        "quality": s.get("quality").and_then(Value::as_str).filter(|q| QUALITIES.contains(q)),
         "controls": controls,
     }))
 }
@@ -69,10 +88,15 @@ fn listed(app: &tauri::AppHandle) -> Value {
         .unwrap_or_default();
     let order = super::order(app);
     let mut list: Vec<(String, Value)> = states().lock().unwrap_or_else(|p| p.into_inner()).iter().map(|(k, v)| (k.clone(), v.clone())).collect();
-    list.sort_by_key(|(id, _)| order.iter().position(|o| o == id).unwrap_or(usize::MAX));
+    let plugin = |k: &str| k.split('/').next().unwrap_or("").to_string();
+    list.sort_by_key(|(k, _)| (order.iter().position(|o| *o == plugin(k)).unwrap_or(usize::MAX), k.clone()));
     Value::Array(
         list.into_iter()
-            .map(|(id, state)| json!({ "id": id, "name": names.get(&id).cloned().unwrap_or_else(|| id.clone()), "state": state }))
+            .map(|(k, state)| {
+                let id = plugin(&k);
+                let slot = k.split_once('/').map(|(_, s)| s.to_string()).unwrap_or_default();
+                json!({ "key": k, "id": id, "slot": slot, "name": names.get(&id).cloned().unwrap_or_else(|| id.clone()), "state": state, "qualities": QUALITIES })
+            })
             .collect(),
     )
 }
@@ -83,17 +107,28 @@ fn notify(app: &tauri::AppHandle) {
 
 /// A plugin turned off or gone: its entry leaves the row.
 pub fn forget(app: &tauri::AppHandle, id: &str) {
-    let gone = states().lock().unwrap_or_else(|p| p.into_inner()).remove(id).is_some();
+    let gone = {
+        let mut all = states().lock().unwrap_or_else(|p| p.into_inner());
+        let before = all.len();
+        all.retain(|k, _| k != id && !k.starts_with(&format!("{id}/")));
+        all.len() != before
+    };
     if gone {
         notify(app);
     }
 }
 
-/// `a2.media.set(state)`: what the plugin plays now, or null for nothing.
+/// `a2.media.set(state, slot)`: what the plugin plays now (in that slot),
+/// or null for nothing.
 #[tauri::command]
-pub fn plugin_media_set(app: tauri::AppHandle, window: tauri::WebviewWindow, plugin: Option<String>, state: Option<Value>) -> Result<(), String> {
+pub fn plugin_media_set(app: tauri::AppHandle, window: tauri::WebviewWindow, plugin: Option<String>, state: Option<Value>, slot: Option<String>) -> Result<(), String> {
     let id = super::window_plugin(&window, plugin.as_deref())?;
     super::require(&app, &id, "media")?;
+    let slot = slot.unwrap_or_default();
+    if !slot_ok(&slot) {
+        return Err("a slot is up to 16 letters, digits or '-'".into());
+    }
+    let id = key(&id, &slot);
     let cleaned = state.as_ref().filter(|s| !s.is_null()).map(|s| clean(s).ok_or("not a player state")).transpose()?;
     {
         let mut all = states().lock().unwrap_or_else(|p| p.into_inner());
@@ -121,10 +156,11 @@ pub fn media_list(app: tauri::AppHandle) -> Value {
     listed(&app)
 }
 
-/// A control in the meter's row: the plugin hears `media` `{ action, value }`.
+/// A control in the meter's row (`key`: the entry's, "<id>" or
+/// "<id>/<slot>"): the plugin hears `media` `{ action, value, slot }`.
 #[tauri::command]
-pub fn media_control(app: tauri::AppHandle, id: String, action: String, value: Option<Value>) -> Result<(), String> {
-    if !states().lock().unwrap_or_else(|p| p.into_inner()).contains_key(&id) {
+pub fn media_control(app: tauri::AppHandle, key: String, action: String, value: Option<Value>) -> Result<(), String> {
+    if !states().lock().unwrap_or_else(|p| p.into_inner()).contains_key(&key) {
         return Err("nothing of that plugin plays".into());
     }
     if !CONTROLS.contains(&action.as_str()) {
@@ -133,9 +169,11 @@ pub fn media_control(app: tauri::AppHandle, id: String, action: String, value: O
     let value = match value {
         Some(Value::Number(n)) => n.as_f64().filter(|v| v.is_finite()).map(|v| json!(v.clamp(0.0, 1.0))).unwrap_or(Value::Null),
         Some(Value::Bool(b)) => Value::Bool(b),
+        Some(Value::String(q)) if action == "quality" && QUALITIES.contains(&q.as_str()) => Value::String(q),
         _ => Value::Null,
     };
-    super::emit_plugin(&app, &id, json!({ "plugin": id, "event": "media", "data": { "action": action, "value": value } }));
+    let (id, slot) = key.split_once('/').unwrap_or((key.as_str(), ""));
+    super::emit_plugin(&app, id, json!({ "plugin": id, "event": "media", "data": { "action": action, "value": value, "slot": slot } }));
     Ok(())
 }
 
@@ -159,6 +197,11 @@ mod tests {
         assert!(s.get("url").is_none());
         assert_eq!(clean(&json!({ "icon": "../x" })).unwrap()["icon"], "music");
         assert!(clean(&json!("text")).is_none());
+        assert_eq!(clean(&json!({ "quality": "720" })).unwrap()["quality"], "720");
+        assert_eq!(clean(&json!({ "quality": "4k" })).unwrap()["quality"], Value::Null);
+        assert!(slot_ok("youtube") && slot_ok("") && !slot_ok("a/b") && !slot_ok("Twitch"));
+        assert_eq!(key("streams", "youtube"), "streams/youtube");
+        assert_eq!(key("radio", ""), "radio");
         assert_eq!(clean(&json!({ "title": "x".repeat(500) })).unwrap()["title"].as_str().unwrap().len(), 120);
     }
 }
