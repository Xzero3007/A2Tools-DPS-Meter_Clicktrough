+/// Whether plugin `id`'s overlay asks to hide where `place` ("dungeon",
+/// "games", "arena", "shop"): its manifest's `ui.overlay.hideIn`.
+pub fn asks_to_hide(app: &tauri::AppHandle, id: &str, place: &str) -> bool {
+    let Ok(host) = super::host(app) else { return false };
+    host.with(id, |l| {
+        l.manifest.ui.as_ref()
+            .and_then(|u| u.get("overlay"))
+            .and_then(|o| o.get("hideIn"))
+            .and_then(Value::as_array)
+            .is_some_and(|a| a.iter().any(|v| v.as_str() == Some(place)))
+    })
+    .unwrap_or(false)
+}
+
