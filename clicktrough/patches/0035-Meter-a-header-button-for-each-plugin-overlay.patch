+/// Clicktrough: where the window manager last said window `label` was left
+/// (`window.<label>.placed`, KWin's report, app.rs `save_window_place`).
+fn reported_place(app: &tauri::AppHandle, label: &str) -> Option<(i32, i32)> {
+    let value = app.try_state::<AppState>()?.settings.get(&format!("window.{label}.placed"))?;
+    let n: Vec<i32> = value.split(',').filter_map(|v| v.trim().parse().ok()).collect();
+    match n[..] {
+        [x, y, ..] => Some((x, y)),
+        _ => None,
