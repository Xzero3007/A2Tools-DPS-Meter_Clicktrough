@@ -0,0 +1,94 @@
+// Clicktrough: the header's overlay buttons (overlayButtons.js): one per
+// plugin overlay, before the plugins button, gold while it shows, a click
+// asks plugin_overlay_toggle.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../public/src/js/overlayButtons.js", import.meta.url), "utf8");
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+function element(tag) {
+  const attrs = {};
+  const classes = new Set();
+  const el = {
+    tag, children: [], handlers: {}, dataset: {}, title: "", parentNode: null,
+    set className(v) { classes.clear(); for (const c of String(v).split(/\s+/).filter(Boolean)) classes.add(c); },
+    get className() { return [...classes].join(" "); },
+    classList: { toggle: (n, on) => (on ? classes.add(n) : classes.delete(n)), contains: (n) => classes.has(n) },
+    setAttribute: (k, v) => { attrs[k] = String(v); },
+    getAttribute: (k) => attrs[k],
+    addEventListener: (n, h) => { el.handlers[n] = h; },
+    append: (...kids) => { for (const k of kids) { k.parentNode = el; el.children.push(k); } },
+    remove: () => { const p = el.parentNode; if (p) p.children = p.children.filter((c) => c !== el); },
+    attrs, classes,
+  };
+  return el;
+}
+
+function setup(list, toggled) {
+  const calls = [];
+  const listeners = {};
+  const bar = element("div");
+  const plugins = element("div");
+  plugins.className = "headerBtn pluginsBtn";
+  bar.append(plugins);
+  bar.insertBefore = (node, ref) => {
+    node.parentNode = bar;
+    const i = ref ? bar.children.indexOf(ref) : bar.children.length;
+    bar.children.splice(i, 0, node);
+  };
+  bar.querySelectorAll = (s) => (s === ".overlayBtn" ? bar.children.filter((c) => c.classList.contains("overlayBtn")) : []);
+  bar.querySelector = (s) => {
+    const m = /data-plugin="([^"]+)"/.exec(s);
+    return m ? bar.children.find((c) => c.dataset.plugin === m[1]) || null : null;
+  };
+  const window = {
+    A2_VIEW: "main",
+    lucide: { createIcons: () => calls.push("icons") },
+    __TAURI__: {
+      core: { invoke: (command, args) => { calls.push([command, args]); return Promise.resolve(command === "plugin_overlay_toggle" ? toggled : list); } },
+      event: { listen: (name, handler) => { listeners[name] = handler; return Promise.resolve(); } },
+    },
+  };
+  const document = {
+    readyState: "complete",
+    querySelector: (s) => (s === ".headerBtns" ? bar : s === ".pluginsBtn" ? plugins : null),
+    createElement: element,
+  };
+  vm.runInContext(source, vm.createContext({ window, document, Promise, CSS: { escape: (s) => s }, requestAnimationFrame: (f) => f(), setTimeout: () => 0 }));
+  return { bar, plugins, calls, listeners };
+}
+
+const MAP = { id: "map", name: "Map", title: "Map overlay", icon: "map", on: false };
+const LIMITS = { id: "inventory", name: "Inventory", title: "Limits", icon: "gauge", on: true };
+
+test("a button per overlay, before the plugins button, gold while it shows", async () => {
+  const app = setup([MAP, LIMITS]);
+  await tick();
+  const btns = app.bar.children;
+  assert.deepEqual(btns.map((b) => b.dataset.plugin ?? "plugins"), ["map", "inventory", "plugins"]);
+  assert.equal(btns[0].classList.contains("isActive"), false);
+  assert.equal(btns[1].classList.contains("isActive"), true);
+  assert.equal(btns[1].children[0].attrs["data-lucide"], "gauge");
+  assert.ok(app.calls.includes("icons"));
+});
+
+test("a click asks the backend and follows its answer", async () => {
+  const app = setup([MAP], [{ ...MAP, on: true }]);
+  await tick();
+  let stopped = false;
+  app.bar.children[0].handlers.click({ stopPropagation: () => { stopped = true; } });
+  await tick();
+  assert.ok(stopped);
+  assert.ok(app.calls.some((c) => Array.isArray(c) && c[0] === "plugin_overlay_toggle" && c[1].id === "map"));
+  assert.equal(app.bar.children[0].classList.contains("isActive"), true);
+});
+
+test("follows overlays-changed: a plugin turned off loses its button", async () => {
+  const app = setup([MAP, LIMITS]);
+  await tick();
+  app.listeners["overlays-changed"]({ payload: [LIMITS] });
+  assert.deepEqual(app.bar.children.map((b) => b.dataset.plugin ?? "plugins"), ["inventory", "plugins"]);
+});
