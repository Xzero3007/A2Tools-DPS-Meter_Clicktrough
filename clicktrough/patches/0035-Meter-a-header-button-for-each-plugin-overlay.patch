+/// Clicktrough: the overlays a header button showed on their own while the
+/// plugins button has the plugins off (`overlays.rs`), by label.
+fn alone_set() -> &'static Mutex<std::collections::HashSet<String>> {
+    static ALONE: std::sync::OnceLock<Mutex<std::collections::HashSet<String>>> = std::sync::OnceLock::new();
+    ALONE.get_or_init(Mutex::default)
+}
+
+/// Whether widget `label` shows on its own (a header button) while the
+/// plugins are off.
+pub fn is_alone(label: &str) -> bool {
+    alone_set().lock().unwrap_or_else(|p| p.into_inner()).contains(label)
+}
+
+/// A header button shows widget `label`: with the plugins off it shows on
+/// its own, at once if its plugin has it open already.
+pub fn show_alone(app: &tauri::AppHandle, label: &str) {
+    if !plugins_hidden(app) {
+        return;
+    }
+    alone_set().lock().unwrap_or_else(|p| p.into_inner()).insert(label.to_string());
+    let was_held = held_by_button_set().lock().unwrap_or_else(|p| p.into_inner()).remove(label);
+    if !was_held || is_closed(label) {
+        return;
+    }
+    let Some(window) = app.get_webview_window(label) else { return };
+    let Some((id, _)) = parse_label(label) else { return };
+    if super::game_hides(app, &id) {
+        super::hold_for_game(&window);
+    } else {
+        if !crate::platform::window::reveal_in_place(&window) {
+            crate::platform::window::show_on_top_without_focus(&window);
+        }
+        relock(app, &window);
+    }
+}
+
+/// A header button hides widget `label` (its plugin closes it).
+pub fn forget_alone(label: &str) {
+    alone_set().lock().unwrap_or_else(|p| p.into_inner()).remove(label);
+}
+
