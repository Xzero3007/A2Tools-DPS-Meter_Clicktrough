diff --git a/src-tauri/src/plugins/overlays.rs b/src-tauri/src/plugins/overlays.rs
new file mode 100644
index 0000000..c346d96
--- /dev/null
+++ b/src-tauri/src/plugins/overlays.rs
@@ -0,0 +1,122 @@
+//! Clicktrough: a plugin's overlay on a button of its own in the meter's
+//! header (the Map's overlay, the Inventory's limits), shown or hidden
+//! without the plugin window. A plugin names it in its manifest:
+//!
+//! ```json
+//! "ui": { "overlay": { "widget": "overlay", "title": "Map overlay", "icon": "map" } }
+//! ```
+//!
+//! The button asks the plugin's page (running in the dock, or its window,
+//! hidden or not) to open or close that widget (event `overlay`, `{ show,
+//! widget }`), as its own switch does. With the plugins turned off by the
+//! plugins button, the overlay asked for shows on its own (`widgets::show_alone`).
+
+use serde_json::Value;
+use tauri::Emitter;
+
+#[derive(Debug, Clone, PartialEq)]
+struct Overlay {
+    id: String,
+    name: String,
+    widget: String,
+    title: String,
+    icon: String,
+}
+
+/// An overlay as a manifest's `ui.overlay` declares it, or None.
+fn read(id: &str, name: &str, ui: Option<&Value>) -> Option<Overlay> {
+    let o = ui?.get("overlay")?;
+    let widget = o.get("widget")?.as_str()?.to_string();
+    let ok_name = |s: &str| !s.is_empty() && s.len() <= 32 && s.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-');
+    if !ok_name(&widget) {
+        return None;
+    }
+    let title: String = o.get("title").and_then(Value::as_str).unwrap_or(name).chars().take(40).collect();
+    let icon = o.get("icon").and_then(Value::as_str).filter(|s| ok_name(s)).unwrap_or("layers").to_string();
+    Some(Overlay { id: id.to_string(), name: name.to_string(), widget, title, icon })
+}
+
+/// The overlays of the plugins loaded and turned on, in the plugins' order.
+fn declared(app: &tauri::AppHandle) -> Vec<Overlay> {
+    let Ok(host) = super::host(app) else { return Vec::new() };
+    let off = super::disabled(app);
+    let mut out: Vec<Overlay> = host
+        .list()
+        .into_iter()
+        .filter(|p| p.error.is_none() && !off.contains(&p.id))
+        .filter_map(|p| host.with(&p.id, |l| read(&l.manifest.id, &l.manifest.name, l.manifest.ui.as_ref())).flatten())
+        .collect();
+    let order = super::order(app);
+    out.sort_by_key(|o| order.iter().position(|id| id == &o.id).unwrap_or(usize::MAX));
+    out
+}
+
+/// Whether an overlay is on: open, not closed by its plugin, not held off
+/// by the plugins button.
+fn is_on(app: &tauri::AppHandle, label: &str) -> bool {
+    use tauri::Manager;
+    app.get_webview_window(label).is_some()
+        && !super::widgets::is_closed(label)
+        && !super::widgets::held_by_button(label)
+        && !(super::widgets::plugins_hidden(app) && !super::widgets::is_alone(label))
+}
+
+fn listed(app: &tauri::AppHandle) -> Value {
+    let list: Vec<Value> = declared(app)
+        .into_iter()
+        .map(|o| {
+            let on = is_on(app, &super::widgets::label(&o.id, &o.widget));
+            serde_json::json!({ "id": o.id, "name": o.name, "title": o.title, "icon": o.icon, "on": on })
+        })
+        .collect();
+    Value::Array(list)
+}
+
+/// The header's overlay buttons: `[{ id, name, title, icon, on }]`.
+#[tauri::command]
+pub fn plugin_overlays(app: tauri::AppHandle) -> Value {
+    listed(&app)
+}
+
+/// A header button pressed: plugin `id`'s overlay shown, or hidden.
+#[tauri::command]
+pub fn plugin_overlay_toggle(app: tauri::AppHandle, id: String) -> Value {
+    let Some(o) = declared(&app).into_iter().find(|o| o.id == id) else { return listed(&app) };
+    let label = super::widgets::label(&o.id, &o.widget);
+    let show = !is_on(&app, &label);
+    if show {
+        super::widgets::show_alone(&app, &label);
+    } else {
+        super::widgets::forget_alone(&label);
+    }
+    tracing::debug!("Plugins: the header {} {}'s overlay", if show { "shows" } else { "hides" }, o.id);
+    let event = serde_json::json!({ "plugin": o.id, "event": "overlay", "data": { "show": show, "widget": o.widget } });
+    super::emit_plugin(&app, &o.id, event);
+    listed(&app)
+}
+
+/// The meter's header hears how the overlays stand (a plugin opened or
+/// closed one, the plugins button, a plugin turned on or off).
+pub fn notify(app: &tauri::AppHandle) {
+    let _ = app.emit_to("main", "overlays-changed", listed(app));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::read;
+
+    #[test]
+    fn a_manifest_names_its_overlay() {
+        let ui = serde_json::json!({ "panel": {}, "overlay": { "widget": "limits", "title": "Limits", "icon": "gauge" } });
+        let o = read("inventory", "Inventory", Some(&ui)).unwrap();
+        assert_eq!((o.widget.as_str(), o.title.as_str(), o.icon.as_str()), ("limits", "Limits", "gauge"));
+        let plain = serde_json::json!({ "overlay": { "widget": "overlay" } });
+        let o = read("map", "Map", Some(&plain)).unwrap();
+        assert_eq!((o.title.as_str(), o.icon.as_str()), ("Map", "layers"));
+        for bad in [serde_json::json!({}), serde_json::json!({ "overlay": { "widget": "Bad_Name" } }), serde_json::json!({ "overlay": { "widget": "x", "icon": "<svg>" } })] {
+            let o = read("x", "X", Some(&bad));
+            assert!(o.is_none() || o.unwrap().icon == "layers", "{bad}");
+        }
+        assert!(read("x", "X", None).is_none());
+    }
+}
