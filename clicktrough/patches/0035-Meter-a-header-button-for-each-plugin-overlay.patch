diff --git a/public/src/js/overlayButtons.js b/public/src/js/overlayButtons.js
new file mode 100644
index 0000000..65b93be
--- /dev/null
+++ b/public/src/js/overlayButtons.js
@@ -0,0 +1,71 @@
+// Clicktrough: a button in the meter's header for each plugin overlay a
+// plugin names in its manifest (`ui.overlay`: the Map's overlay, the
+// Inventory's limits), before the plugins button: it shows or hides that
+// overlay alone, the plugin window staying as it is. Gold while the overlay
+// is on. While the meter is locked it stays clickable with the other header
+// buttons (lockedButtons.js). The backend: plugins/overlays.rs.
+(() => {
+  const view = window.A2_VIEW || window.__A2_VIEW__ || "main";
+  const invoke = window.__TAURI__?.core?.invoke;
+  const listen = window.__TAURI__?.event?.listen;
+  if (view !== "main" || typeof invoke !== "function") return;
+
+  const start = () => {
+    const bar = document.querySelector(".headerBtns");
+    const before = document.querySelector(".pluginsBtn");
+    if (!bar) return;
+    let shownKey = "";
+    const render = (list) => {
+      if (!Array.isArray(list)) return;
+      const key = JSON.stringify(list.map((o) => [o.id, o.icon, o.title]));
+      if (key !== shownKey) {
+        shownKey = key;
+        for (const old of bar.querySelectorAll(".overlayBtn")) old.remove();
+        for (const o of list) {
+          const btn = document.createElement("div");
+          btn.className = "headerBtn overlayBtn";
+          btn.dataset.plugin = o.id;
+          btn.setAttribute("role", "button");
+          btn.setAttribute("tabindex", "0");
+          btn.setAttribute("aria-label", `Show or hide: ${o.title}`);
+          const icon = document.createElement("i");
+          icon.setAttribute("data-lucide", o.icon);
+          btn.append(icon);
+          const toggle = () => Promise.resolve(invoke("plugin_overlay_toggle", { id: o.id })).then(mark).catch(() => {});
+          btn.addEventListener("click", (event) => {
+            event.stopPropagation();
+            toggle();
+          });
+          btn.addEventListener("keydown", (event) => {
+            if (event.key !== "Enter" && event.key !== " ") return;
+            event.preventDefault();
+            toggle();
+          });
+          bar.insertBefore(btn, before && before.parentNode === bar ? before : null);
+        }
+        try { window.lucide?.createIcons?.({ root: bar }); } catch {}
+        // The header's buttons moved: the lock button's place is sent again.
+        requestAnimationFrame(() => window._dpsApp?._sendLockBtnRect?.());
+      }
+      mark(list);
+    };
+    // On or off: gold while the overlay shows.
+    const mark = (list) => {
+      if (!Array.isArray(list)) return;
+      for (const o of list) {
+        const btn = bar.querySelector(`.overlayBtn[data-plugin="${CSS.escape(o.id)}"]`);
+        if (!btn) continue;
+        btn.classList.toggle("isActive", !!o.on);
+        btn.setAttribute("aria-pressed", String(!!o.on));
+        btn.title = `${o.title}: ${o.on ? "hide" : "show"}`;
+      }
+    };
+    const refresh = () => Promise.resolve(invoke("plugin_overlays")).then(render).catch(() => {});
+    refresh();
+    Promise.resolve(listen?.("overlays-changed", (event) => render(event?.payload))).catch(() => {});
+    // Plugins loaded later (the meter's start): asked again a few times.
+    for (const ms of [2000, 6000, 15000]) setTimeout(refresh, ms);
+  };
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
+  else start();
+})();
