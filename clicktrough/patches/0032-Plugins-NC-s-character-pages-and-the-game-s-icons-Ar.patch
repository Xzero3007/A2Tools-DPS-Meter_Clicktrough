+/// Clicktrough: `a2.web.image(url)`: a picture from one of `IMAGE_HOSTS`
+/// (permission "web:<host>") as a data: URL for an <img>, since a plugin's
+/// page loads nothing from the network itself. Pictures are kept for the
+/// meter's run (up to 800), and the meter fetches at most ten a second.
+#[tauri::command]
+pub async fn plugin_web_image(app: tauri::AppHandle, window: tauri::WebviewWindow, plugin: Option<String>, url: String) -> Result<String, String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, &image_permission(&url)?)?;
+    web_image(&app, &url).await
+}
+
+/// The kind of picture a server's Content-Type names, among those a page
+/// shows; None for anything else.
+fn picture_kind(content_type: &str) -> Option<&'static str> {
+    let kind = content_type.split(';').next().unwrap_or("").trim().to_ascii_lowercase();
+    ["image/png", "image/webp", "image/jpeg", "image/gif"].into_iter().find(|k| *k == kind)
+}
+
+#[cfg(feature = "net")]
+async fn web_image(app: &tauri::AppHandle, url: &str) -> Result<String, String> {
+    static CACHE: std::sync::OnceLock<Mutex<HashMap<String, String>>> = std::sync::OnceLock::new();
+    static NEXT: std::sync::OnceLock<tokio::sync::Mutex<Instant>> = std::sync::OnceLock::new();
+    let cache = CACHE.get_or_init(Mutex::default);
+    if let Some(hit) = cache.lock().unwrap_or_else(|p| p.into_inner()).get(url) {
+        return Ok(hit.clone());
+    }
+    {
+        let mut next = NEXT.get_or_init(|| tokio::sync::Mutex::new(Instant::now())).lock().await;
+        let now = Instant::now();
+        if *next > now {
+            tokio::time::sleep(*next - now).await;
+        }
+        *next = Instant::now() + Duration::from_millis(100);
+    }
+    let state = app.try_state::<AppState>().ok_or("no app state")?;
+    crate::net_guard::check(url)?;
+    let client = if WEB_OVER_IPV4.load(Ordering::Relaxed) { ipv4_client() } else { &state.http };
+    let res = client.get(url)
+        .header("Accept", "image/webp,image/png,image/*")
+        .header("User-Agent", concat!("A2Tools-DPS-Meter/", env!("CARGO_PKG_VERSION"), " Clicktrough"))
+        .timeout(Duration::from_secs(20))
+        .send().await
+        .map_err(|e| web_error(&e))?;
+    match res.status() {
+        s if s == reqwest::StatusCode::NOT_FOUND => return Err("no such picture".into()),
+        s if !s.is_success() => return Err(format!("the server answered {s}")),
+        _ => {}
+    }
+    let kind = res.headers().get(reqwest::header::CONTENT_TYPE)
+        .and_then(|v| v.to_str().ok())
+        .and_then(picture_kind)
+        .ok_or("not a picture")?;
+    let bytes = res.bytes().await.map_err(|e| web_error(&e))?;
+    if bytes.len() > MAX_WEB_IMAGE {
+        return Err("the picture is too large".into());
+    }
+    let data = format!("data:{kind};base64,{}", base64(&bytes));
+    let mut cache = cache.lock().unwrap_or_else(|p| p.into_inner());
+    if cache.len() >= 800 {
+        cache.clear();
+    }
+    cache.insert(url.to_string(), data.clone());
+    Ok(data)
+}
+
+#[cfg(not(feature = "net"))]
+async fn web_image(_app: &tauri::AppHandle, _url: &str) -> Result<String, String> {
+    Err("this meter is built without network features".into())
+}
