+/// Clicktrough: the plugin dock or a plugin's window at one of the sizes its
+/// player keeps (three buttons beside the text size, windowSizes.js), in CSS
+/// pixels, within what such a window may be. Only those windows (not the
+/// meter's, not a widget), each only itself. The size is remembered as any
+/// other (note_resized).
+#[tauri::command]
+pub fn plugin_window_size(window: tauri::WebviewWindow, width: f64, height: f64) -> Result<(), String> {
+    if place_id(window.label()).is_none() {
+        return Err("not a plugin window".into());
+    }
+    let (w, h) = window_size_within(width, height).ok_or("not a size")?;
+    window.set_size(tauri::LogicalSize::new(w, h)).map_err(|e| e.to_string())
+}
+
+/// A size a plugin window may be given: 240 x 120 to 2000 x 1600.
+fn window_size_within(width: f64, height: f64) -> Option<(f64, f64)> {
+    (width.is_finite() && height.is_finite()).then(|| (width.clamp(240.0, 2000.0).round(), height.clamp(120.0, 1600.0).round()))
+}
+
 /// A plugin window was resized: remember its size, once it has settled, as
 /// `note_moved` does its place. Not while it is being shown, nor a minimized
 /// or hidden window's.
@@ -2701,6 +2720,19 @@ mod tests {
         }
     }
 
+    #[test]
+    fn a_window_size_stays_within_what_a_plugin_window_may_be() {
+        use super::{place_id, window_size_within};
+        assert_eq!(window_size_within(640.4, 680.0), Some((640.0, 680.0)));
+        assert_eq!(window_size_within(10.0, 99999.0), Some((240.0, 1600.0)));
+        assert_eq!(window_size_within(f64::NAN, 500.0), None);
+        // The dock and plugin windows only.
+        assert!(place_id(super::dock::LABEL).is_some());
+        assert!(place_id("plugin-market").is_some());
+        assert!(place_id("main").is_none());
+        assert!(place_id("pw_map_overlay").is_none());
+    }
+
     /// A failed request says why ("Connection refused"), not only reqwest's
     /// "error sending request for url (...)".
     #[cfg(feature = "online")]
