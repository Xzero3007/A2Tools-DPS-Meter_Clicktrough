diff --git a/tests/window-sizes.test.mjs b/tests/window-sizes.test.mjs
new file mode 100644
index 0000000..195bd5c
--- /dev/null
+++ b/tests/window-sizes.test.mjs
@@ -0,0 +1,96 @@
+// Clicktrough: a plugin window's (or the dock's) three sizes to switch
+// between (windowSizes.js): a click asks the meter for that size, a
+// right-click or Shift+click keeps the window's size now, kept per window.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../public/src/js/windowSizes.js", import.meta.url), "utf8");
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+function element() {
+  const listeners = {};
+  const attrs = {};
+  return {
+    children: [],
+    attrs,
+    title: "",
+    textContent: "",
+    isConnected: true,
+    classList: { add() {} },
+    setAttribute: (k, v) => { attrs[k] = String(v); },
+    getAttribute: (k) => attrs[k] ?? null,
+    addEventListener: (name, fn) => { listeners[name] = fn; },
+    fire(name, extra = {}) { listeners[name]?.({ preventDefault() {}, shiftKey: false, ...extra }); },
+    appendChild(child) { this.children.push(child); },
+    replaceChildren() { this.children = []; },
+    querySelectorAll() { return this.children; },
+  };
+}
+
+function setup(stored = {}, size = [640, 680]) {
+  const storage = new Map(Object.entries(stored));
+  const invoked = [];
+  const toasts = [];
+  const window = {
+    innerWidth: size[0],
+    innerHeight: size[1],
+    __TAURI__: { core: { invoke: (name, args) => { invoked.push({ name, args }); return Promise.resolve(null); } } },
+    addEventListener() {},
+  };
+  const document = { createElement: () => element() };
+  const localStorage = { getItem: (k) => storage.get(k) ?? null, setItem: (k, v) => storage.set(k, String(v)) };
+  vm.runInContext(source, vm.createContext({ window, document, localStorage, JSON, Number, Math, String, Array, Promise, Map, Set, setTimeout, clearTimeout }));
+  const holder = element();
+  return { window, holder, storage, invoked, toasts };
+}
+
+test("three numbered buttons; the one whose size the window has is pressed", () => {
+  const { window, holder } = setup();
+  window.A2_WINDOW_SIZES(holder, { key: "dock", defaults: [[420, 560], [640, 680], [960, 820]] });
+  assert.deepEqual(holder.children.map((b) => b.textContent), ["1", "2", "3"]);
+  assert.deepEqual(holder.children.map((b) => b.attrs["aria-pressed"]), ["false", "true", "false"]);
+  assert.match(holder.children[0].title, /Size 1: 420 × 560/);
+});
+
+test("a click asks the meter for that size; a folded dock unfolds first", async () => {
+  const { window, holder, invoked } = setup();
+  let unfolded = 0;
+  window.A2_WINDOW_SIZES(holder, { key: "dock", defaults: [[420, 560], [640, 680], [960, 820]], before: () => { unfolded++; } });
+  holder.children[2].fire("click");
+  await tick();
+  assert.equal(unfolded, 1);
+  // (made in the page's own realm: compared as JSON)
+  assert.equal(JSON.stringify(invoked.at(-1)), JSON.stringify({ name: "plugin_window_size", args: { width: 960, height: 820 } }));
+});
+
+test("a right-click or Shift+click keeps the window's size now, per window", async () => {
+  const { window, holder, storage, invoked } = setup({}, [777, 555]);
+  const toasts = [];
+  window.A2_WINDOW_SIZES(holder, { key: "window:market", defaults: [[420, 520], [640, 680], [960, 820]], toast: (t) => toasts.push(t) });
+  holder.children[0].fire("contextmenu");
+  assert.deepEqual(JSON.parse(storage.get("a2plugin.sizes.window:market"))[0], [777, 555]);
+  assert.equal(holder.children[0].attrs["aria-pressed"], "true");
+  assert.deepEqual(toasts, ["Size 1 is now 777 × 555"]);
+  holder.children[1].fire("click", { shiftKey: true });
+  assert.deepEqual(JSON.parse(storage.get("a2plugin.sizes.window:market"))[1], [777, 555]);
+  assert.equal(invoked.length, 0, "keeping a size resizes nothing");
+});
+
+test("kept sizes come back, within what a plugin window may be; none kept while folded", () => {
+  const { window, holder, storage } = setup({ "a2plugin.sizes.dock": JSON.stringify([[100, 50], [5000, 9000], "bad"]) });
+  window.A2_WINDOW_SIZES(holder, { key: "dock", defaults: [[420, 560], [640, 680], [960, 820]], canKeep: () => false });
+  assert.match(holder.children[0].title, /240 × 120/);
+  assert.match(holder.children[1].title, /2000 × 1600/);
+  assert.match(holder.children[2].title, /960 × 820/);
+  holder.children[0].fire("contextmenu");
+  assert.equal(storage.get("a2plugin.sizes.dock"), JSON.stringify([[100, 50], [5000, 9000], "bad"]));
+});
+
+test("the words in the meter's language", () => {
+  const { window, holder } = setup();
+  const t = (key, fallback, vars) => `${key}:${vars.n}:${vars.w}x${vars.h}`;
+  window.A2_WINDOW_SIZES(holder, { key: "dock", defaults: [[420, 560], [640, 680], [960, 820]], t });
+  assert.equal(holder.children[1].title, "size:2:640x680");
+});
