diff --git a/public/src/js/windowSizes.js b/public/src/js/windowSizes.js
new file mode 100644
index 0000000..398bec2
--- /dev/null
+++ b/public/src/js/windowSizes.js
@@ -0,0 +1,124 @@
+// Clicktrough: sizes to switch a plugin window or the plugin dock between,
+// set by the player. Three buttons (1, 2, 3) beside the text size: a click
+// gives the window the size kept under that button, a right-click (or
+// Shift+click) keeps the window's size now under it. The dock has its own
+// three, each plugin's window its own. The button whose size the window has
+// shows pressed. Locked, they stay clickable as the bar's other buttons
+// (lockedButtons.js). The window is resized by the meter (plugin_window_size,
+// plugins/mod.rs), so it works while the window can't be dragged.
+(() => {
+  const invoke = window.__TAURI__?.core?.invoke;
+  const COUNT = 3;
+  const MIN_W = 240;
+  const MIN_H = 120;
+  const MAX_W = 2000;
+  const MAX_H = 1600;
+  const groups = new Map(); // key -> { sizes, holders: Set, options }
+
+  const clampSize = ([w, h]) => [
+    Math.round(Math.min(MAX_W, Math.max(MIN_W, Number(w) || MIN_W))),
+    Math.round(Math.min(MAX_H, Math.max(MIN_H, Number(h) || MIN_H))),
+  ];
+
+  const load = (key, defaults) => {
+    let kept = null;
+    try { kept = JSON.parse(localStorage.getItem(`a2plugin.sizes.${key}`) || "null"); } catch {}
+    return Array.from({ length: COUNT }, (_, i) => {
+      const k = Array.isArray(kept) ? kept[i] : null;
+      return clampSize(Array.isArray(k) && k.length === 2 ? k : defaults[i] || defaults[defaults.length - 1]);
+    });
+  };
+  const save = (key, sizes) => {
+    try { localStorage.setItem(`a2plugin.sizes.${key}`, JSON.stringify(sizes)); } catch {}
+  };
+
+  const now = () => [Math.round(window.innerWidth), Math.round(window.innerHeight)];
+  const fits = ([w, h]) => {
+    const [cw, ch] = now();
+    return Math.abs(cw - w) <= 2 && Math.abs(ch - h) <= 2;
+  };
+
+  const show = (group) => {
+    const t = group.options.t;
+    for (const holder of group.holders) {
+      // A panel gone from the page (its plugin left the dock); one not in
+      // it yet is being made.
+      if (!holder.isConnected && holder.a2Shown) {
+        group.holders.delete(holder);
+        continue;
+      }
+      if (holder.isConnected) holder.a2Shown = true;
+      holder.querySelectorAll(".sizePreset").forEach((btn, i) => {
+        const [w, h] = group.sizes[i];
+        btn.setAttribute("aria-pressed", String(fits(group.sizes[i])));
+        const label = t("size", "Size {n}: {w} × {h} · right-click keeps this window's size here", { n: i + 1, w, h });
+        btn.title = label;
+        btn.setAttribute("aria-label", label);
+      });
+    }
+  };
+
+  const keep = (group, i) => {
+    if (group.options.canKeep && !group.options.canKeep()) return;
+    group.sizes[i] = clampSize(now());
+    save(group.key, group.sizes);
+    show(group);
+    const [w, h] = group.sizes[i];
+    group.options.toast?.(group.options.t("sizeKept", "Size {n} is now {w} × {h}", { n: i + 1, w, h }));
+  };
+
+  const apply = async (group, i) => {
+    const [width, height] = group.sizes[i];
+    try {
+      await group.options.before?.();
+      await invoke("plugin_window_size", { width, height });
+    } catch (e) {
+      group.options.toast?.(String(e));
+    }
+  };
+
+  /**
+   * Put the three buttons into `holder` (an element in the window's bar).
+   * key: whose sizes ("dock", or the plugin's id); defaults: three [w, h];
+   * t(key, fallback, vars): the words; toast(text); before(): before a
+   * resize (the dock unfolds); canKeep(): whether the size now may be kept.
+   */
+  window.A2_WINDOW_SIZES = (holder, options) => {
+    if (!holder || typeof invoke !== "function") return;
+    const key = String(options.key);
+    let group = groups.get(key);
+    if (!group) {
+      const t = options.t || ((_, fallback, vars = {}) => String(fallback).replace(/\{(\w+)\}/g, (_, k) => (k in vars ? vars[k] : `{${k}}`)));
+      group = { key, sizes: load(key, options.defaults), holders: new Set(), options: { ...options, t } };
+      groups.set(key, group);
+    }
+    holder.classList.add("sizePresets");
+    holder.setAttribute("role", "group");
+    holder.replaceChildren();
+    for (let i = 0; i < COUNT; i++) {
+      const btn = document.createElement("button");
+      btn.type = "button";
+      btn.className = "sizePreset";
+      btn.textContent = String(i + 1);
+      btn.addEventListener("click", (e) => {
+        if (e.shiftKey) keep(group, i);
+        else apply(group, i);
+      });
+      btn.addEventListener("contextmenu", (e) => {
+        e.preventDefault();
+        keep(group, i);
+      });
+      holder.appendChild(btn);
+    }
+    group.holders.add(holder);
+    show(group);
+  };
+
+  // The window resized (by a button, its edges, or folding): which size it has.
+  let pending = 0;
+  window.addEventListener("resize", () => {
+    clearTimeout(pending);
+    pending = setTimeout(() => groups.forEach(show), 120);
+  });
+  window.A2_WINDOW_SIZES.refresh = () => groups.forEach(show);
+})();
