@@ -255,8 +287,194 @@ pub async fn plugin_video_twitch(
 ) -> Result<Value, String> {
     let id = window_plugin(&window, plugin.as_deref())?;
     require(&app, &id, "video")?;
-    let body = twitch_query(&kind, &arg)?;
-    net::twitch(&app, body).await
+    match kind.as_str() {
+        // Whether Streamlink is installed, and who is signed in.
+        "account" => {
+            #[cfg(target_os = "linux")]
+            let streamlink = streamlink::path().is_some();
+            #[cfg(not(target_os = "linux"))]
+            let streamlink = false;
+            Ok(json!({ "streamlink": streamlink, "user": twitch_account(&app).map(|a| a.public()) }))
+        }
+        "login" => {
+            let token = twitch_token_of(arg.as_str().unwrap_or("")).ok_or("that is not a Twitch auth-token (30 letters and digits)")?;
+            let me = net::twitch(&app, json!({ "query": "query { currentUser { login displayName } }" }), Some(&token)).await
+                .map_err(|e| if e.contains("401") { "Twitch didn't take this auth-token".to_string() } else { e })?;
+            let user = me.get("currentUser").filter(|u| !u.is_null()).ok_or("Twitch didn't take this auth-token")?;
+            let account = TwitchAccount {
+                token,
+                login: user.get("login").and_then(Value::as_str).unwrap_or("").chars().take(25).collect(),
+                display_name: user.get("displayName").and_then(Value::as_str).unwrap_or("").chars().take(50).collect(),
+            };
+            store_twitch(&app, &account)?;
+            tracing::info!("Twitch: signed in");
+            Ok(account.public())
+        }
+        "logout" => {
+            let _ = std::fs::remove_file(twitch_file(&app)?);
+            Ok(Value::Null)
+        }
+        // The channels the signed-in player follows, live or not.
+        "followed" => {
+            let account = twitch_account(&app).ok_or("sign in to Twitch first")?;
+            net::twitch(&app, twitch_query("followed", &Value::Null)?, Some(&account.token)).await
+        }
+        _ => net::twitch(&app, twitch_query(&kind, &arg)?, None).await,
+    }
