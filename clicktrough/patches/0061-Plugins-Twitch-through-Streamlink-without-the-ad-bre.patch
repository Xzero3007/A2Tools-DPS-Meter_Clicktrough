+    #[test]
+    fn a_twitch_auth_token_as_pasted() {
+        assert_eq!(twitch_token_of(" OAuth abcdefghij0123456789abcdefghij "), Some("abcdefghij0123456789abcdefghij".into()));
+        assert_eq!(twitch_token_of("ABCDEFGHIJ0123456789abcdefghij"), Some("abcdefghij0123456789abcdefghij".into()));
+        assert_eq!(twitch_token_of("abc"), None);
+        assert_eq!(twitch_token_of("abcdefghij0123456789abcdefghij; rm"), None);
+    }
+
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn streamlink_gets_the_channel_and_a_quality() {
+        assert_eq!(streamlink::quality("720"), "720p60,720p,best");
+        assert_eq!(streamlink::quality("audio"), "audio_only,worst");
+        assert_eq!(streamlink::quality("x"), "best");
+        let a = streamlink::args("https://www.twitch.tv/whelp", "1080", None);
+        assert_eq!(a, ["--stdout", "--loglevel", "error", "https://www.twitch.tv/whelp", "1080p60,1080p,best"]);
+        let a = streamlink::args("https://www.twitch.tv/whelp", "1080", Some("tok"));
+        assert_eq!(&a[3..5], ["--twitch-api-header", "Authorization=OAuth tok"]);
+    }
+
     #[test]
