+/// The signed-in Twitch account: twitch.tv's `auth-token`, which Streamlink
+/// and the followed channels' query send to Twitch.
+#[derive(serde::Serialize, serde::Deserialize, Default)]
+pub struct TwitchAccount {
+    token: String,
+    login: String,
+    display_name: String,
+}
+
+impl TwitchAccount {
+    /// What a plugin gets: the name, never the token.
+    fn public(&self) -> Value {
+        json!({ "login": self.login, "displayName": self.display_name })
+    }
+}
+
+/// An auth-token as pasted: 30 lowercase letters and digits, with or
+/// without "OAuth " before it.
+pub fn twitch_token_of(text: &str) -> Option<String> {
+    let t = text.trim();
+    let t = t.strip_prefix("OAuth ").or_else(|| t.strip_prefix("oauth:")).unwrap_or(t).trim();
+    (t.len() >= 20 && t.len() <= 64 && t.chars().all(|c| c.is_ascii_alphanumeric())).then(|| t.to_ascii_lowercase())
+}
+
+fn twitch_file(app: &tauri::AppHandle) -> Result<PathBuf, String> {
+    use tauri::Manager;
+    let state = app.try_state::<crate::app::AppState>().ok_or("no app state")?;
+    Ok(state.app_data_dir.join("twitch.json"))
+}
+
+fn twitch_account(app: &tauri::AppHandle) -> Option<TwitchAccount> {
+    let text = std::fs::read_to_string(twitch_file(app).ok()?).ok()?;
+    let a: TwitchAccount = serde_json::from_str(&text).ok()?;
+    twitch_token_of(&a.token).map(|token| TwitchAccount { token, ..a })
+}
+
+fn store_twitch(app: &tauri::AppHandle, account: &TwitchAccount) -> Result<(), String> {
+    use std::io::Write;
+    let path = twitch_file(app)?;
+    let tmp = path.with_extension("json.tmp");
+    {
+        let mut opts = std::fs::OpenOptions::new();
+        opts.write(true).create(true).truncate(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            opts.mode(0o600);
+        }
+        let mut f = opts.open(&tmp).map_err(|e| e.to_string())?;
+        f.write_all(serde_json::to_string_pretty(account).map_err(|e| e.to_string())?.as_bytes()).map_err(|e| e.to_string())?;
+    }
+    std::fs::rename(&tmp, &path).map_err(|e| e.to_string())
+}
+
+/// Streamlink for one widget: started for a Twitch channel, its output
+/// through a pipe to mpv (`fdclose://`), stopped with the video.
+#[cfg(target_os = "linux")]
+mod streamlink {
+    use std::collections::HashMap;
+    use std::io::{BufRead, BufReader};
+    use std::os::fd::IntoRawFd;
+    use std::path::PathBuf;
+    use std::process::{Child, Command, Stdio};
+    use std::sync::{Mutex, OnceLock};
+
+    fn children() -> &'static Mutex<HashMap<String, Child>> {
+        static C: OnceLock<Mutex<HashMap<String, Child>>> = OnceLock::new();
+        C.get_or_init(|| Mutex::new(HashMap::new()))
+    }
+
+    /// `streamlink` on the PATH.
+    pub fn path() -> Option<PathBuf> {
+        std::env::split_paths(&std::env::var_os("PATH")?).map(|d| d.join("streamlink")).find(|p| p.is_file())
+    }
+
+    /// Streamlink's stream names for a quality the player picked: that
+    /// height (60 frames first), else the best there is.
+    pub fn quality(q: &str) -> String {
+        match q {
+            "audio" => "audio_only,worst".into(),
+            q => match q.parse::<u32>() {
+                Ok(h) if (144..=2160).contains(&h) => format!("{h}p60,{h}p,best"),
+                _ => "best".into(),
+            },
+        }
+    }
+
+    /// Streamlink's arguments (the token, when signed in, goes to Twitch's
+    /// API only).
+    pub fn args(url: &str, quality: &str, token: Option<&str>) -> Vec<String> {
+        let mut a: Vec<String> = vec!["--stdout".into(), "--loglevel".into(), "error".into()];
+        if let Some(t) = token {
+            a.push("--twitch-api-header".into());
+            a.push(format!("Authorization=OAuth {t}"));
+        }
+        a.push(url.into());
+        a.push(self::quality(quality));
+        a
+    }
+
+    /// Started for widget `label` (an earlier one stopped): the address mpv
+    /// reads. `failed` gets Streamlink's error when it ends with one.
+    pub fn start(label: &str, url: &str, quality: &str, token: Option<&str>, failed: impl FnOnce(String) + Send + 'static) -> Result<String, String> {
+        stop(label);
+        let exe = path().ok_or("Streamlink isn't installed")?;
+        let mut child = Command::new(exe)
+            .args(args(url, quality, token))
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .map_err(|e| format!("Streamlink didn't start: {e}"))?;
+        let out = child.stdout.take().ok_or("Streamlink gave no output")?;
+        let err = child.stderr.take();
+        let pid = child.id();
+        children().lock().unwrap_or_else(|p| p.into_inner()).insert(label.to_string(), child);
+        let label = label.to_string();
+        let _ = std::thread::Builder::new().name("streamlink".into()).spawn(move || {
+            let mut last = String::new();
+            if let Some(err) = err {
+                for line in BufReader::new(err).lines().map_while(Result::ok) {
+                    let line = line.trim().trim_start_matches("error:").trim().to_string();
+                    if !line.is_empty() {
+                        tracing::warn!("Video: Streamlink: {line}");
+                        last = line.chars().take(240).collect();
+                    }
+                }
+            }
+            // Ended by itself (not stopped): reaped here, its error told.
+            let mut map = children().lock().unwrap_or_else(|p| p.into_inner());
+            if map.get(&label).is_some_and(|c| c.id() == pid) {
+                if let Some(mut c) = map.remove(&label) {
+                    drop(map);
+                    let ok = c.wait().map(|s| s.success()).unwrap_or(false);
+                    if !ok && !last.is_empty() {
+                        failed(last);
+                    }
+                }
+            }
+        });
+        // mpv reads the pipe and closes it when the video ends.
+        Ok(format!("fdclose://{}", out.into_raw_fd()))
+    }
+
+    /// Widget `label`'s Streamlink stopped, if one runs.
+    pub fn stop(label: &str) {
+        let child = children().lock().unwrap_or_else(|p| p.into_inner()).remove(label);
+        if let Some(mut c) = child {
+            let _ = c.kill();
+            let _ = c.wait();
+        }
+    }
 }
 
