+                if let Some((vx, vy)) = self.velocity {
+                    if self.moved <= RECKON_MOST {
+                        let s = moved.as_secs_f32();
+                        return Some((fix.x + vx * s, fix.y + vy * s, false, "reckoned", fix.at));
+                    }
+                }
