+/// Clicktrough: a segment the game client sent to the server (only its
+/// length: what it holds is encrypted), for the world's walking on.
+pub fn client_sent(len: usize) {
+    if WORLD_WANTED.load(Ordering::Relaxed) {
+        with_world(|w| w.client_sent(len, Instant::now()));
+    }
+}
+
 fn with_world<T>(f: impl FnOnce(&mut world::World) -> T) -> T {
     let mut slot = WORLD.lock().unwrap_or_else(|p| p.into_inner());
     f(slot.get_or_insert_with(world::World::default))
