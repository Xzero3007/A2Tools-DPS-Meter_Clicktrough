diff --git a/tests/odyle-remembered.test.mjs b/tests/odyle-remembered.test.mjs
index db2ebe3..543806d 100644
--- a/tests/odyle-remembered.test.mjs
+++ b/tests/odyle-remembered.test.mjs
@@ -95,3 +95,24 @@ test("nothing remembered shows nothing, and the setting off hides it", () => {
   m.app.updateOdyle();
   assert.equal(m.shown().visible, false);
 });
+
+// Clicktrough: switching to a character whose energy didn't come, the last
+// character's is not shown as live.
+test("the last character's energy isn't shown as the next one's", () => {
+  const m = meter(new Map());
+  m.app.USER_NAME = "Diabolia";
+  m.app.updateOdyle({ basic: 390, charged: 50, name: "Diabolia" });
+  assert.deepEqual(m.shown(), { visible: true, remembered: false, text: "390(+50)" });
+  // A twink logs in: the name changes before any energy of theirs comes.
+  m.app.USER_NAME = "Twink";
+  m.app.updateOdyle();
+  assert.equal(m.shown().visible, false);
+  // The backend says it no longer knows any.
+  m.app.USER_NAME = "Diabolia";
+  m.app.updateOdyle({ cleared: true });
+  assert.deepEqual(m.shown(), { visible: true, remembered: true, text: "390(+50)" });
+  // The twink's own, once it comes.
+  m.app.USER_NAME = "Twink";
+  m.app.updateOdyle({ basic: 0, charged: 0, name: "Twink" });
+  assert.deepEqual(m.shown(), { visible: true, remembered: false, text: "0" });
+});
