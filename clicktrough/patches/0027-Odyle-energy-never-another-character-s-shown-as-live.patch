diff --git a/public/src/js/core.js b/public/src/js/core.js
index 5fa5ddb..43889f2 100644
--- a/public/src/js/core.js
+++ b/public/src/js/core.js
@@ -6493,14 +6493,22 @@ class DpsApp {
   // long while. Each value the backend names an owner for is kept by that
   // character's name, and shown dimmed until the game sends one again.
   updateOdyle(energy) {
-    if (energy && typeof energy === "object") {
+    // Clicktrough: `cleared`, the backend no longer knows it (a login's list
+    // that didn't read): the last value isn't live any more.
+    if (energy?.cleared) {
+      this.odyleEnergy = null;
+    } else if (energy && typeof energy === "object") {
       this.odyleEnergy = energy;
       this.rememberOdyle(energy);
     }
     const el = this.odyleEl;
     if (!el) return;
     const isEnergy = (e) => typeof e?.basic === "number" && typeof e?.charged === "number";
-    const live = isEnergy(this.odyleEnergy);
+    // Clicktrough: another character's energy is never shown as the one
+    // playing's (the last character's stayed after a switch).
+    const owner = String(this.odyleEnergy?.name ?? "").trim();
+    const mine = !owner || !this.USER_NAME || owner === this.USER_NAME;
+    const live = isEnergy(this.odyleEnergy) && mine;
     const shown = live ? this.odyleEnergy : this.rememberedOdyle()[this.USER_NAME];
     if (!this.showOdyle || !isEnergy(shown)) {
       el.classList.remove("isVisible");
