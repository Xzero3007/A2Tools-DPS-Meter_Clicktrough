diff --git a/src-tauri/src/browser.rs b/src-tauri/src/browser.rs
new file mode 100644
index 0000000..eea2b1c
--- /dev/null
+++ b/src-tauri/src/browser.rs
@@ -0,0 +1,125 @@
+//! Clicktrough: Brave Origin as an overlay (`platform::browser`): the
+//! header's browser button and its Settings. Shown or hidden with the
+//! button, at the opacity set in Settings; closed with the meter.
+
+use tauri::{Emitter, Manager};
+
+use crate::app::AppState;
+use crate::platform;
+
+/// The browser's opacity in Settings, 20 to 100 (percent).
+const OPACITY_KEY: &str = "dpsMeter.browserOpacity";
+
+/// What the header's button and Settings show.
+#[derive(Debug, Clone, PartialEq, serde::Serialize)]
+pub struct BrowserState {
+    /// Brave Origin is installed: the button shows only then.
+    pub found: bool,
+    /// Its program, for Settings ("" when not found).
+    pub program: String,
+    /// Its profile folder, for Settings.
+    pub profile: String,
+    pub running: bool,
+    pub visible: bool,
+    pub opacity: u32,
+}
+
+/// The opacity kept in Settings (100 unless set).
+pub fn parse_opacity(value: Option<&str>) -> u32 {
+    value.and_then(|v| v.trim().parse::<f64>().ok()).filter(|v| v.is_finite()).map_or(100, |v| (v.round() as u32).clamp(20, 100))
+}
+
+fn opacity(app: &tauri::AppHandle) -> u32 {
+    parse_opacity(app.try_state::<AppState>().and_then(|s| s.settings.get(OPACITY_KEY)).as_deref())
+}
+
+fn state(app: &tauri::AppHandle) -> BrowserState {
+    let program = platform::browser::program();
+    let running = platform::browser::is_running();
+    BrowserState {
+        found: program.is_some(),
+        program: program.map(|p| p.display().to_string()).unwrap_or_default(),
+        profile: platform::browser::profile_dir().map(|p| p.display().to_string()).unwrap_or_default(),
+        running,
+        visible: running && platform::browser::is_visible(),
+        opacity: opacity(app),
+    }
+}
+
+#[tauri::command]
+pub fn browser_state(app: tauri::AppHandle) -> BrowserState {
+    state(&app)
+}
+
+/// The header's button: shows the browser (started when it isn't running)
+/// or hides it.
+#[tauri::command]
+pub async fn browser_toggle(app: tauri::AppHandle) -> Result<BrowserState, String> {
+    let handle = app.clone();
+    tauri::async_runtime::spawn_blocking(move || {
+        let show = !platform::browser::is_visible();
+        platform::browser::set_visible(show, opacity(&handle))?;
+        let now = state(&handle);
+        let _ = handle.emit("browser-changed", &now);
+        Ok(now)
+    })
+    .await
+    .map_err(|e| e.to_string())?
+}
+
+/// Settings' opacity slider (20 to 100), kept and applied at once.
+#[tauri::command]
+pub async fn browser_set_opacity(app: tauri::AppHandle, percent: u32) -> Result<BrowserState, String> {
+    let percent = percent.clamp(20, 100);
+    if let Some(s) = app.try_state::<AppState>() {
+        s.settings.set(OPACITY_KEY, &percent.to_string());
+    }
+    let handle = app.clone();
+    tauri::async_runtime::spawn_blocking(move || {
+        platform::browser::set_opacity(percent);
+        state(&handle)
+    })
+    .await
+    .map_err(|e| e.to_string())
+}
+
+/// Tell the windows when the browser comes or goes on its own (closed with
+/// its own ×): looked at every 2 s.
+pub fn spawn_watch(app: tauri::AppHandle) {
+    if platform::browser::program().is_none() {
+        return;
+    }
+    std::thread::spawn(move || {
+        let mut last = (false, false);
+        loop {
+            std::thread::sleep(std::time::Duration::from_secs(2));
+            let running = platform::browser::is_running();
+            let now = (running, running && platform::browser::is_visible());
+            if now != last {
+                last = now;
+                let _ = app.emit("browser-changed", state(&app));
+            }
+        }
+    });
+}
+
+/// The meter is closing: the browser it started closes too.
+pub fn close() {
+    platform::browser::close();
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_opacity_is_kept_between_20_and_100() {
+        assert_eq!(parse_opacity(None), 100);
+        assert_eq!(parse_opacity(Some("")), 100);
+        assert_eq!(parse_opacity(Some("nope")), 100);
+        assert_eq!(parse_opacity(Some("85")), 85);
+        assert_eq!(parse_opacity(Some("5")), 20);
+        assert_eq!(parse_opacity(Some("250")), 100);
+        assert_eq!(parse_opacity(Some("70.4")), 70);
+    }
+}
