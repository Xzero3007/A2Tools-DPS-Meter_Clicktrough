diff --git a/public/src/js/browserButton.js b/public/src/js/browserButton.js
new file mode 100644
index 0000000..fec3dc8
--- /dev/null
+++ b/public/src/js/browserButton.js
@@ -0,0 +1,87 @@
+// Clicktrough: Brave Origin as an overlay (src-tauri/src/browser.rs). A globe
+// button in the meter's header, before the plugin overlays' buttons, shows or
+// hides the Brave Origin the meter starts (gold while it shows); it appears
+// only when Brave Origin is installed. Settings → Browser: where it was
+// found, its profile folder, and its opacity.
+(() => {
+  const view = window.A2_VIEW || window.__A2_VIEW__ || "main";
+  const invoke = window.__TAURI__?.core?.invoke;
+  const listen = window.__TAURI__?.event?.listen;
+  if (typeof invoke !== "function") return;
+
+  const start = () => {
+    let btn = null;
+    const bar = view === "main" ? document.querySelector(".headerBtns") : null;
+    if (bar) {
+      btn = document.createElement("div");
+      btn.className = "headerBtn browserBtn";
+      btn.hidden = true;
+      btn.setAttribute("role", "button");
+      btn.setAttribute("tabindex", "0");
+      btn.setAttribute("aria-label", "Show or hide the browser");
+      btn.setAttribute("aria-pressed", "false");
+      const icon = document.createElement("i");
+      icon.setAttribute("data-lucide", "globe");
+      btn.append(icon);
+      const toggle = () => Promise.resolve(invoke("browser_toggle")).then(render).catch(() => {});
+      btn.addEventListener("click", (event) => {
+        event.stopPropagation();
+        toggle();
+      });
+      btn.addEventListener("keydown", (event) => {
+        if (event.key !== "Enter" && event.key !== " ") return;
+        event.preventDefault();
+        toggle();
+      });
+      const first = bar.querySelector(".overlayBtn, .pluginsBtn");
+      bar.insertBefore(btn, first && first.parentNode === bar ? first : null);
+      try { window.lucide?.createIcons?.({ root: bar }); } catch {}
+    }
+
+    const program = document.querySelector(".browserProgram");
+    const profile = document.querySelector(".browserProfile");
+    const slider = document.querySelector(".browserOpacityInput");
+    const value = document.querySelector(".browserOpacityValue");
+
+    let shownFound = null;
+    function render(state) {
+      if (!state || typeof state !== "object") return;
+      if (btn) {
+        // The button found again (`.headerBtn` is display flex): hidden by style too.
+        btn.hidden = !state.found;
+        btn.style.display = state.found ? "" : "none";
+        btn.classList.toggle("isActive", !!state.visible);
+        btn.setAttribute("aria-pressed", String(!!state.visible));
+        btn.title = state.visible ? "Browser: hide" : "Browser: show";
+        if (shownFound !== !!state.found) {
+          shownFound = !!state.found;
+          // The header's buttons moved: the lock button's place is sent again.
+          requestAnimationFrame(() => window._dpsApp?._sendLockBtnRect?.());
+        }
+      }
+      if (program) {
+        program.textContent = state.found ? state.program : "Not installed (AUR: brave-origin-bin), then restart the meter";
+      }
+      if (profile) profile.textContent = state.profile ? `Its profile: ${state.profile}` : "";
+      if (slider && document.activeElement !== slider) slider.value = String(state.opacity ?? 100);
+      if (value) value.textContent = `${slider ? slider.value : state.opacity}%`;
+    }
+
+    if (slider) {
+      let timer = 0;
+      slider.addEventListener("input", () => {
+        if (value) value.textContent = `${slider.value}%`;
+        clearTimeout(timer);
+        timer = setTimeout(() => {
+          Promise.resolve(invoke("browser_set_opacity", { percent: Number(slider.value) })).then(render).catch(() => {});
+        }, 120);
+      });
+    }
+
+    const refresh = () => Promise.resolve(invoke("browser_state")).then(render).catch(() => {});
+    refresh();
+    Promise.resolve(listen?.("browser-changed", (event) => render(event?.payload))).catch(() => {});
+  };
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
+  else start();
+})();
