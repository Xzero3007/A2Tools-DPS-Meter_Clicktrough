+// Clicktrough: the browser button in the meter's header (browserButton.js):
+// before the overlay and plugin buttons, shown only with Brave Origin
+// installed, gold while it shows, a click asks browser_toggle; Settings'
+// opacity slider asks browser_set_opacity.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../public/src/js/browserButton.js", import.meta.url), "utf8");
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+function element(tag) {
+  const attrs = {};
+  const classes = new Set();
+  const el = {
+    tag, children: [], handlers: {}, dataset: {}, style: {}, title: "", hidden: false, parentNode: null, textContent: "", value: "",
+    set className(v) { classes.clear(); for (const c of String(v).split(/\s+/).filter(Boolean)) classes.add(c); },
+    get className() { return [...classes].join(" "); },
+    classList: { toggle: (n, on) => (on ? classes.add(n) : classes.delete(n)), contains: (n) => classes.has(n) },
+    setAttribute: (k, v) => { attrs[k] = String(v); },
+    getAttribute: (k) => attrs[k],
+    addEventListener: (n, h) => { el.handlers[n] = h; },
+    append: (...kids) => { for (const k of kids) { k.parentNode = el; el.children.push(k); } },
+    attrs, classes,
+  };
+  return el;
+}
+
+function setup(state, { view = "main" } = {}) {
+  const calls = [];
+  const listeners = {};
+  const bar = element("div");
+  const plugins = element("div");
+  plugins.className = "headerBtn pluginsBtn";
+  bar.append(plugins);
+  bar.insertBefore = (node, ref) => {
+    node.parentNode = bar;
+    const i = ref ? bar.children.indexOf(ref) : bar.children.length;
+    bar.children.splice(i, 0, node);
+  };
+  bar.querySelector = (sel) => (sel.includes("pluginsBtn") ? plugins : null);
+  const slider = element("input");
+  slider.value = "100";
+  const value = element("div");
+  const program = element("div");
+  const profile = element("div");
+  const found = { ".headerBtns": bar, ".browserOpacityInput": slider, ".browserOpacityValue": value, ".browserProgram": program, ".browserProfile": profile };
+  const now = { ...state };
+  const context = vm.createContext({
+    window: {
+      A2_VIEW: view,
+      __TAURI__: {
+        core: {
+          invoke: async (cmd, args) => {
+            calls.push([cmd, args]);
+            if (cmd === "browser_toggle") now.visible = !now.visible;
+            if (cmd === "browser_set_opacity") now.opacity = args.percent;
+            return { ...now };
+          },
+        },
+        event: { listen: async (name, fn) => { listeners[name] = fn; } },
+      },
+      lucide: { createIcons() {} },
+    },
+    document: { readyState: "complete", activeElement: null, querySelector: (sel) => found[sel] ?? null, createElement: element },
+    requestAnimationFrame: (fn) => fn(),
+    setTimeout: (fn) => { fn(); return 1; },
+    clearTimeout() {},
+    Promise, String, Number, JSON,
+  });
+  vm.runInContext(source, context);
+  return { bar, plugins, slider, value, program, profile, calls, listeners };
+}
+
+test("the button comes before the plugins button and shows only with Brave installed", async () => {
+  const { bar, plugins } = setup({ found: true, program: "/usr/bin/brave-origin", profile: "/h/brave", visible: false, opacity: 100 });
+  await tick();
+  const btn = bar.children[0];
+  assert.ok(btn.classes.has("browserBtn"));
+  assert.equal(bar.children[1], plugins);
+  assert.equal(btn.hidden, false);
+
+  const none = setup({ found: false, program: "", profile: "/h/brave", visible: false, opacity: 100 });
+  await tick();
+  assert.equal(none.bar.children[0].hidden, true);
+  assert.match(none.program.textContent, /Not installed/);
+});
+
+test("a click asks browser_toggle and the button turns gold while Brave shows", async () => {
+  const { bar, calls, listeners } = setup({ found: true, program: "/usr/bin/brave-origin", profile: "/h/brave", visible: false, opacity: 100 });
+  await tick();
+  const btn = bar.children[0];
+  btn.handlers.click({ stopPropagation() {} });
+  await tick();
+  assert.deepEqual(calls.at(-1), ["browser_toggle", undefined]);
+  assert.ok(btn.classes.has("isActive"));
+  assert.equal(btn.getAttribute("aria-pressed"), "true");
+  // Closed with its own ×: the backend tells, the gold goes.
+  listeners["browser-changed"]({ payload: { found: true, visible: false, opacity: 100 } });
+  assert.ok(!btn.classes.has("isActive"));
+});
+
+test("Settings: the slider sets the opacity, where Brave was found is shown", async () => {
+  const { slider, value, program, profile, calls } = setup({ found: true, program: "/usr/bin/brave-origin", profile: "/h/brave", visible: true, opacity: 80 }, { view: "settings" });
+  await tick();
+  assert.equal(program.textContent, "/usr/bin/brave-origin");
+  assert.match(profile.textContent, /\/h\/brave/);
+  assert.equal(slider.value, "80");
+  assert.equal(value.textContent, "80%");
+  slider.value = "55";
+  slider.handlers.input();
+  await tick();
+  assert.deepEqual(JSON.parse(JSON.stringify(calls.at(-1))), ["browser_set_opacity", { percent: 55 }]);
+  assert.equal(value.textContent, "55%");
+});
