+        ("Description", "A2Tools DPS Meter: Brave Origin above fullscreen games (added by the meter)"),
+        ("wmclass", "^[aA]2tools-browser$"),
+        ("wmclassmatch", "3"),
+        ("wmclasscomplete", "false"),
+        ("layer", "overlay"),
+        ("layerrule", "2"),
+        ("above", "true"),
+        ("aboverule", "2"),
+        ("noborder", "true"),
+        ("noborderrule", "2"),
+        ("positionrule", "4"),
+        ("sizerule", "4"),
+    ]
+}
+
 /// The `[General]` entries that list the rules, with the meter's added.
 ///
 /// KWin loads the rules named in `rules` (with `count`), and deletes every
@@ -337,4 +368,18 @@ mod tests {
         assert!(!is_kde("ubuntu:GNOME"));
         assert!(!is_kde(""));
     }
+
+    #[test]
+    fn the_browser_rule_matches_only_the_browser_the_meter_starts() {
+        let entries = browser_rule_entries();
+        let value = |key: &str| entries.iter().find(|(k, _)| *k == key).map(|(_, v)| *v);
+        assert_eq!(value("wmclass"), Some("^[aA]2tools-browser$"));
+        assert_eq!(value("wmclassmatch"), Some("3"));
+        assert!(value("wmclass").unwrap().contains(&BROWSER_CLASS[1..]));
+        assert_eq!((value("layer"), value("layerrule")), (Some("overlay"), Some("2")));
+        assert_eq!((value("noborder"), value("noborderrule")), (Some("true"), Some("2")));
+        assert_eq!((value("positionrule"), value("sizerule")), (Some("4"), Some("4")));
+        // No title: Brave's title is the page's.
+        assert_eq!(value("title"), None);
+    }
 }
diff --git a/src-tauri/src/platform/linux/browser.rs b/src-tauri/src/platform/linux/browser.rs
new file mode 100644
index 0000000..0b9bf3c
--- /dev/null
+++ b/src-tauri/src/platform/linux/browser.rs
@@ -0,0 +1,332 @@
+//! Clicktrough: Brave Origin as an overlay. A browser's window can't be put
+//! inside another program's on Wayland, so the meter starts the player's own
+//! Brave Origin, with a profile of its own, and has KWin keep that window
+//! above the game (`kwin_rules::browser_rule_entries`: overlay layer, no
+//! frame, its place remembered). A button in the meter's title shows or hides
+//! it; a small KWin script, loaded again with each change, minimises it,
+//! brings it back and sets its opacity. The meter sends nothing: Brave goes
+//! online by itself, as it always does. It closes with the meter.
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::Mutex;
+
+use crate::platform::kwin_rules::BROWSER_CLASS;
+
+/// Where Brave Origin is looked for, in order: the AUR package's
+/// (`brave-origin-bin`), then its beta and nightly; each also on `PATH`.
+const PROGRAMS: [&str; 3] = ["brave-origin", "brave-origin-beta", "brave-origin-nightly"];
+
+/// The script's name in KWin, so the one before is replaced.
+const PLUGIN: &str = "a2tools-dps-meter-browser";
+
+/// The script: every window of the browser's class shown or minimised as the
+/// meter says, at the opacity it says; a window opening later too.
+/// `__VISIBLE__` is true or false, `__OPACITY__` 0.2 to 1.
+const SCRIPT: &str = r#"// A2Tools DPS Meter: shows or hides the browser it started, at the
+// opacity set in its Settings. Loaded again by the meter with each change.
+var CLASS = "__CLASS__", VISIBLE = __VISIBLE__, OPACITY = __OPACITY__;
+function ours(w) {
+    return !!w && String(w.resourceClass).toLowerCase() === CLASS && !w.deleted;
+}
+function apply(w, front) {
+    if (!ours(w)) return;
+    w.opacity = OPACITY;
+    if (!VISIBLE) {
+        w.minimized = true;
+        return;
+    }
+    w.minimized = false;
+    if (front) {
+        if (workspace.windowActivated) workspace.activeWindow = w;
+        else workspace.activeClient = w;
+    }
+}
+var list = workspace.windowList ? workspace.windowList() : workspace.clientList();
+var shown = list.filter(ours);
+shown.forEach(function (w, i) { apply(w, i === shown.length - 1); });
+if (workspace.windowAdded) workspace.windowAdded.connect(function (w) { apply(w, true); });
+else workspace.clientAdded.connect(function (w) { apply(w, true); });
+"#;
+
+/// The browser's profile: `~/.local/share/a2tools-dps-meter/brave`. Brave
+/// makes it at its first start; the player's own Brave profile stays apart.
+pub fn profile_dir() -> Option<PathBuf> {
+    let data = std::env::var_os("XDG_DATA_HOME")
+        .map(PathBuf::from)
+        .filter(|p| p.is_absolute())
+        .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".local/share")))?;
+    Some(data.join("a2tools-dps-meter").join("brave"))
+}
+
+/// Brave Origin's program, if installed.
+pub fn program() -> Option<PathBuf> {
+    let path = std::env::var_os("PATH").unwrap_or_default();
+    PROGRAMS.iter().find_map(|name| {
+        std::iter::once(PathBuf::from("/usr/bin"))
+            .chain(std::env::split_paths(&path))
+            .map(|dir| dir.join(name))
+            .find(|p| is_program(p))
+    })
+}
+
+fn is_program(path: &Path) -> bool {
+    use std::os::unix::fs::PermissionsExt;
+    std::fs::metadata(path).is_ok_and(|m| m.is_file() && m.permissions().mode() & 0o111 != 0)
+}
+
+/// The arguments the browser is started with: its own profile, and the class
+/// the KWin rule knows it by. `--class` sets the window class under X11
+/// only, so it runs through XWayland (`--ozone-platform=x11`).
+pub fn arguments(profile: &Path) -> Vec<String> {
+    vec![
+        format!("--user-data-dir={}", profile.display()),
+        format!("--class={BROWSER_CLASS}"),
+        "--ozone-platform=x11".into(),
+        "--no-default-browser-check".into(),
+    ]
+}
+
+/// Whether a process's command line (NUL-separated) is the browser's own
+/// main process with this profile (not one of its helpers, `--type=...`).
+pub fn is_browser_main(cmdline: &[u8], profile: &Path) -> bool {
+    let want = format!("--user-data-dir={}", profile.display());
+    let mut has_profile = false;
+    // Chromium may write its command line back as one line, with spaces
+    // between the arguments: both are read.
+    for arg in cmdline.split(|b| *b == 0 || b.is_ascii_whitespace()) {
+        if arg == want.as_bytes() {
+            has_profile = true;
+        }
+        if arg.starts_with(b"--type=") {
+            return false;
+        }
+    }
+    has_profile
+}
+
+/// The browser's main processes now running with the meter's profile.
+fn running(profile: &Path) -> Vec<i32> {
+    let Ok(dir) = std::fs::read_dir("/proc") else { return Vec::new() };
+    dir.filter_map(|e| e.ok())
+        .filter_map(|e| e.file_name().to_str()?.parse::<i32>().ok())
+        .filter(|pid| std::fs::read(format!("/proc/{pid}/cmdline")).is_ok_and(|c| is_browser_main(&c, profile)))
+        .collect()
+}
+
+/// The browser's process the meter started last (the wrapper execs it).
+static SPAWNED: Mutex<Option<i32>> = Mutex::new(None);
+
+/// Start the browser from a thread that lives as long as the meter, with the
+/// kernel told to end it when the meter ends (`PR_SET_PDEATHSIG`, which
+/// follows the thread that started it): it closes with the meter however
+/// the meter ends, a crash included.
+fn launch(program: PathBuf, profile: PathBuf) -> Result<i32, String> {
+    use std::sync::mpsc;
+    type Job = (PathBuf, PathBuf, mpsc::Sender<Result<i32, String>>);
+    static LAUNCHER: std::sync::OnceLock<Mutex<mpsc::Sender<Job>>> = std::sync::OnceLock::new();
+    let sender = LAUNCHER.get_or_init(|| {
+        let (tx, rx) = mpsc::channel::<Job>();
+        std::thread::Builder::new()
+            .name("browser-launcher".into())
+            .spawn(move || {
+                for (program, profile, answer) in rx {
+                    let _ = answer.send(spawn_tied(&program, &profile));
+                }
+            })
+            .ok();
+        Mutex::new(tx)
+    });
+    let (tx, rx) = mpsc::channel();
+    sender.lock().unwrap_or_else(|p| p.into_inner()).send((program, profile, tx)).map_err(|e| e.to_string())?;
+    rx.recv_timeout(std::time::Duration::from_secs(10)).map_err(|e| e.to_string())?
+}
+
+fn spawn_tied(program: &Path, profile: &Path) -> Result<i32, String> {
+    use std::os::unix::process::CommandExt;
+    let mut command = Command::new(program);
+    command.args(arguments(profile)).stdin(Stdio::null()).stdout(Stdio::null()).stderr(Stdio::null());
+    // SAFETY: only prctl(2), async-signal-safe, between fork and exec.
+    unsafe {
+        command.pre_exec(|| {
+            libc::prctl(libc::PR_SET_PDEATHSIG, libc::SIGTERM);
+            Ok(())
+        });
+    }
+    let child = command.spawn().map_err(|e| format!("{}: {e}", program.display()))?;
+    let pid = child.id() as i32;
+    // Reaped by its own thread, so it leaves no zombie behind.
+    std::thread::spawn(move || {
+        let mut child = child;
+        let _ = child.wait();
+    });
+    Ok(pid)
+}
+
+fn alive(pid: i32) -> bool {
+    // A zombie counts as gone.
+    std::fs::read_to_string(format!("/proc/{pid}/stat"))
+        .is_ok_and(|s| s.rsplit_once(')').is_some_and(|(_, rest)| !rest.trim_start().starts_with('Z')))
+}
+
+/// Shown or hidden, as the meter last asked.
+static VISIBLE: Mutex<bool> = Mutex::new(false);
+
+/// Whether the browser the meter starts is running.
+pub fn is_running() -> bool {
+    profile_dir().is_some_and(|p| !running(&p).is_empty())
+}
+
+/// Whether it is running and shown.
+pub fn is_visible() -> bool {
+    *VISIBLE.lock().unwrap_or_else(|p| p.into_inner()) && is_running()
+}
+
+/// Show the browser (starting it when it isn't running) or hide it.
+/// `opacity` is 20 to 100 (percent). Returns whether it is shown now.
+pub fn set_visible(show: bool, opacity: u32) -> Result<bool, String> {
+    let profile = profile_dir().ok_or("no home folder")?;
+    if show && running(&profile).is_empty() {
+        let program = program().ok_or("Brave Origin is not installed")?;
+        std::fs::create_dir_all(&profile).map_err(|e| format!("{}: {e}", profile.display()))?;
+        let pid = launch(program.clone(), profile.clone())?;
+        *SPAWNED.lock().unwrap_or_else(|p| p.into_inner()) = Some(pid);
+        tracing::info!("Browser: started {} (process {pid})", program.display());
+    }
+    *VISIBLE.lock().unwrap_or_else(|p| p.into_inner()) = show;
+    apply(show, opacity);
+    Ok(show)
+}
+
+/// Its opacity changed in Settings (20 to 100).
+pub fn set_opacity(opacity: u32) {
+    if is_running() {
+        apply(*VISIBLE.lock().unwrap_or_else(|p| p.into_inner()), opacity);
+    }
+}
+
+/// The script with the meter's wishes in it.
+pub fn script(visible: bool, opacity: u32) -> String {
+    let opacity = f64::from(opacity.clamp(20, 100)) / 100.0;
+    SCRIPT
+        .replace("__CLASS__", BROWSER_CLASS)
+        .replace("__VISIBLE__", if visible { "true" } else { "false" })
+        .replace("__OPACITY__", &format!("{opacity:.2}"))
+}
+
+static CONNECTION: std::sync::OnceLock<Option<zbus::blocking::Connection>> = std::sync::OnceLock::new();
+
+/// Load the script into KWin again (KDE only; elsewhere the browser is a
+/// normal window that only starts and closes).
+fn apply(visible: bool, opacity: u32) {
+    if !super::process::is_kde() {
+        return;
+    }
+    let Some(connection) = CONNECTION.get_or_init(|| zbus::blocking::Connection::session().ok()).as_ref() else {
+        return;
+    };
+    let dir = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+    let path = dir.join("a2tools-dps-meter-browser.js");
+    if let Err(e) = std::fs::write(&path, script(visible, opacity)) {
+        tracing::warn!("Browser: writing the KWin script: {e}");
+        return;
+    }
+    let Ok(kwin) = zbus::blocking::Proxy::new(connection, "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting") else {
+        return;
+    };
+    let _ = kwin.call_method("unloadScript", &(PLUGIN,));
+    match kwin.call::<_, _, i32>("loadScript", &(path.to_string_lossy().as_ref(), PLUGIN)) {
+        Ok(id) if id >= 0 => {
+            let _ = kwin.call_method("start", &());
+        }
+        Ok(_) => tracing::warn!("Browser: KWin did not load the script"),
+        Err(e) => tracing::warn!("Browser: loading the KWin script: {e}"),
+    }
+}
+
+/// Close the browser the meter started (the meter is closing). Brave takes
+/// SIGTERM as a normal quit and keeps its tabs for the next start.
+pub fn close() {
+    let Some(profile) = profile_dir() else { return };
+    let mut pids = running(&profile);
+    if let Some(pid) = SPAWNED.lock().unwrap_or_else(|p| p.into_inner()).take()
+        && alive(pid)
+        && !pids.contains(&pid)
+    {
+        pids.push(pid);
+    }
+    if pids.is_empty() {
+        return;
+    }
+    tracing::info!("Browser: closing with the meter (processes {pids:?})");
+    let signal = |sig| {
+        for pid in &pids {
+            // SAFETY: kill(2) with a process id read from /proc just now.
+            unsafe {
+                libc::kill(*pid, sig);
+            }
+        }
+    };
+    signal(libc::SIGTERM);
+    // Up to 3 s to save its tabs and go; then it is ended.
+    let until = std::time::Instant::now() + std::time::Duration::from_secs(3);
+    while pids.iter().any(|p| alive(*p)) && std::time::Instant::now() < until {
+        std::thread::sleep(std::time::Duration::from_millis(100));
+    }
+    if pids.iter().any(|p| alive(*p)) {
+        tracing::info!("Browser: still open after 3 s, ended");
+        signal(libc::SIGKILL);
+    }
+    if super::process::is_kde()
+        && let Some(Some(connection)) = CONNECTION.get()
+        && let Ok(kwin) = zbus::blocking::Proxy::new(connection, "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting")
+    {
+        let _ = kwin.call_method("unloadScript", &(PLUGIN,));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_the_main_process_with_the_meters_profile_is_the_browser() {
+        let profile = Path::new("/home/p/.local/share/a2tools-dps-meter/brave");
+        let main = b"/opt/brave-origin/brave\0--user-data-dir=/home/p/.local/share/a2tools-dps-meter/brave\0--class=a2tools-browser\0";
+        assert!(is_browser_main(main, profile));
+        let helper = b"/opt/brave-origin/brave\0--type=renderer\0--user-data-dir=/home/p/.local/share/a2tools-dps-meter/brave\0";
+        assert!(!is_browser_main(helper, profile));
+        let own = b"/opt/brave-origin/brave\0";
+        assert!(!is_browser_main(own, profile));
+        let other = b"/opt/brave-origin/brave\0--user-data-dir=/home/p/.local/share/a2tools-dps-meter/brave2\0";
+        assert!(!is_browser_main(other, profile));
+        // Written back as one line.
+        let one_line = b"/opt/brave-origin/brave --user-data-dir=/home/p/.local/share/a2tools-dps-meter/brave --class=a2tools-browser\0";
+        assert!(is_browser_main(one_line, profile));
+        let one_line_helper = b"/opt/brave-origin/brave --type=gpu-process --user-data-dir=/home/p/.local/share/a2tools-dps-meter/brave\0";
+        assert!(!is_browser_main(one_line_helper, profile));
+    }
+
+    #[test]
+    fn the_browser_starts_with_its_profile_and_class_under_xwayland() {
+        let args = arguments(Path::new("/x/brave"));
+        assert!(args.contains(&"--user-data-dir=/x/brave".to_string()));
+        assert!(args.contains(&"--class=a2tools-browser".to_string()));
+        assert!(args.contains(&"--ozone-platform=x11".to_string()));
+        // What the browser's main process is known by, as started.
+        let cmdline = format!("brave-origin\0{}\0", args.join("\0"));
+        assert!(is_browser_main(cmdline.as_bytes(), Path::new("/x/brave")));
+    }
+
+    #[test]
+    fn the_script_carries_the_class_the_wish_and_the_opacity() {
+        let s = script(true, 85);
+        assert!(s.contains("CLASS = \"a2tools-browser\""));
+        assert!(s.contains("VISIBLE = true"));
+        assert!(s.contains("OPACITY = 0.85"));
+        assert!(!s.contains("__"));
+        let s = script(false, 5);
+        assert!(s.contains("VISIBLE = false"));
+        assert!(s.contains("OPACITY = 0.20"));
+    }
+}
