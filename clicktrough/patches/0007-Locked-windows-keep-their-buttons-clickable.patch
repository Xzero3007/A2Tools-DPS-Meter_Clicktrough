diff --git a/public/src/js/lockedButtons.js b/public/src/js/lockedButtons.js
new file mode 100644
index 0000000..b64d7b2
--- /dev/null
+++ b/public/src/js/lockedButtons.js
@@ -0,0 +1,108 @@
+// Clicktrough: while the meter's windows are locked (click-through), their
+// buttons stay clickable. Each page tells the backend where its buttons are,
+// and the backend keeps those rectangles in the window's input region next to
+// the lock button and the scroll strip (platform/linux/window.rs,
+// set_locked_buttons); everywhere else clicks still go to the game. Settings
+// → Meter Settings → "Locked: buttons stay clickable", on unless turned off
+// (the backend decides; the pages always report). Linux only: on Windows the
+// lock works by a pointer watch, not a region.
+(() => {
+  const invoke = window.__TAURI__?.core?.invoke;
+  if (typeof invoke !== "function" || !/Linux/.test(navigator.userAgent || "")) return;
+
+  const path = String(window.location?.pathname || "");
+  const view = path.endsWith("plugin-dock.html") ? "dock"
+    : path.endsWith("plugin-host.html") ? "plugin"
+    : window.A2_VIEW || window.__A2_VIEW__ || "main";
+
+  // What stays clickable in each window: the controls that open, close and
+  // switch windows, views and tabs, and the menus they open. Not the meter's
+  // reset and capture switch, so a stray click can't end a fight's numbers.
+  const BUTTONS = {
+    main: ".headerBtns .headerBtn:not(.resetBtn):not(.suspendBtn), .footerBtns .footerBtn",
+    details: ".detailsHeader button, .detailsHeader .closeX, .detailsSettingsMenu",
+    history: ".historyHeader button, .historyHeader .closeX, .historyFilters select,"
+      + " .historyFilters .historyClassDropdownTrigger, .historyFilters .historyClassDropdownMenu",
+    dock: ".dockBar button, .dockBar input, .dockPanelBar button",
+    plugin: ".pluginBar button, .pluginBar input",
+  };
+  const selector = BUTTONS[view];
+  if (!selector) return; // Settings never locks.
+
+  // A little room around each, so a click on a button's rim isn't lost.
+  const PAD = 2;
+
+  const shown = (el) => {
+    if (!el.getClientRects().length) return false; // display: none, or detached
+    const style = getComputedStyle(el);
+    return style.visibility !== "hidden" && style.pointerEvents !== "none" && Number(style.opacity) !== 0;
+  };
+
+  const measure = () => {
+    const width = window.innerWidth;
+    const height = window.innerHeight;
+    const rects = [];
+    for (const el of document.querySelectorAll(selector)) {
+      if (!shown(el)) continue;
+      const r = el.getBoundingClientRect();
+      const left = Math.max(0, r.left - PAD);
+      const top = Math.max(0, r.top - PAD);
+      const right = Math.min(width, r.right + PAD);
+      const bottom = Math.min(height, r.bottom + PAD);
+      if (right - left < 1 || bottom - top < 1) continue;
+      rects.push([left, top, right - left, bottom - top].map((v) => Math.round(v * 2) / 2));
+    }
+    return rects.slice(0, 64);
+  };
+
+  let sent = "";
+  let pending = false;
+  const report = () => {
+    pending = false;
+    const rects = measure();
+    const scale = window.devicePixelRatio || 1;
+    const key = JSON.stringify([rects, scale]);
+    if (key === sent) return;
+    sent = key;
+    Promise.resolve(invoke("set_locked_buttons", { rects, scale })).catch(() => { sent = ""; });
+  };
+  const schedule = () => {
+    if (pending) return;
+    pending = true;
+    (window.requestAnimationFrame || setTimeout)(report);
+  };
+
+  const start = () => {
+    // Where the buttons live, so the meter's rows updating don't count; the
+    // meter's own size does (its footer moves as rows come and go).
+    const ROOTS = {
+      main: [".header", ".meterFooter"],
+      details: [".detailsHeader"],
+      history: [".historyHeader", ".historyFilters"],
+      dock: ["body"],
+      plugin: [".pluginBar"],
+    };
+    const roots = ROOTS[view].map((s) => document.querySelector(s)).filter(Boolean);
+    if (typeof MutationObserver === "function") {
+      const observer = new MutationObserver(schedule);
+      for (const root of roots) {
+        observer.observe(root, {
+          subtree: true, childList: true, attributes: true,
+          attributeFilter: ["class", "style", "hidden", "open", "aria-hidden", "aria-pressed"],
+        });
+      }
+    }
+    if (typeof ResizeObserver === "function") {
+      const resized = new ResizeObserver(schedule);
+      for (const el of [document.body, document.querySelector(".meter"), ...roots]) if (el) resized.observe(el);
+    }
+    window.addEventListener("resize", schedule);
+    for (const name of ["scroll", "transitionend", "animationend"]) document.addEventListener(name, schedule, { capture: true, passive: true });
+    document.fonts?.ready?.then(schedule).catch(() => {});
+    schedule();
+  };
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
+  else start();
+
+  window.__a2LockedButtons = { measure, report, view, selector };
+})();
