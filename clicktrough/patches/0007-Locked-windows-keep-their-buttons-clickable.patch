+/// Where the calling window's buttons are (CSS px, and the page's scale), so
+/// they stay clickable while it is locked (`LOCK_BUTTONS_KEY`).
+#[tauri::command]
+fn set_locked_buttons(window: tauri::WebviewWindow, rects: Vec<[f64; 4]>, scale: f64) {
+    let scale = if scale.is_finite() && scale > 0.0 { scale } else { 1.0 };
+    let rects = rects
+        .into_iter()
+        .filter(|r| r.iter().all(|v| v.is_finite()) && r[2] > 0.0 && r[3] > 0.0)
+        .take(64)
+        .map(|[x, y, w, h]| (x, y, w, h))
+        .collect();
+    platform::window::set_locked_buttons(&window, rects, scale);
+}
+
 /// Whether the meter's windows are locked with the overlay ("Lock all meter
 /// windows"): a tool window then offers no resize at its edges.
 #[tauri::command]
