@@ -0,0 +1,106 @@
+// Clicktrough: lockedButtons.js reports where a window's buttons are, so they
+// stay clickable while the window is locked (platform/linux/window.rs).
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../public/src/js/lockedButtons.js", import.meta.url), "utf8");
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+function element({ left = 0, top = 0, width = 20, height = 20, style = {}, displayed = true } = {}) {
+  return {
+    rect: { left, top, width, height, right: left + width, bottom: top + height },
+    style: { visibility: "visible", pointerEvents: "auto", opacity: "1", ...style },
+    displayed,
+    getClientRects() { return this.displayed ? [this.rect] : []; },
+    getBoundingClientRect() { return this.rect; },
+  };
+}
+
+function setup({ view = "main", path = "/index.html", userAgent = "Mozilla/5.0 (X11; Linux x86_64)", elements = [], scale = 1 } = {}) {
+  const calls = [];
+  const selectors = [];
+  const listeners = new Map();
+  const document = {
+    readyState: "complete",
+    body: {},
+    querySelector: () => null,
+    querySelectorAll: (selector) => { selectors.push(selector); return elements; },
+    addEventListener: (name, handler) => listeners.set(name, handler),
+  };
+  const window = {
+    A2_VIEW: view, innerWidth: 400, innerHeight: 300, devicePixelRatio: scale,
+    location: { pathname: path },
+    addEventListener() {},
+    requestAnimationFrame: (callback) => setImmediate(callback),
+    __TAURI__: { core: { invoke: (command, args) => { calls.push({ command, args }); return Promise.resolve(); } } },
+  };
+  const context = vm.createContext({
+    window, document, navigator: { userAgent }, setTimeout, setImmediate, JSON, Math, Number, String, Promise,
+    getComputedStyle: (el) => el.style,
+  });
+  vm.runInContext(source, context);
+  return { calls, selectors, window, elements };
+}
+
+test("reports the shown buttons, padded and cut to the window", async () => {
+  const app = setup({
+    elements: [
+      element({ left: 10, top: 5, width: 20, height: 20 }),
+      element({ left: 390, top: 290, width: 30, height: 30 }), // reaches past the corner
+      element({ displayed: false }), // display: none (a closed menu)
+      element({ style: { visibility: "hidden" } }),
+      element({ style: { pointerEvents: "none" } }),
+      element({ style: { opacity: "0" } }),
+    ],
+    scale: 1.25,
+  });
+  await tick();
+  assert.equal(app.calls.length, 1);
+  assert.equal(app.calls[0].command, "set_locked_buttons");
+  assert.deepEqual(JSON.parse(JSON.stringify(app.calls[0].args)), {
+    rects: [[8, 3, 24, 24], [388, 288, 12, 12]],
+    scale: 1.25,
+  });
+});
+
+test("an unchanged layout is not sent again; a moved button is", async () => {
+  const app = setup({ elements: [element({ left: 10, top: 5 })] });
