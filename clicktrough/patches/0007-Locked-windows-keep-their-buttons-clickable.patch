+        let keep_buttons = lock.locked.load(Ordering::SeqCst) && !screenshot_tool_in_front() && lock_buttons_on(app);
+        platform::window::set_locked_buttons_active(&main, keep_buttons);
         if platform::window::click_through_except(&main, ignore, *lock.button.lock()) {
             *applied = Some(ignore);
