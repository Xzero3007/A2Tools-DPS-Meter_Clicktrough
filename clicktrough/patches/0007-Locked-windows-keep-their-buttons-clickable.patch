+#[cfg(test)]
+mod tests {
+    use super::gdk_rects;
+
+    #[test]
+    fn button_rects_scale_from_css_to_gdk_pixels() {
+        // A page zoomed to 1.25 on a GDK scale of 1: CSS px times 1.25.
+        let keep = (vec![(10.0, 4.0, 20.0, 20.0)], 1.25);
+        assert_eq!(gdk_rects(&keep, 1), vec![(12, 5, 26, 25)]);
+        // devicePixelRatio 2 on a HiDPI GDK scale of 2: unchanged.
+        let keep = (vec![(10.5, 4.0, 20.0, 20.0)], 2.0);
+        assert_eq!(gdk_rects(&keep, 2), vec![(10, 4, 21, 20)]);
+        // Empty ones are dropped.
+        let keep = (vec![(5.0, 5.0, 0.0, 10.0), (1.0, 1.0, 2.0, 2.0)], 1.0);
+        assert_eq!(gdk_rects(&keep, 1), vec![(1, 1, 2, 2)]);
