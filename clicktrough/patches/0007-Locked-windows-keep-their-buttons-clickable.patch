+/// Where each page's buttons are (`set_locked_buttons`), by label.
+fn locked_buttons() -> &'static std::sync::Mutex<std::collections::HashMap<String, Keep>> {
+    static BUTTONS: std::sync::OnceLock<std::sync::Mutex<std::collections::HashMap<String, Keep>>> = std::sync::OnceLock::new();
+    BUTTONS.get_or_init(Default::default)
+}
+
+/// The windows whose buttons stay clickable while they let clicks through.
+fn buttons_kept() -> &'static std::sync::Mutex<std::collections::HashSet<String>> {
+    static KEPT: std::sync::OnceLock<std::sync::Mutex<std::collections::HashSet<String>>> = std::sync::OnceLock::new();
+    KEPT.get_or_init(Default::default)
+}
+
+/// The buttons a window keeps clickable right now, if it does.
+fn active_buttons(label: &str) -> Option<Keep> {
+    if !buttons_kept().lock().unwrap_or_else(|p| p.into_inner()).contains(label) {
+        return None;
+    }
+    locked_buttons().lock().unwrap_or_else(|p| p.into_inner()).get(label).cloned()
+}
+
+/// Whether a window, while it lets clicks through, keeps its buttons
+/// clickable (the rectangles its page reports). Applies with the next
+/// `click_through_except`.
+pub fn set_locked_buttons_active(window: &tauri::WebviewWindow, on: bool) {
+    let mut kept = buttons_kept().lock().unwrap_or_else(|p| p.into_inner());
+    if on {
+        kept.insert(window.label().to_string());
+    } else {
+        kept.remove(window.label());
+    }
+}
+
+/// Where a window's buttons are, from its page (CSS px and the page's scale).
+/// If the window lets clicks through right now and keeps its buttons, its
+/// region is set again at once, so they follow a menu opening or the meter
+/// growing.
+pub fn set_locked_buttons(window: &tauri::WebviewWindow, rects: Vec<(f64, f64, f64, f64)>, scale: f64) {
+    let label = window.label().to_string();
+    let changed = {
+        let mut buttons = locked_buttons().lock().unwrap_or_else(|p| p.into_inner());
+        let keep = (rects, scale);
+        let changed = buttons.get(&label) != Some(&keep);
+        buttons.insert(label.clone(), keep);
+        changed
+    };
+    if !changed || !buttons_kept().lock().unwrap_or_else(|p| p.into_inner()).contains(&label) {
+        return;
+    }
+    let wanted = wanted_regions().lock().unwrap_or_else(|p| p.into_inner()).get(&label).cloned();
+    if let Some((true, keep)) = wanted {
+        let _ = input_region(window, true, keep);
+    }
+}
+
+/// `keep`'s rectangles in GDK pixels (left, top, width, height): CSS pixels
+/// times the page's scale over GDK's own, grown outward to whole pixels.
+fn gdk_rects((rects, page_scale): &Keep, gdk_scale: i32) -> Vec<(i32, i32, i32, i32)> {
+    let k = page_scale / f64::from(gdk_scale.max(1));
+    rects
+        .iter()
+        .filter_map(|&(x, y, w, h)| {
+            let (left, top) = ((x * k).floor() as i32, (y * k).floor() as i32);
+            let (right, bottom) = (((x + w) * k).ceil() as i32, ((y + h) * k).ceil() as i32);
+            (right > left && bottom > top).then_some((left, top, right - left, bottom - top))
+        })
+        .collect()
+}
