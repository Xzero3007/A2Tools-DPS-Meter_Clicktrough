         #[cfg(feature = "online")]
         if key.starts_with(crate::stream_overlay::ENABLED_KEY) {
@@ -1548,6 +1571,20 @@ fn set_overlay_card_open(app: tauri::AppHandle, open: bool) {
     sync_click_through(&app, &lock, false);
