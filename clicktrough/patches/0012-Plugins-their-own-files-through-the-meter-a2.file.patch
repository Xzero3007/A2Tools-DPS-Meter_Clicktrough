+    #[test]
+    fn a_plugin_reads_only_its_own_images_and_json() {
+        let dir = std::env::temp_dir().join(format!("ct-own-file-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(dir.join("tiles")).unwrap();
+        std::fs::write(dir.join("tiles/a.webp"), [1u8, 2, 3]).unwrap();
+        std::fs::write(dir.join("plugin.js"), "x").unwrap();
+        std::fs::write(dir.with_extension("secret.png"), [9u8]).unwrap();
+        assert_eq!(read_own_file(&dir, "tiles/a.webp").unwrap(), "data:image/webp;base64,AQID");
+        assert_eq!(read_own_file(&dir, "/tiles/a.webp").unwrap(), "data:image/webp;base64,AQID");
+        assert!(read_own_file(&dir, "plugin.js").is_err(), "images and JSON only");
+        assert!(read_own_file(&dir, "tiles/none.webp").is_err());
+        let outside = format!("../{}", dir.with_extension("secret.png").file_name().unwrap().to_string_lossy());
+        assert!(read_own_file(&dir, &outside).is_err(), "nothing outside its folder");
+        let _ = std::fs::remove_dir_all(&dir);
+        let _ = std::fs::remove_file(dir.with_extension("secret.png"));
+    }
