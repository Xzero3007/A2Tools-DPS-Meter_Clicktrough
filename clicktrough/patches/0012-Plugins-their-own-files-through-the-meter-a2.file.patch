+/// Clicktrough: a file of the plugin's own folder is read for it at most
+/// this big (a map tile is well under).
+const MAX_OWN_FILE: u64 = 8 * 1024 * 1024;
+
+/// Clicktrough: one of the files in a plugin's folder as a `data:` URL
+/// (images and JSON). WebKitGTK 2.54 refuses every file a sandboxed frame
+/// asks for from the plugin scheme, so a plugin that loads files after its
+/// page (a map's tiles) asks the meter for them instead (`a2.file`).
+fn read_own_file(dir: &Path, path: &str) -> Result<String, String> {
+    let (Ok(root), Ok(file)) = (dir.canonicalize(), dir.join(path.trim_start_matches('/')).canonicalize()) else {
+        return Err(format!("no file {path:?}"));
+    };
+    if !file.starts_with(&root) || !file.is_file() {
+        return Err(format!("no file {path:?}"));
+    }
+    let kind = match file.extension().and_then(|e| e.to_str()).unwrap_or("") {
+        "png" => "image/png",
+        "webp" => "image/webp",
+        "jpg" | "jpeg" => "image/jpeg",
+        "gif" => "image/gif",
+        "svg" => "image/svg+xml",
+        "json" => "application/json",
+        _ => return Err(format!("{path:?}: only images and JSON")),
+    };
+    let size = file.metadata().map(|m| m.len()).unwrap_or(u64::MAX);
+    if size > MAX_OWN_FILE {
+        return Err(format!("{path:?} is larger than {MAX_OWN_FILE} bytes"));
+    }
+    let bytes = std::fs::read(&file).map_err(|e| e.to_string())?;
+    Ok(format!("data:{kind};base64,{}", base64(&bytes)))
+}
+
+/// A plugin's own file, by the folder it runs from.
+pub(crate) fn own_file(app: &tauri::AppHandle, id: &str, path: &str) -> Result<String, String> {
+    let dir = host(app)?.with(id, |l| l.dir.clone()).ok_or("plugin not loaded")?;
+    read_own_file(&dir, path)
+}
+
+/// Clicktrough: `a2.file(path)` from a plugin's window or dock tab.
+#[tauri::command]
+pub fn plugin_file(window: tauri::WebviewWindow, plugin: Option<String>, path: String) -> Result<String, String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    own_file(window.app_handle(), &id, &path)
+}
