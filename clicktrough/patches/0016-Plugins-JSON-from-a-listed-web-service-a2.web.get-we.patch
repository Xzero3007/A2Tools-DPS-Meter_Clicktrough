+/// Clicktrough: the web services plugins may read from (`a2.web.get`), each
+/// behind the permission "web:<host>", and there only under its path. Only
+/// these: a plugin cannot reach anything else (its page has no network at
+/// all).
+///   aion2.exchange  the market prices players' clients collect, by server
+///                   (its public API, /api/docs); the Market plugin
+///   raw.githubusercontent.com, the Clicktrough fork's branch market-data
+///                   only: its hourly copy of aion2.exchange's prices
+///                   (.github/workflows/market-prices.yml), which the
+///                   Market plugin reads first
+pub const WEB_HOSTS: &[(&str, &str)] = &[
+    ("aion2.exchange", "/"),
+    ("raw.githubusercontent.com", "/Xzero3007/A2Tools-DPS-Meter_Clicktrough/market-data/"),
+];
+
+/// Most bytes a web answer may have.
+const MAX_WEB_ANSWER: usize = 8 * 1024 * 1024;
+
+/// The host of a URL a plugin may read: https, one of `WEB_HOSTS` and under
+/// its path, no port, user or password, no way out of the path ("..", or an
+/// escaped character in it). The permission it needs, "web:<host>".
+fn web_permission(url: &str) -> Result<String, String> {
+    let rest = url.strip_prefix("https://").ok_or("only https:// addresses")?;
+    let authority = rest.split(['/', '?', '#']).next().unwrap_or("");
+    let path = rest[authority.len()..].split(['?', '#']).next().unwrap_or("");
+    let path = if path.is_empty() { "/" } else { path };
+    let listed = WEB_HOSTS.iter().any(|(host, under)| *host == authority && path.starts_with(under));
+    if authority.contains(['@', ':']) || !listed || path.contains("..") || path.contains('%') || path.contains('\\') {
+        return Err(format!("{url:?} is not a web service plugins may read"));
+    }
+    Ok(format!("web:{authority}"))
+}
+
+/// Clicktrough: `a2.web.get(url)`: a JSON answer from one of `WEB_HOSTS`
+/// (permission "web:<host>"), parsed; null for a 404. The same address is
+/// read at most once a minute (every plugin window asking gets the same
+/// answer), and the meter asks one host at most four times a second.
+#[tauri::command]
+pub async fn plugin_web_get(app: tauri::AppHandle, window: tauri::WebviewWindow, plugin: Option<String>, url: String) -> Result<Value, String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, &web_permission(&url)?)?;
+    web_get(&app, &url).await
+}
+
+#[cfg(feature = "online")]
+async fn web_get(app: &tauri::AppHandle, url: &str) -> Result<Value, String> {
+    static CACHE: std::sync::OnceLock<Mutex<HashMap<String, (Instant, Value)>>> = std::sync::OnceLock::new();
+    static NEXT: std::sync::OnceLock<tokio::sync::Mutex<Instant>> = std::sync::OnceLock::new();
+    let cache = CACHE.get_or_init(Mutex::default);
+    if let Some((at, value)) = cache.lock().unwrap_or_else(|p| p.into_inner()).get(url) {
+        if at.elapsed() < Duration::from_secs(60) {
+            return Ok(value.clone());
+        }
+    }
+    {
+        let mut next = NEXT.get_or_init(|| tokio::sync::Mutex::new(Instant::now())).lock().await;
+        let now = Instant::now();
+        if *next > now {
+            tokio::time::sleep(*next - now).await;
+        }
+        *next = Instant::now() + Duration::from_millis(250);
+    }
+    let state = app.try_state::<AppState>().ok_or("no app state")?;
+    // Once more when the connection failed, over IPv4 alone: an IPv6 path
+    // that leads nowhere, or drops the large packets of a long certificate
+    // chain, fails (or hangs until the timeout) where IPv4 works, while the
+    // browser, on HTTP/3, never notices. Once that helped, IPv4 first for
+    // the rest of the session. Once more after a moment, too, when the
+    // service was briefly down (502, 503, 504).
+    let mut tried = 0;
+    let mut ipv4 = WEB_OVER_IPV4.load(Ordering::Relaxed);
+    let mut first_error: Option<String> = None;
+    let res = loop {
+        let client = if ipv4 { ipv4_client() } else { &state.http };
+        let sent = client.get(url)
+            .header("Accept", "application/json")
+            .header("User-Agent", concat!("A2Tools-DPS-Meter/", env!("CARGO_PKG_VERSION"),
+                " Clicktrough (+https://github.com/Xzero3007/A2Tools-DPS-Meter_Clicktrough)"))
+            .timeout(Duration::from_secs(30))
+            .send().await;
+        tried += 1;
+        if tried < 2 {
+            match &sent {
+                Err(e) if e.is_connect() || e.is_timeout() => {
+                    first_error = Some(web_error(e));
+                    ipv4 = true;
+                    continue;
+                }
+                Ok(r) if matches!(r.status().as_u16(), 502..=504) => {
+                    tokio::time::sleep(Duration::from_secs(2)).await;
+                    continue;
+                }
+                _ => {}
+            }
+        }
+        if ipv4 && sent.is_ok() {
+            WEB_OVER_IPV4.store(true, Ordering::Relaxed);
+        }
+        // Both failed: what the usual connection said, and IPv4 if otherwise.
+        break sent.map_err(|e| match first_error.take() {
+            Some(first) if first != web_error(&e) => format!("{first}; over IPv4: {}", web_error(&e)),
+            Some(first) => first,
+            None => web_error(&e),
+        })?;
+    };
+    let value = match res.status() {
+        s if s == reqwest::StatusCode::NOT_FOUND => Value::Null,
+        s if s.is_success() => {
+            let bytes = res.bytes().await.map_err(|e| web_error(&e))?;
+            if bytes.len() > MAX_WEB_ANSWER {
+                return Err("the answer is too large".into());
+            }
+            serde_json::from_slice(&bytes).map_err(|e| e.to_string())?
+        }
+        s if s.is_server_error() => return Err(format!("the service is down right now (it answered {s})")),
+        s => return Err(format!("the service answered {s}")),
+    };
+    let mut cache = cache.lock().unwrap_or_else(|p| p.into_inner());
+    cache.retain(|_, (at, _)| at.elapsed() < Duration::from_secs(60));
+    cache.insert(url.to_string(), (Instant::now(), value.clone()));
+    Ok(value)
+}
+
+/// Plugins' web requests go over IPv4 alone: set once IPv4 worked where the
+/// usual connection (IPv6 first, where there is IPv6) failed.
+#[cfg(feature = "online")]
+static WEB_OVER_IPV4: AtomicBool = AtomicBool::new(false);
+
+/// The meter's client, but bound to IPv4: it connects to IPv4 addresses only.
+#[cfg(feature = "online")]
+fn ipv4_client() -> &'static reqwest::Client {
+    static CLIENT: std::sync::OnceLock<reqwest::Client> = std::sync::OnceLock::new();
+    CLIENT.get_or_init(|| {
+        reqwest::Client::builder()
+            .user_agent(concat!("A2Tools-DPS-Meter/", env!("CARGO_PKG_VERSION")))
+            .local_address(std::net::IpAddr::V4(std::net::Ipv4Addr::UNSPECIFIED))
+            .connect_timeout(Duration::from_secs(10))
+            .timeout(Duration::from_secs(30))
+            .build()
+            .unwrap_or_default()
+    })
+}
+
+/// A failed request in words the player can act on. reqwest's own ("error
+/// sending request for url (...)") hides why; its causes say it: a DNS
+/// error, a refused or timed-out connection, a certificate refused ...
+#[cfg(feature = "online")]
+fn web_error(e: &reqwest::Error) -> String {
+    let mut out = String::from(if e.is_timeout() {
+        "no answer in time"
+    } else if e.is_connect() {
+        "could not connect"
+    } else {
+        "the request failed"
+    });
+    let mut last = String::new();
+    let mut cause = std::error::Error::source(e);
+    while let Some(c) = cause {
+        let text = c.to_string();
+        // hyper and the OS often repeat the same words one level down.
+        if !text.is_empty() && !last.contains(&text) {
+            out.push_str(": ");
+            out.push_str(&text);
+            last = text;
+        }
+        cause = c.source();
+    }
+    out
+}
+
+#[cfg(not(feature = "online"))]
+async fn web_get(_app: &tauri::AppHandle, _url: &str) -> Result<Value, String> {
+    Err("this meter is built without network features".into())
+}
