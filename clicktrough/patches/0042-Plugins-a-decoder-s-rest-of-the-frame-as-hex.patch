From 181708565505feec5d25d0bb786590b2f798501e Mon Sep 17 00:00:00 2001
From: A2Tools-patch <patch@localhost>
Date: Tue, 10 Nov 2026 21:04:31 +0000
Subject: [PATCH] Plugins: a decoder's rest of the frame, as hex

A decoder field of type "rest", last at the top level, hands the plugin the
rest of its frame (at most 4 KB) as a hex string: for frames no fixed layout
fits, such as the Shugo card round (the cards with the pickers' names between
them).
---
 src-tauri/src/plugins/decoder.rs | 41 ++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/src-tauri/src/plugins/decoder.rs b/src-tauri/src/plugins/decoder.rs
index f5278a2..abe2cda 100644
--- a/src-tauri/src/plugins/decoder.rs
+++ b/src-tauri/src/plugins/decoder.rs
@@ -14,6 +14,11 @@
 //! many entries of the list's own `fields`). Numbers only: there is no string
 //! type, so no name can be read out of a frame.
 //!
+//! Clicktrough: `rest`, the last top-level field, is the rest of the frame (at
+//! most 4 KB) as a hex string, for a frame no fixed layout fits (the Shugo
+//! card round lists the cards with the pickers' names between them). The
+//! plugin reads it itself; it still sees only its own frame type.
+//!
 //! `"self": "<field>"` (plugin API 2) names a top-level number field that holds
 //! an entity id: the meter passes the event on only when that entity is the
 //! player's own character, so a plugin can tell "I did this" without ever
@@ -28,6 +33,8 @@ const MAX_FIELDS: usize = 32;
 const MAX_LIST: u64 = 4096;
 /// How deep lists may nest.
 const MAX_DEPTH: u8 = 2;
+/// Most bytes a `rest` field hands over.
+const MAX_REST: usize = 4096;
 
 #[derive(Debug, Clone, Deserialize)]
 pub struct DecoderSpec {
@@ -91,6 +98,9 @@ impl Decoder {
             .try_into()
             .map_err(|_| format!("decoder {}: opcode must be two bytes", spec.name))?;
         check_fields(&spec.fields, 0).map_err(|e| format!("decoder {}: {e}", spec.name))?;
+        if spec.fields.iter().rev().skip(1).any(|f| f.kind == "rest") {
+            return Err(format!("decoder {}: \"rest\" must be the last field", spec.name));
+        }
         if let Some(field) = &spec.self_field {
             let ok = spec.fields.iter().any(|f| {
                 f.name.as_deref() == Some(field.as_str()) && matches!(f.kind.as_str(), "u16" | "u32" | "u64" | "varint")
@@ -121,6 +131,14 @@ fn check_fields(fields: &[FieldSpec], depth: u8) -> Result<(), String> {
                     return Err(format!("a {kind} field needs a name"));
                 }
             }
+            "rest" => {
+                if depth > 0 {
+                    return Err("\"rest\" only at the top level".into());
+                }
+                if field.name.as_deref().is_none_or(str::is_empty) {
+                    return Err("a rest field needs a name".into());
+                }
+            }
             "list" => {
                 if depth >= MAX_DEPTH {
                     return Err("lists nest too deep".into());
@@ -190,6 +208,15 @@ fn decode_fields(fields: &[FieldSpec], body: &[u8], pos: &mut usize) -> Option<M
                 let v = i32::from_le_bytes(take(body, pos, 4)?.try_into().ok()?);
                 out.insert(name, Value::from(v));
             }
+            "rest" => {
+                let rest = body.get(*pos..)?;
+                if rest.len() > MAX_REST {
+                    return None;
+                }
+                *pos = body.len();
+                let hex: String = rest.iter().map(|b| format!("{b:02x}")).collect();
+                out.insert(name, Value::from(hex));
+            }
             "list" => {
                 let count = number(field.count.as_deref()?, body, pos)?;
                 if count > MAX_LIST {
@@ -290,6 +317,17 @@ mod tests {
         );
     }
 
+    #[test]
+    fn rest_is_the_frame_after_the_fields_as_hex() {
+        let d = spec(r#"{"name":"cards","opcode":"0A 57","fields":[
+            {"name":"a","type":"u16"},{"name":"body","type":"rest"}]}"#);
+        assert_eq!(d.decode(&[1, 0, 0xAB, 0x0C, 0x08]).unwrap(), serde_json::json!({"a": 1, "body": "ab0c08"}));
+        assert_eq!(d.decode(&[1, 0]).unwrap(), serde_json::json!({"a": 1, "body": ""}));
+        let mut long = vec![0u8; 2 + MAX_REST + 1];
+        long[0] = 1;
+        assert!(d.decode(&long).is_none());
+    }
+
     #[test]
     fn a_short_frame_decodes_to_nothing() {
         let d = spec(r#"{"name":"x","opcode":"0D 90","fields":[{"name":"a","type":"u32"}]}"#);
@@ -303,6 +341,9 @@ mod tests {
             r#"{"name":"X!","opcode":"0D 90","fields":[]}"#,
             r#"{"name":"x","opcode":"0D 90","fields":[{"name":"s","type":"string"}]}"#,
             r#"{"name":"x","opcode":"0D 90","fields":[{"type":"u32"}]}"#,
+            r#"{"name":"x","opcode":"0D 90","fields":[{"name":"r","type":"rest"},{"name":"a","type":"u8"}]}"#,
+            r#"{"name":"x","opcode":"0D 90","fields":[{"name":"l","type":"list","count":"u8","fields":[{"name":"r","type":"rest"}]}]}"#,
+            r#"{"name":"x","opcode":"0D 90","fields":[{"type":"rest"}]}"#,
             r#"{"name":"x","opcode":"0D 90","fields":[{"name":"l","type":"list","count":"u8","fields":[
                 {"name":"m","type":"list","count":"u8","fields":[
                     {"name":"n","type":"list","count":"u8","fields":[]}]}]}]}"#,
