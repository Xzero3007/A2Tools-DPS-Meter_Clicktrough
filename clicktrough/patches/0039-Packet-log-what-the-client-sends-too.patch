From e0cf25a9be4e407f7805e42f7cb66e4ce1eafc10 Mon Sep 17 00:00:00 2001
From: A2Tools-patch <patch@localhost>
Date: Tue, 10 Nov 2026 19:02:31 +0000
Subject: [PATCH 39/39] Packet log: what the client sends too

While packet logging is on, the segments the game client sends to the
server go into the capture as Sent:<client port>:<server port>. The meter
still reads only what the server sends.
---
 src-tauri/src/combat/capture_dispatcher.rs |  5 ++++
 src-tauri/src/logging/logger.rs            | 27 +++++++++++++++++++++-
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/src-tauri/src/combat/capture_dispatcher.rs b/src-tauri/src/combat/capture_dispatcher.rs
index 57b51a8..15f4fc0 100644
--- a/src-tauri/src/combat/capture_dispatcher.rs
+++ b/src-tauri/src/combat/capture_dispatcher.rs
@@ -416,6 +416,11 @@ impl CaptureDispatcher {
             // Only parse server->client (src == locked port)
             if let Some(port) = current_port {
                 if cap.src_port != port {
+                    // Clicktrough: what the client sent is not read, but
+                    // written to the packet log while that is on.
+                    if cap.dst_port == port && !cap.data.is_empty() {
+                        crate::logging::logger::log_sent_packet(&cap);
+                    }
                     continue;
                 }
                 if cap.src_ip.is_some() && cap.src_ip != last_game_host {
diff --git a/src-tauri/src/logging/logger.rs b/src-tauri/src/logging/logger.rs
index 3a92c85..6e5d075 100644
--- a/src-tauri/src/logging/logger.rs
+++ b/src-tauri/src/logging/logger.rs
@@ -286,6 +286,26 @@ pub fn is_packet_log_enabled() -> bool {
 }
 
 pub fn log_packet(cap: &CapturedPayload) {
+    let key = crate::capture::captured_payload::stream_key(cap.src_port, cap.dst_port);
+    write_packet(cap, &key);
+}
+
+/// Clicktrough: what the game client sent to the server, while packet
+/// logging is on, as `Sent:<client port>:<server port>` (the meter reads only
+/// what the server sends; this is for looking at the client's side, such as
+/// its movement). The segments as captured: not put in order, a resent one
+/// twice.
+pub fn log_sent_packet(cap: &CapturedPayload) {
+    write_packet(cap, &sent_stream_key(cap.dst_port, cap.src_port));
+}
+
+/// The stream name of what the client sent: the server port last, as in
+/// `stream_key`.
+pub fn sent_stream_key(server_port: u16, client_port: u16) -> String {
+    format!("Sent:{client_port}:{server_port}")
+}
+
+fn write_packet(cap: &CapturedPayload, key: &str) {
     if !PACKET_LOG_ENABLED.load(Ordering::Relaxed) { return; }
     let mut guard = PACKET_LOGGER.lock();
     if let Some(ref mut logger) = *guard {
@@ -295,7 +315,6 @@ pub fn log_packet(cap: &CapturedPayload) {
         use chrono::TimeZone;
         let captured = cap.capture_time_ms().and_then(|ms| chrono::Local.timestamp_millis_opt(ms).single());
         let ts = captured.unwrap_or_else(chrono::Local::now).format("%+");
-        let key = crate::capture::captured_payload::stream_key(cap.src_port, cap.dst_port);
         let hex: String = cap.data.iter().map(|b| format!("{:02X}", b)).collect();
         let line = format!("{}|{}|{}\n", ts, key, hex);
         if logger.writer.write_all(line.as_bytes()).is_ok() {
@@ -441,6 +460,12 @@ mod packet_log_tests {
         let _ = std::fs::remove_dir_all(&dir);
     }
 
+    #[test]
+    fn what_the_client_sent_has_its_own_stream_name() {
+        assert_eq!(sent_stream_key(13328, 49582), "Sent:49582:13328");
+        assert_eq!(sent_stream_key(13328, 49582).rsplit(':').next(), Some("13328"));
+    }
+
     #[test]
     fn a_long_korean_message_is_cut_between_characters() {
         let msg = format!("a{}", "가".repeat(100));
