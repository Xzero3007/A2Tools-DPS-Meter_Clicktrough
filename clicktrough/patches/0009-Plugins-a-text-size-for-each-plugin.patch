diff --git a/tests/plugin-text-size.test.mjs b/tests/plugin-text-size.test.mjs
new file mode 100644
index 0000000..df87e3f
--- /dev/null
+++ b/tests/plugin-text-size.test.mjs
@@ -0,0 +1,66 @@
+// Clicktrough: a plugin's text size (pluginFrame.js): kept per plugin, set on
+// its frame's place as --plugin-scale, and a fitted height scaled with it.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import vm from "node:vm";
+
+const source = readFileSync(new URL("../public/src/js/pluginFrame.js", import.meta.url), "utf8");
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+function setup(stored = {}) {
+  const storage = new Map(Object.entries(stored));
+  const invoked = [];
+  const props = {};
+  const stage = { style: { setProperty: (k, v) => { props[k] = v; } }, appendChild() {} };
+  let onMessage = null;
+  const frameWindow = { postMessage: () => {} };
+  const window = {
+    __TAURI__: { core: {
+      invoke: (name, args) => {
+        invoked.push({ name, args });
+        if (name === "plugin_hello") return Promise.resolve({ manifest: { permissions: ["window"] }, run: 1, language: "en" });
+        return Promise.resolve(null);
+      },
+      convertFileSrc: () => "a2plugin://localhost/",
+    } },
+    addEventListener: (name, fn) => { if (name === "message") onMessage = fn; },
+    removeEventListener() {},
+  };
+  const document = { createElement: () => ({ setAttribute() {}, contentWindow: frameWindow }) };
+  const localStorage = { getItem: (k) => storage.get(k) ?? null, setItem: (k, v) => storage.set(k, String(v)) };
+  vm.runInContext(source, vm.createContext({ window, document, localStorage, JSON, Number, Math, String, Array, Promise, Error }));
+  const plugin = window.createPluginFrame({ id: "event-timers", stage });
+  const call = async (name, args) => {
+    onMessage({ source: frameWindow, data: { a2: 1, id: 1, call: name, args } });
+    await tick();
+  };
+  return { plugin, props, storage, invoked, call };
+}
+
+test("starts at the saved size, else at 100%", () => {
+  assert.equal(setup().props["--plugin-scale"], "1");
+  assert.equal(setup({ "a2plugin.textScale.event-timers": "0.8" }).props["--plugin-scale"], "0.8");
+  assert.equal(setup({ "a2plugin.textScale.event-timers": "0.33" }).props["--plugin-scale"], "1", "an odd value is ignored");
+});
+
+test("steps through the sizes, kept per plugin, and stops at the ends", () => {
+  const { plugin, props, storage } = setup();
+  assert.equal(plugin.stepTextScale(-1), 0.9);
+  assert.equal(plugin.stepTextScale(-1), 0.8);
+  assert.equal(props["--plugin-scale"], "0.8");
+  assert.equal(storage.get("a2plugin.textScale.event-timers"), "0.8");
+  for (let i = 0; i < 9; i++) plugin.stepTextScale(-1);
+  assert.equal(plugin.textScale(), 0.6);
+  assert.equal(plugin.canStepTextScale(-1), false);
+  for (let i = 0; i < 9; i++) plugin.stepTextScale(1);
+  assert.equal(plugin.textScale(), 1.25);
+  assert.equal(plugin.canStepTextScale(1), false);
+});
+
+test("a fitted height is the plugin's, scaled to the window", async () => {
+  const { plugin, invoked, call } = setup({ "a2plugin.textScale.event-timers": "0.8" });
+  await plugin.start();
+  await call("window.fit", [100]);
