diff --git a/public/src/js/mediaRow.js b/public/src/js/mediaRow.js
new file mode 100644
index 0000000..49e37fd
--- /dev/null
+++ b/public/src/js/mediaRow.js
@@ -0,0 +1,149 @@
+// Clicktrough: the player row under the meter's header (plugins/media.rs).
+// While a plugin plays something (the Streams plugin's video, the Radio
+// plugin's station) the row shows: on the left a button per playing plugin,
+// on the right the chosen one's title and controls. A control goes to the
+// plugin (media_control), which plays on as with its own buttons and tells
+// the meter its new state. Nothing plays: the row goes, and the meter's
+// rows move back up. Locked, its buttons stay clickable (lockedButtons.js).
+(() => {
+  const view = window.A2_VIEW || window.__A2_VIEW__ || "main";
+  const invoke = window.__TAURI__?.core?.invoke;
+  const listen = window.__TAURI__?.event?.listen;
+  if (view !== "main" || typeof invoke !== "function") return;
+
+  const PICK_KEY = "a2.mediaRow.pick";
+  let picked = "";
+  try { picked = localStorage.getItem(PICK_KEY) || ""; } catch {}
+
+  const ICONS = {
+    prev: "skip-back", next: "skip-forward", stop: "square", favourite: "star",
+  };
+  const NAMES = {
+    prev: "Previous", next: "Next", stop: "Stop", favourite: "Favourite", playStop: "Play or stop",
+    pause: "Pause or play", mute: "Mute", volume: "Volume", opacity: "Video opacity",
+  };
+
+  const el = (tag, cls) => {
+    const e = document.createElement(tag);
+    if (cls) e.className = cls;
+    return e;
+  };
+  const icon = (name) => {
+    const i = document.createElement("i");
+    i.setAttribute("data-lucide", name);
+    return i;
+  };
+
+  const start = () => {
+    const header = document.querySelector(".meter > .header");
+    if (!header) return;
+    const row = el("div", "mediaRow");
+    row.hidden = true;
+    const tabs = el("div", "mediaTabs");
+    const now = el("div", "mediaNow");
+    const title = el("span", "mediaTitle");
+    const sub = el("span", "mediaSub");
+    now.append(title, sub);
+    const ctl = el("div", "mediaCtl");
+    row.append(tabs, now, ctl);
+    header.after(row);
+
+    let list = [];
+    let shownKey = "";
+    const send = (id, action, value) => Promise.resolve(invoke("media_control", { id, action, value: value ?? null })).catch(() => {});
+
+    const button = (id, action, iconName, label, pressed) => {
+      const b = el("button", `mediaBtn mediaBtn-${action}`);
+      b.type = "button";
+      b.title = label;
+      b.setAttribute("aria-label", label);
+      if (pressed != null) b.setAttribute("aria-pressed", String(!!pressed));
+      b.append(icon(iconName));
+      b.addEventListener("click", (event) => {
+        event.stopPropagation();
+        send(id, action, action === "pause" || action === "mute" ? !pressed : null);
+      });
+      return b;
+    };
+    const slider = (id, action, value, min, labelIcon) => {
+      const box = el("label", `mediaSlider mediaSlider-${action}`);
+      box.title = NAMES[action];
+      if (labelIcon) box.append(icon(labelIcon));
+      const input = el("input");
+      input.type = "range";
+      input.min = String(min);
+      input.max = "100";
+      input.step = action === "opacity" ? "5" : "1";
+      input.value = String(Math.round((value ?? 1) * 100));
+      input.setAttribute("aria-label", NAMES[action]);
+      input.dataset.action = action;
+      input.addEventListener("input", () => send(id, action, Number(input.value) / 100));
+      box.append(input);
+      return box;
+    };
+
+    const render = () => {
+      const playing = list.filter((p) => p && p.state);
+      row.hidden = !playing.length;
+      document.body.classList.toggle("hasMediaRow", !!playing.length);
+      if (!playing.length) {
+        shownKey = "";
+        return;
+      }
+      if (!playing.some((p) => p.id === picked)) picked = playing[0].id;
+      const cur = playing.find((p) => p.id === picked);
+      const s = cur.state;
+      title.textContent = s.title || cur.name;
+      sub.textContent = s.sub || "";
+      now.title = [s.title, s.sub].filter(Boolean).join(" · ");
+      // Rebuilt only when what is shown changes; a slider being dragged keeps its place.
+      const key = JSON.stringify([playing.map((p) => [p.id, p.state.icon, p.name]), picked, s.controls, s.paused, s.muted, s.playing, s.favourite]);
+      if (key !== shownKey) {
+        shownKey = key;
+        tabs.replaceChildren(...playing.map((p) => {
+          const b = el("button", "mediaTab");
+          b.type = "button";
+          b.title = p.name;
+          b.setAttribute("aria-label", p.name);
+          b.setAttribute("aria-pressed", String(p.id === picked));
+          b.append(icon(p.state.icon || "music"));
+          b.addEventListener("click", (event) => {
+            event.stopPropagation();
+            picked = p.id;
+            try { localStorage.setItem(PICK_KEY, picked); } catch {}
+            render();
+          });
+          return b;
+        }));
+        const parts = [];
+        for (const c of s.controls || []) {
+          if (c === "volume") parts.push(slider(cur.id, c, s.volume, 0, null));
+          else if (c === "opacity") parts.push(slider(cur.id, c, s.opacity, 20, "contrast"));
+          else if (c === "pause") parts.push(button(cur.id, c, s.paused ? "play" : "pause", NAMES[c], s.paused));
+          else if (c === "playStop") parts.push(button(cur.id, c, s.playing ? "square" : "play", NAMES[c], s.playing));
+          else if (c === "mute") parts.push(button(cur.id, c, s.muted ? "volume-x" : "volume-2", NAMES[c], s.muted));
+          else if (c === "favourite") parts.push(button(cur.id, c, "star", NAMES[c], s.favourite));
+          else parts.push(button(cur.id, c, ICONS[c] || "circle", NAMES[c] || c));
+        }
+        ctl.replaceChildren(...parts);
+        try { window.lucide?.createIcons?.({ root: row }); } catch {}
+      }
+      for (const input of ctl.querySelectorAll("input[type=range]")) {
+        if (document.activeElement === input) continue;
+        const v = input.dataset.action === "opacity" ? s.opacity : s.volume;
+        if (v != null) input.value = String(Math.round(v * 100));
+      }
+      requestAnimationFrame(() => window._dpsApp?._sendLockBtnRect?.());
+    };
+
+    const take = (value) => {
+      if (!Array.isArray(value)) return;
+      list = value;
+      render();
+    };
+    Promise.resolve(invoke("media_list")).then(take).catch(() => {});
+    Promise.resolve(listen?.("media-changed", (event) => take(event?.payload))).catch(() => {});
+  };
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
+  else start();
+})();
