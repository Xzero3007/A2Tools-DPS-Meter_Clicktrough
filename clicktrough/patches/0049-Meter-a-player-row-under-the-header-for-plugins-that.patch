+/* Clicktrough: the player row under the header (mediaRow.js): the playing
+   plugins' buttons, the chosen one's title and controls. As tall as the
+   header's icon row; gold for what is chosen or on. */
+.mediaRow {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 26px;
+  padding: 0 10px;
+  border-top: 1px solid rgba(255, 255, 255, 0.08);
+  font-size: 11px;
+  color: rgba(255, 255, 255, 0.85);
+  overflow: hidden;
+}
+.mediaRow[hidden] { display: none; }
+.mediaRow button {
+  background: none;
+  border: 0;
+  padding: 0;
+  margin: 0;
+  width: 18px;
+  height: 18px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  color: rgba(255, 255, 255, 0.7);
+  border-radius: 4px;
+  flex: none;
+}
+.mediaRow button svg { width: 14px; height: 14px; }
+.mediaRow button:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
+.mediaRow .mediaTabs { display: flex; gap: 4px; flex: none; }
+.mediaRow .mediaTab[aria-pressed="true"] { color: var(--ct-accent); box-shadow: inset 0 -2px 0 var(--ct-accent); border-radius: 0; }
+.mediaRow .mediaBtn[aria-pressed="true"].mediaBtn-mute,
+.mediaRow .mediaBtn[aria-pressed="true"].mediaBtn-favourite { color: var(--ct-accent); }
+.mediaRow .mediaNow { flex: 1 1 auto; min-width: 0; display: flex; gap: 6px; align-items: baseline; white-space: nowrap; overflow: hidden; }
+.mediaRow .mediaTitle { font-weight: 600; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
