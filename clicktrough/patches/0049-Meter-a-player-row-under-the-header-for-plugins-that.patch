diff --git a/src-tauri/src/plugins/media.rs b/src-tauri/src/plugins/media.rs
new file mode 100644
index 0000000..1edad59
--- /dev/null
+++ b/src-tauri/src/plugins/media.rs
@@ -0,0 +1,164 @@
+//! Clicktrough: the meter's player row. A plugin that plays something (the
+//! Streams plugin's video, the Radio plugin's station) tells the meter what
+//! plays (`a2.media.set(state)`, permission "media"), and the meter shows a
+//! second row under its header while anything plays: a button per playing
+//! plugin, and the chosen one's controls. A control sends the plugin an
+//! event `media` (`{ action, value }`), which it handles as its own buttons.
+//!
+//! The state a plugin gives, every field optional:
+//!
+//! ```json
+//! { "icon": "tv", "title": "Stoopzz", "sub": "Twitch", "paused": false,
+//!   "muted": false, "volume": 0.7, "opacity": 1, "controls": ["pause", "mute", "volume", "opacity", "stop"] }
+//! ```
+//!
+//! `null` takes it away (nothing plays). Only the controls listed here exist.
+
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+use serde_json::{json, Value};
+use tauri::Emitter;
+
+/// The controls a plugin may show in the row.
+const CONTROLS: &[&str] = &["prev", "playStop", "pause", "next", "mute", "volume", "opacity", "favourite", "stop"];
+
+fn states() -> &'static Mutex<BTreeMap<String, Value>> {
+    static S: std::sync::OnceLock<Mutex<BTreeMap<String, Value>>> = std::sync::OnceLock::new();
+    S.get_or_init(Mutex::default)
+}
+
+fn text(v: Option<&Value>, max: usize) -> String {
+    v.and_then(Value::as_str).unwrap_or("").chars().filter(|c| !c.is_control()).take(max).collect()
+}
+
+fn unit(v: Option<&Value>, min: f64) -> Option<f64> {
+    v.and_then(Value::as_f64).filter(|v| v.is_finite()).map(|v| v.clamp(min, 1.0))
+}
+
+/// A plugin's state made safe to show: known fields only, short texts.
+fn clean(state: &Value) -> Option<Value> {
+    let s = state.as_object()?;
+    let icon = text(s.get("icon"), 32);
+    let icon = if !icon.is_empty() && icon.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-') { icon } else { "music".into() };
+    let mut controls: Vec<&str> = Vec::new();
+    for c in s.get("controls").and_then(Value::as_array).into_iter().flatten().filter_map(Value::as_str) {
+        if let Some(known) = CONTROLS.iter().find(|k| **k == c) {
+            if !controls.contains(known) {
+                controls.push(known);
+            }
+        }
+    }
+    Some(json!({
+        "icon": icon,
+        "title": text(s.get("title"), 120),
+        "sub": text(s.get("sub"), 120),
+        "playing": s.get("playing").and_then(Value::as_bool).unwrap_or(true),
+        "paused": s.get("paused").and_then(Value::as_bool).unwrap_or(false),
+        "muted": s.get("muted").and_then(Value::as_bool).unwrap_or(false),
+        "favourite": s.get("favourite").and_then(Value::as_bool).unwrap_or(false),
+        "volume": unit(s.get("volume"), 0.0),
+        "opacity": unit(s.get("opacity"), 0.2),
+        "controls": controls,
+    }))
+}
+
+fn listed(app: &tauri::AppHandle) -> Value {
+    let names: BTreeMap<String, String> = super::host(app)
+        .map(|h| h.list().into_iter().map(|p| (p.id.clone(), p.name.clone())).collect())
+        .unwrap_or_default();
+    let order = super::order(app);
+    let mut list: Vec<(String, Value)> = states().lock().unwrap_or_else(|p| p.into_inner()).iter().map(|(k, v)| (k.clone(), v.clone())).collect();
+    list.sort_by_key(|(id, _)| order.iter().position(|o| o == id).unwrap_or(usize::MAX));
+    Value::Array(
+        list.into_iter()
+            .map(|(id, state)| json!({ "id": id, "name": names.get(&id).cloned().unwrap_or_else(|| id.clone()), "state": state }))
+            .collect(),
+    )
+}
+
+fn notify(app: &tauri::AppHandle) {
+    let _ = app.emit_to("main", "media-changed", listed(app));
+}
+
+/// A plugin turned off or gone: its entry leaves the row.
+pub fn forget(app: &tauri::AppHandle, id: &str) {
+    let gone = states().lock().unwrap_or_else(|p| p.into_inner()).remove(id).is_some();
+    if gone {
+        notify(app);
+    }
+}
+
+/// `a2.media.set(state)`: what the plugin plays now, or null for nothing.
+#[tauri::command]
+pub fn plugin_media_set(app: tauri::AppHandle, window: tauri::WebviewWindow, plugin: Option<String>, state: Option<Value>) -> Result<(), String> {
+    let id = super::window_plugin(&window, plugin.as_deref())?;
+    super::require(&app, &id, "media")?;
+    let cleaned = state.as_ref().filter(|s| !s.is_null()).map(|s| clean(s).ok_or("not a player state")).transpose()?;
+    {
+        let mut all = states().lock().unwrap_or_else(|p| p.into_inner());
+        match cleaned {
+            Some(s) => {
+                if all.get(&id) == Some(&s) {
+                    return Ok(());
+                }
+                all.insert(id, s);
+            }
+            None => {
+                if all.remove(&id).is_none() {
+                    return Ok(());
+                }
+            }
+        }
+    }
+    notify(&app);
+    Ok(())
+}
+
+/// The meter's row: `[{ id, name, state }]`.
+#[tauri::command]
+pub fn media_list(app: tauri::AppHandle) -> Value {
+    listed(&app)
+}
+
+/// A control in the meter's row: the plugin hears `media` `{ action, value }`.
+#[tauri::command]
+pub fn media_control(app: tauri::AppHandle, id: String, action: String, value: Option<Value>) -> Result<(), String> {
+    if !states().lock().unwrap_or_else(|p| p.into_inner()).contains_key(&id) {
+        return Err("nothing of that plugin plays".into());
+    }
+    if !CONTROLS.contains(&action.as_str()) {
+        return Err("unknown control".into());
+    }
+    let value = match value {
+        Some(Value::Number(n)) => n.as_f64().filter(|v| v.is_finite()).map(|v| json!(v.clamp(0.0, 1.0))).unwrap_or(Value::Null),
+        Some(Value::Bool(b)) => Value::Bool(b),
+        _ => Value::Null,
+    };
+    super::emit_plugin(&app, &id, json!({ "plugin": id, "event": "media", "data": { "action": action, "value": value } }));
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_player_state_keeps_known_fields_only() {
+        let s = clean(&json!({
+            "icon": "tv", "title": "A\u{7}B", "sub": "Twitch", "paused": true, "volume": 1.7, "opacity": 0.05,
+            "controls": ["pause", "pause", "open_url", "stop"], "url": "https://example.com"
+        }))
+        .unwrap();
+        assert_eq!(s["icon"], "tv");
+        assert_eq!(s["title"], "AB");
+        assert_eq!(s["paused"], true);
+        assert_eq!(s["volume"], 1.0);
+        assert_eq!(s["opacity"], 0.2);
+        assert_eq!(s["controls"], json!(["pause", "stop"]));
+        assert!(s.get("url").is_none());
+        assert_eq!(clean(&json!({ "icon": "../x" })).unwrap()["icon"], "music");
+        assert!(clean(&json!("text")).is_none());
+        assert_eq!(clean(&json!({ "title": "x".repeat(500) })).unwrap()["title"].as_str().unwrap().len(), 120);
+    }
+}
