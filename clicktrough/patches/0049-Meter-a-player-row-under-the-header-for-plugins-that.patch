+.mediaRow .mediaCtl { display: flex; align-items: center; gap: 4px; flex: none; }
+.mediaRow .mediaSlider { display: inline-flex; align-items: center; gap: 3px; color: rgba(255, 255, 255, 0.6); }
+.mediaRow .mediaSlider svg { width: 13px; height: 13px; }
+.mediaRow .mediaSlider input { width: 56px; height: 14px; margin: 0; accent-color: var(--ct-accent); }
