+/// Sync on the main thread (the frames come on the capture's).
+fn sync_soon(app: &tauri::AppHandle) {
     let app = app.clone();
     let main = app.clone();
     let _ = main.run_on_main_thread(move || sync(&app));
 }
 
+/// At a shop: from a merchant's list until the player moves on.
+static AT_SHOP: AtomicBool = AtomicBool::new(false);
+/// The app, for the client's movement (`client_sent`), which comes without it.
+static APP: OnceLock<tauri::AppHandle> = OnceLock::new();
+/// The client's movement steps heard since the shop opened.
+fn steps() -> &'static Mutex<std::collections::VecDeque<Instant>> {
+    static STEPS: OnceLock<Mutex<std::collections::VecDeque<Instant>>> = OnceLock::new();
+    STEPS.get_or_init(Mutex::default)
+}
+/// Moving on: this many steps within `MOVED_WITHIN`. The client sends its
+/// movement about 10 times a second while the player moves (segments of 28
+/// to 96 bytes, world.rs); a click in the shop's window is one now and then.
+const MOVED_STEPS: usize = 8;
+const MOVED_WITHIN: Duration = Duration::from_millis(2000);
+
+/// A merchant's list (`91 56`): a tab of a shop opened.
+pub fn saw_shop(app: &tauri::AppHandle) {
+    let _ = APP.set(app.clone());
+    lock(steps()).clear();
+    if AT_SHOP.swap(true, Ordering::Relaxed) {
+        return;
+    }
+    tracing::debug!("Plugins: a shop opened: the overlays as it says");
+    lock(shown_anyway()).clear();
+    sync_soon(app);
+}
+
+/// A segment the client sent, by its length: the player walking, riding or
+/// flying off ends the shop.
+pub fn client_sent(len: usize) {
+    if !AT_SHOP.load(Ordering::Relaxed) || !(28..=96).contains(&len) {
+        return;
+    }
+    let now = Instant::now();
+    let moved = {
+        let mut q = lock(steps());
+        q.push_back(now);
+        while q.front().is_some_and(|t| now.duration_since(*t) > MOVED_WITHIN) {
+            q.pop_front();
+        }
+        q.len() >= MOVED_STEPS
+    };
+    if moved && AT_SHOP.swap(false, Ordering::Relaxed) {
+        tracing::debug!("Plugins: moving on from the shop: the overlays back");
+        lock(steps()).clear();
+        lock(shown_anyway()).clear();
+        if let Some(app) = APP.get() {
+            sync_soon(app);
+        }
+    }
+}
