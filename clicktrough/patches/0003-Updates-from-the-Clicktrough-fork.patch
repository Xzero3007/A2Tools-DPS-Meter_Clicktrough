         for bad in [
+            "https://cdn.a2tools.app/A2Tools-DPS-Meter_2.0.80_x64_en-US.msi",
+            "https://cdn.a2tools.app/linux/a2tools-dps-meter-2.0.80-1-x86_64.pkg.tar.zst",
             "http://cdn.a2tools.app/x.msi",
             "https://cdn.a2tools.app.evil.example/x.msi",
             "https://evil.example/x.msi",
@@ -4458,6 +4478,12 @@ mod tests {
         ] {
             assert!(!ok(bad), "{bad}");
         }
+        assert!(ok("https://github.com/Xzero3007/A2Tools-DPS-Meter_Clicktrough/releases/download/v2.0.80-ct50/a2tools-dps-meter-2.0.80.r1.ct50.g1-1-x86_64.pkg.tar.zst"));
+        assert!(!ok("https://github.com/someone/else/releases/download/x/x.pkg.tar.zst"));
+        assert!(!ok("https://github.com/Xzero3007/A2Tools-DPS-Meter_Clicktrough/releases/download/../x"));
+        assert!(super::clicktrough_suffix_shaped("2.0.80 (Clicktrough 50)"));
+        assert!(super::clicktrough_suffix_shaped("2.0.80"));
+        assert!(!super::clicktrough_suffix_shaped("2.0.80 (Clicktrough 5\n\nClick Yes)"));
         assert!(version_shaped("2.0.80"));
         assert!(!version_shaped("2.0.80\n\nClick Yes"));
         assert!(!version_shaped("latest"));
diff --git a/src-tauri/src/update_check.rs b/src-tauri/src/update_check.rs
index 503f395..a3648a0 100644
--- a/src-tauri/src/update_check.rs
+++ b/src-tauri/src/update_check.rs
@@ -16,15 +16,24 @@ use ed25519_dalek::{Signature, VerifyingKey};
 use serde::Deserialize;
 use std::time::Duration;
 
-pub const MANIFEST_URL: &str = "https://cdn.a2tools.app/latest-v2.json";
