     let some = |s: String| Some(s).filter(|s| !s.is_empty());
     let yes = show_update_window(
         app,
@@ -1665,13 +1671,13 @@ async fn show_update_window(
     // our CDN, and only version-shaped text in the dialog (security audit H1,
