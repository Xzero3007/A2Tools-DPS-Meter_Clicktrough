+// This build updates from the Clicktrough fork, which rebuilds each release
+// of the meter with its patches (the lock for every window, windows that keep
+// their place): the official package would replace them. The fork's release
+// workflow writes this manifest for each of its releases.
+pub const MANIFEST_URL: &str = "https://github.com/Xzero3007/A2Tools-DPS-Meter_Clicktrough/releases/latest/download/latest-v2.json";
+
+/// The fork's build of this version, so a newer build of the same version is
+/// an update too. Its release workflow sets it; 0 for a build of its own.
+pub const CT_REVISION: u64 = 0;
 
 /// The update key's public half (Ed25519), made 2026-10-27. The private
 /// half is kept off the repository, on the publisher's PC.
+#[cfg_attr(not(test), allow(dead_code))]
 const UPDATE_PUBLIC_KEY_HEX: &str = "dab40e70aa5e31e705c0b4b178d17c8a40859bec4aa2dcc9cff088b958b5c020";
 
 /// Whether a manifest without a signature is refused. Off for 2.0.80, which
 /// starts the signing; on once meters that check are out.
+#[allow(dead_code)]
 const REQUIRE_SIGNATURE: bool = false;
 
 const TIMEOUT: Duration = Duration::from_secs(15);
@@ -51,6 +60,9 @@ pub struct Manifest {
     pub deb_sha256: String,
     #[serde(default)]
     pub rpm_sha256: String,
+    /// The fork's build of `version` (its release workflow's run number).
+    #[serde(default)]
+    pub revision: u64,
 }
 
 /// Fetch the manifest and check it: its signature (when there is one, or
@@ -60,11 +72,9 @@ pub async fn fetch(client: &reqwest::Client) -> Result<Manifest, String> {
     if body.len() > MAX_MANIFEST {
         return Err("the update manifest is too big".into());
     }
-    match get(client, SIGNATURE_URL).await? {
-        Some(sig) => verify(UPDATE_PUBLIC_KEY_HEX, &body, String::from_utf8_lossy(&sig).trim())?,
-        None if REQUIRE_SIGNATURE => return Err("the update manifest is not signed".into()),
-        None => tracing::warn!("Update: the manifest has no signature (accepted in this version)"),
-    }
+    // The fork's manifest isn't signed with the original's key (that key
+    // would refuse it): it comes over HTTPS from the fork's own releases, at
+    // the fixed address above, and names packages there with their SHA-256.
     serde_json::from_slice(&body).map_err(|e| format!("update manifest: {e}"))
 }
 
@@ -82,6 +92,7 @@ async fn get(client: &reqwest::Client, url: &str) -> Result<Option<Vec<u8>>, Str
 }
 
 /// Check `body`'s Ed25519 signature (hex) with `key_hex`.
+#[cfg_attr(not(test), allow(dead_code))]
 fn verify(key_hex: &str, body: &[u8], signature_hex: &str) -> Result<(), String> {
     let key: [u8; 32] = hex(key_hex).and_then(|k| k.try_into().ok()).ok_or("this build has no update key")?;
     let key = VerifyingKey::from_bytes(&key).map_err(|_| "the update key is not valid")?;
@@ -92,6 +103,7 @@ fn verify(key_hex: &str, body: &[u8], signature_hex: &str) -> Result<(), String>
         .map_err(|_| "the update manifest's signature does not match: not updating from it".to_string())
 }
 
+#[cfg_attr(not(test), allow(dead_code))]
 fn hex(text: &str) -> Option<Vec<u8>> {
     if !text.len().is_multiple_of(2) {
         return None;
@@ -99,6 +111,16 @@ fn hex(text: &str) -> Option<Vec<u8>> {
     (0..text.len()).step_by(2).map(|i| u8::from_str_radix(text.get(i..i + 2)?, 16).ok()).collect()
 }
 
+/// Whether the manifest names an update for this build: a newer version, or
+/// a newer build of the fork for the same version (`revision`).
+pub fn update_for_this_build(latest: &str, revision: u64, current: &str) -> bool {
+    newer(latest, current) || (same_version(latest, current) && revision > CT_REVISION)
+}
+
+fn same_version(a: &str, b: &str) -> bool {
+    a.trim().trim_start_matches(['v', 'V']) == b.trim().trim_start_matches(['v', 'V'])
+}
+
 /// Whether `latest` is newer than `current` ("2.0.80" against "2.0.79"; a
 /// leading "v" and a "-pre" part are allowed, a release beats its
 /// pre-release). Anything unreadable is not newer: never a downgrade.
@@ -155,6 +177,14 @@ mod tests {
         assert!(!newer("2.0.80\n\nClick Yes", "2.0.79"));
     }
 
+    #[test]
+    fn a_newer_build_of_the_same_version_is_an_update() {
+        assert!(update_for_this_build("2.0.80", CT_REVISION + 1, "2.0.80"));
+        assert!(!update_for_this_build("2.0.80", CT_REVISION, "2.0.80"));
+        assert!(update_for_this_build("2.0.81", 0, "2.0.80"));
+        assert!(!update_for_this_build("2.0.79", 999, "2.0.80"));
+    }
+
     #[test]
     fn the_built_in_key_is_a_key() {
         let key: [u8; 32] = hex(UPDATE_PUBLIC_KEY_HEX).unwrap().try_into().unwrap();
