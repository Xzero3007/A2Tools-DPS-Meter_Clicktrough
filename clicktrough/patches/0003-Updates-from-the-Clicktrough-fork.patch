@@ -1717,11 +1723,25 @@ async fn show_update_window(
 /// An update package on our CDN, over https, with a plain path.
 #[cfg_attr(not(feature = "online"), allow(dead_code))]
 fn update_url_allowed(url: &str) -> bool {
-    url.strip_prefix("https://cdn.a2tools.app/").is_some_and(|path| {
+    // This build's packages: only the Clicktrough fork's releases, never the
+    // original's CDN.
+    const FORK: &str = "https://github.com/Xzero3007/A2Tools-DPS-Meter_Clicktrough/releases/download/";
+    url.strip_prefix(FORK).is_some_and(|path| {
         !path.is_empty() && !path.contains("..") && path.chars().all(|c| c.is_ascii_alphanumeric() || "/._-+".contains(c))
     })
 }
 
+/// What follows the version in the shown text: nothing, or " (Clicktrough N)".
+#[cfg_attr(not(feature = "online"), allow(dead_code))]
+fn clicktrough_suffix_shaped(shown: &str) -> bool {
+    match shown.split_once(" (Clicktrough ") {
+        None => true,
+        Some((_, rest)) => rest
+            .strip_suffix(')')
+            .is_some_and(|n| (1..=10).contains(&n.len()) && n.bytes().all(|b| b.is_ascii_digit())),
+    }
+}
+
 /// "2.0.80": digits and dots, short.
 #[cfg_attr(not(feature = "online"), allow(dead_code))]
 fn version_shaped(v: &str) -> bool {
@@ -4446,9 +4466,9 @@ mod tests {
