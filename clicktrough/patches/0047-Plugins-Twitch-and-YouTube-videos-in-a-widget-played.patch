+    #[test]
+    fn freetube_subscriptions_from_its_profiles_file() {
+        let text = [
+            r#"{"name":"All Channels","subscriptions":[{"id":"UC0123456789012345678901","name":"Old","thumbnail":""}],"_id":"allChannels"}"#,
+            r#"{"name":"All Channels","subscriptions":[{"id":"UC0123456789012345678901","name":"Guides","thumbnail":"https://yt3.ggpht.com/a"},{"id":"bad","name":"x"}],"_id":"allChannels"}"#,
+            r#"{"name":"Games","subscriptions":[{"id":"UC0123456789012345678901","name":"Guides"},{"id":"UCabcdefghijabcdefghijab","name":"Second"}],"_id":"p2"}"#,
+            r#"{"name":"Gone","subscriptions":[{"id":"UCzzzzzzzzzzzzzzzzzzzzzz","name":"Gone"}],"_id":"p3"}"#,
+            r#"{"$$deleted":true,"_id":"p3"}"#,
+            "not json",
+        ].join("\n");
+        let subs = freetube_subscriptions(&text);
+        let names: Vec<&str> = subs.as_array().unwrap().iter().map(|s| s["name"].as_str().unwrap()).collect();
+        assert_eq!(names, ["Guides", "Second"]);
+    }
