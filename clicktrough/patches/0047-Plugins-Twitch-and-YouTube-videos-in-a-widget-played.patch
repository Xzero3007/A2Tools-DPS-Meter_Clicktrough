diff --git a/src-tauri/src/plugins/video.rs b/src-tauri/src/plugins/video.rs
new file mode 100644
index 0000000..0edd22b
--- /dev/null
+++ b/src-tauri/src/plugins/video.rs
@@ -0,0 +1,994 @@
+//! Clicktrough: video in a plugin's widget, and the lists to pick it from
+//! (the Streams plugin; permission "video").
+//!
+//! A plugin plays a Twitch channel or a YouTube video in one of its widgets
+//! (`a2.video.play`): mpv's library (libmpv, loaded at run time) plays it
+//! and draws each frame into the widget's window, under the widget's page.
+//! So the video is an overlay like the others: above the game, and locked,
+//! clicks go through it. mpv fetches the stream itself, with yt-dlp, as the
+//! player's own mpv would: only a Twitch channel's or a YouTube video's
+//! address is ever handed to it, built here from the name or id.
+//!
+//! The lists: Twitch's channels and live streams from Twitch's public API
+//! (gql.twitch.tv, the queries below, read only, no account), YouTube's
+//! search through yt-dlp, a channel's newest videos from its public feed
+//! (www.youtube.com/feeds/videos.xml), and the player's subscriptions from
+//! FreeTube's own file on this computer (read only). Nothing else is read,
+//! and nothing is sent but the search words, channel names and ids.
+
+use std::path::PathBuf;
+use std::time::Duration;
+
+use serde_json::{json, Value};
+
+use super::{require, widgets, window_plugin};
+
+/// What a plugin may play, as the address mpv gets: a Twitch channel by its
+/// login (letters, digits, `_`, at most 25), or a YouTube video by its id
+/// (11 letters, digits, `-`, `_`). Nothing else.
+pub fn stream_url(kind: &str, id: &str) -> Result<String, String> {
+    match kind {
+        "twitch" if !id.is_empty() && id.len() <= 25 && id.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') => {
+            Ok(format!("https://www.twitch.tv/{}", id.to_ascii_lowercase()))
+        }
+        "youtube" if id.len() == 11 && id.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_') => {
+            Ok(format!("https://www.youtube.com/watch?v={id}"))
+        }
+        "twitch" | "youtube" => Err("not a channel or video name".into()),
+        _ => Err("only Twitch and YouTube play".into()),
+    }
+}
+
+/// yt-dlp's format for a quality the player picked: the best up to that
+/// height (a stream with its sound, or video and sound joined), or sound only.
+pub fn ytdl_format(quality: &str) -> String {
+    match quality {
+        "audio" => "bestaudio/best".to_string(),
+        q => match q.parse::<u32>() {
+            Ok(h) if (144..=2160).contains(&h) => {
+                format!("bestvideo[height<=?{h}]+bestaudio/best[height<=?{h}]/best")
+            }
+            _ => "bestvideo[height<=?1080]+bestaudio/best".to_string(),
+        },
+    }
+}
+
+/// A YouTube channel id: `UC` and 22 more.
+fn valid_channel_id(id: &str) -> bool {
+    id.len() == 24 && id.starts_with("UC") && id.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')
+}
+
+fn valid_login(login: &str) -> bool {
+    !login.is_empty() && login.len() <= 25 && login.chars().all(|c| c.is_ascii_alphanumeric() || c == '_')
+}
+
+/// The widget window a plugin plays in: one of its own, open.
+fn widget_window(app: &tauri::AppHandle, id: &str, name: &str) -> Result<tauri::WebviewWindow, String> {
+    use tauri::Manager;
+    app.get_webview_window(&widgets::label(id, name)).ok_or_else(|| "open the widget first".to_string())
+}
+
+/// `a2.video.play(widget, { twitch | youtube, quality, volume })`.
+#[tauri::command]
+pub async fn plugin_video_play(
+    app: tauri::AppHandle,
+    window: tauri::WebviewWindow,
+    plugin: Option<String>,
+    widget: String,
+    kind: String,
+    name: String,
+    quality: Option<String>,
+    volume: Option<f64>,
+) -> Result<(), String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, "video")?;
+    let url = stream_url(&kind, &name)?;
+    let target = widget_window(&app, &id, &widget)?;
+    let format = ytdl_format(quality.as_deref().unwrap_or("1080"));
+    let volume = volume.filter(|v| v.is_finite()).unwrap_or(70.0).clamp(0.0, 100.0);
+    tracing::info!("Video: {id} plays {kind} {name} in {widget}");
+    player::play(&app, &id, &target, &url, &format, volume)
+}
+
+/// `a2.video.control(widget, { pause, volume, mute, opacity, stop })`.
+#[tauri::command]
+pub fn plugin_video_control(
+    app: tauri::AppHandle,
+    window: tauri::WebviewWindow,
+    plugin: Option<String>,
+    widget: String,
+    action: String,
+    value: Option<Value>,
+) -> Result<(), String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, "video")?;
+    let label = widgets::label(&id, &widget);
+    match action.as_str() {
+        "stop" => player::stop(&app, &label),
+        "pause" => player::set(&label, "pause", if value.and_then(|v| v.as_bool()).unwrap_or(true) { "yes" } else { "no" }),
+        "mute" => player::set(&label, "mute", if value.and_then(|v| v.as_bool()).unwrap_or(true) { "yes" } else { "no" }),
+        "volume" => {
+            let v = value.and_then(|v| v.as_f64()).filter(|v| v.is_finite()).ok_or("not a volume")?;
+            player::set(&label, "volume", &format!("{:.0}", v.clamp(0.0, 100.0)))
+        }
+        // How much of the video shows: 0.2 to 1 (the widget's page stays as it is).
+        "opacity" => {
+            let v = value.and_then(|v| v.as_f64()).filter(|v| v.is_finite()).ok_or("not an opacity")?;
+            player::opacity(&app, &label, v.clamp(0.2, 1.0))
+        }
+        _ => Err("unknown video control".into()),
+    }
+}
+
+/// The Twitch queries a plugin may run: `search` (channels by name),
+/// `channels` (these logins, live or not), `live` (the live streams with
+/// the most viewers, of one game or all). Twitch's public API, the client
+/// id its own web page uses; no account.
+pub fn twitch_query(kind: &str, arg: &Value) -> Result<Value, String> {
+    const USER: &str = "login displayName profileImageURL(width: 70) \
+        stream { title viewersCount createdAt previewImageURL(width: 320, height: 180) game { displayName } }";
+    const STREAM: &str = "title viewersCount createdAt previewImageURL(width: 320, height: 180) game { displayName } \
+        broadcaster { login displayName profileImageURL(width: 70) }";
+    match kind {
+        "search" => {
+            let text = arg.as_str().map(str::trim).filter(|t| !t.is_empty() && t.len() <= 100).ok_or("no search words")?;
+            Ok(json!({
+                "query": format!("query($q: String!) {{ searchFor(userQuery: $q, platform: \"web\") {{ channels {{ items {{ {USER} }} }} }} }}"),
+                "variables": { "q": text },
+            }))
+        }
+        "user" => {
+            let login = arg.as_str().map(str::trim).filter(|l| valid_login(l)).ok_or("not a channel name")?;
+            Ok(json!({
+                "query": format!("query($l: String!) {{ user(login: $l) {{ {USER} }} }}"),
+                "variables": { "l": login.to_ascii_lowercase() },
+            }))
+        }
+        "channels" => {
+            let logins: Vec<String> = arg.as_array().ok_or("no channels")?.iter()
+                .filter_map(|l| l.as_str()).filter(|l| valid_login(l)).map(str::to_ascii_lowercase).take(100).collect();
+            Ok(json!({
+                "query": format!("query($l: [String!]) {{ users(logins: $l) {{ {USER} }} }}"),
+                "variables": { "l": logins },
+            }))
+        }
+        "live" => match arg.as_str().map(str::trim).filter(|g| !g.is_empty()) {
+            Some(game) if game.len() <= 100 => Ok(json!({
+                "query": format!("query($g: String!) {{ game(name: $g) {{ streams(first: 30) {{ edges {{ node {{ {STREAM} }} }} }} }} }}"),
+                "variables": { "g": game },
+            })),
+            Some(_) => Err("not a game".into()),
+            None => Ok(json!({
+                "query": format!("query {{ streams(first: 30) {{ edges {{ node {{ {STREAM} }} }} }} }}"),
+            })),
+        },
+        _ => Err("unknown Twitch query".into()),
+    }
+}
+
+/// `a2.video.twitch(kind, arg)`: Twitch's answer (its `data`).
+#[tauri::command]
+pub async fn plugin_video_twitch(
+    app: tauri::AppHandle,
+    window: tauri::WebviewWindow,
+    plugin: Option<String>,
+    kind: String,
+    arg: Value,
+) -> Result<Value, String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, "video")?;
+    let body = twitch_query(&kind, &arg)?;
+    net::twitch(&app, body).await
+}
+
+/// `a2.video.feed(channelId)`: a YouTube channel's newest videos, its public
+/// feed (Atom XML) as it is.
+#[tauri::command]
+pub async fn plugin_video_feed(
+    app: tauri::AppHandle,
+    window: tauri::WebviewWindow,
+    plugin: Option<String>,
+    channel: String,
+) -> Result<String, String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, "video")?;
+    if !valid_channel_id(&channel) {
+        return Err("not a YouTube channel id".into());
+    }
+    net::text(&app, &format!("https://www.youtube.com/feeds/videos.xml?channel_id={channel}")).await
+}
+
+/// `a2.video.search(text)`: YouTube's search, through yt-dlp: the first 20
+/// videos (id, title, channel, length, views).
+#[tauri::command]
+pub async fn plugin_video_search(
+    app: tauri::AppHandle,
+    window: tauri::WebviewWindow,
+    plugin: Option<String>,
+    text: String,
+) -> Result<Value, String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, "video")?;
+    let text = text.trim().replace(['\n', '\r'], " ");
+    if text.is_empty() || text.len() > 100 {
+        return Err("no search words".into());
+    }
+    let out = tokio::time::timeout(
+        Duration::from_secs(40),
+        tokio::process::Command::new("yt-dlp")
+            .args(["--ignore-config", "--no-warnings", "--flat-playlist", "--dump-single-json", "--"])
+            .arg(format!("ytsearch20:{text}"))
+            .kill_on_drop(true)
+            .output(),
+    )
+    .await
+    .map_err(|_| "YouTube didn't answer in time".to_string())?
+    .map_err(|e| if e.kind() == std::io::ErrorKind::NotFound { "yt-dlp is not installed".to_string() } else { e.to_string() })?;
+    if !out.status.success() {
+        let err = String::from_utf8_lossy(&out.stderr);
+        return Err(err.lines().rev().find(|l| !l.trim().is_empty()).unwrap_or("yt-dlp failed").chars().take(300).collect());
+    }
+    let all: Value = serde_json::from_slice(&out.stdout).map_err(|e| e.to_string())?;
+    Ok(search_entries(&all))
+}
+
+/// yt-dlp's search answer, cut to what a list shows.
+pub fn search_entries(all: &Value) -> Value {
+    let entries = all.get("entries").and_then(Value::as_array).cloned().unwrap_or_default();
+    Value::Array(entries.iter().filter_map(|e| {
+        let id = e.get("id")?.as_str()?;
+        if stream_url("youtube", id).is_err() {
+            return None;
+        }
+        Some(json!({
+            "id": id,
+            "title": e.get("title").and_then(Value::as_str).unwrap_or(""),
+            "channel": e.get("channel").or_else(|| e.get("uploader")).and_then(Value::as_str).unwrap_or(""),
+            "channelId": e.get("channel_id").and_then(Value::as_str).unwrap_or(""),
+            "duration": e.get("duration").and_then(Value::as_f64),
+            "views": e.get("view_count").and_then(Value::as_u64),
+            "live": e.get("live_status").and_then(Value::as_str) == Some("is_live"),
+        }))
+    }).collect())
+}
+
+/// Where FreeTube keeps its profiles: its own folder, or the Flatpak's.
+fn freetube_files() -> Vec<PathBuf> {
+    let home = std::env::var_os("HOME").map(PathBuf::from).unwrap_or_default();
+    let config = std::env::var_os("XDG_CONFIG_HOME").map(PathBuf::from).unwrap_or_else(|| home.join(".config"));
+    vec![
+        config.join("FreeTube").join("profiles.db"),
+        home.join(".var/app/io.freetubeapp.FreeTube/config/FreeTube/profiles.db"),
+    ]
+}
+
+/// FreeTube's subscriptions out of its profiles file (NeDB: one JSON
+/// document a line, a later line of the same `_id` replacing an earlier
+/// one): every profile's channels, each once.
+pub fn freetube_subscriptions(text: &str) -> Value {
+    let mut profiles: Vec<(String, Value)> = Vec::new();
+    for line in text.lines() {
+        let Ok(doc) = serde_json::from_str::<Value>(line) else { continue };
+        let Some(key) = doc.get("_id").and_then(Value::as_str).map(str::to_string) else { continue };
+        profiles.retain(|(k, _)| *k != key);
+        if doc.get("$$deleted").and_then(Value::as_bool) != Some(true) {
+            profiles.push((key, doc));
+        }
+    }
+    let mut seen = std::collections::HashSet::new();
+    let mut out = Vec::new();
+    for (_, profile) in &profiles {
+        for sub in profile.get("subscriptions").and_then(Value::as_array).into_iter().flatten() {
+            let Some(id) = sub.get("id").and_then(Value::as_str) else { continue };
+            if valid_channel_id(id) && seen.insert(id.to_string()) {
+                out.push(json!({
+                    "id": id,
+                    "name": sub.get("name").and_then(Value::as_str).unwrap_or(id),
+                    "thumbnail": sub.get("thumbnail").and_then(Value::as_str).unwrap_or(""),
+                }));
+            }
+        }
+    }
+    Value::Array(out)
+}
+
+/// `a2.video.freetube()`: FreeTube's subscriptions on this computer, or
+/// null when FreeTube isn't there.
+#[tauri::command]
+pub fn plugin_video_freetube(app: tauri::AppHandle, window: tauri::WebviewWindow, plugin: Option<String>) -> Result<Value, String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, "video")?;
+    for file in freetube_files() {
+        if let Ok(text) = std::fs::read_to_string(&file) {
+            return Ok(freetube_subscriptions(&text));
+        }
+    }
+    Ok(Value::Null)
+}
