+    #[test]
+    fn only_a_twitch_channel_or_a_youtube_video_plays() {
+        assert_eq!(stream_url("twitch", "Some_Streamer").as_deref(), Ok("https://www.twitch.tv/some_streamer"));
+        assert_eq!(stream_url("youtube", "dQw4w9WgXcQ").as_deref(), Ok("https://www.youtube.com/watch?v=dQw4w9WgXcQ"));
+        for (kind, id) in [
+            ("twitch", ""), ("twitch", "a/b"), ("twitch", "x?y=1"), ("twitch", "--option"),
+            ("twitch", "a_very_long_channel_name_over_25"),
+            ("youtube", "short"), ("youtube", "dQw4w9WgXc?"), ("youtube", "../../etc/pa"),
+            ("file", "dQw4w9WgXcQ"), ("https", "//example.com"),
+        ] {
+            assert!(stream_url(kind, id).is_err(), "{kind} {id}");
+        }
+    }
+
+    #[test]
+    fn a_quality_is_a_height_or_sound_only() {
+        assert_eq!(ytdl_format("720"), "bestvideo[height<=?720]+bestaudio/best[height<=?720]/best");
+        assert_eq!(ytdl_format("audio"), "bestaudio/best");
+        assert!(ytdl_format("; rm -rf").contains("1080"));
+    }
+
+    #[test]
+    fn twitch_queries_carry_the_words_as_variables() {
+        let q = twitch_query("search", &json!("aion \" }")).unwrap();
+        assert_eq!(q["variables"]["q"], "aion \" }");
+        assert!(!q["query"].as_str().unwrap().contains("aion"));
+        let q = twitch_query("channels", &json!(["Good_One", "bad/one", "x"])).unwrap();
+        assert_eq!(q["variables"]["l"], json!(["good_one", "x"]));
+        assert!(twitch_query("live", &json!(null)).unwrap().get("variables").is_none());
+        assert_eq!(twitch_query("live", &json!("AION 2")).unwrap()["variables"]["g"], "AION 2");
+        assert!(twitch_query("mutation", &json!("x")).is_err());
+        assert!(twitch_query("search", &json!("")).is_err());
+    }
