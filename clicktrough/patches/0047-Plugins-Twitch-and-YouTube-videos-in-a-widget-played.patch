+/// The two requests, through the meter's client (net_guard's list).
+#[cfg(feature = "net")]
+mod net {
+    use super::*;
+    use crate::app::AppState;
+    use tauri::Manager;
+
+    /// The client id Twitch's own web page uses, as other players do.
+    const TWITCH_CLIENT_ID: &str = "kimne78kx3ncx6brgo4mv6wki5h1ko";
+
+    async fn wait_turn() {
+        static NEXT: std::sync::OnceLock<tokio::sync::Mutex<std::time::Instant>> = std::sync::OnceLock::new();
+        let mut next = NEXT.get_or_init(|| tokio::sync::Mutex::new(std::time::Instant::now())).lock().await;
+        let now = std::time::Instant::now();
+        if *next > now {
+            tokio::time::sleep(*next - now).await;
+        }
+        *next = std::time::Instant::now() + Duration::from_millis(250);
+    }
+
+    pub async fn twitch(app: &tauri::AppHandle, body: Value) -> Result<Value, String> {
+        const URL: &str = "https://gql.twitch.tv/gql";
+        wait_turn().await;
+        crate::net_guard::check(URL)?;
+        let state = app.try_state::<AppState>().ok_or("no app state")?;
+        let res = state.http.post(URL)
+            .header("Client-Id", TWITCH_CLIENT_ID)
+            .header("Content-Type", "application/json")
+            .body(body.to_string())
+            .timeout(Duration::from_secs(20))
+            .send().await
+            .map_err(|e| format!("Twitch: {}", super::super::web_error(&e)))?;
+        if !res.status().is_success() {
+            return Err(format!("Twitch answered {}", res.status()));
+        }
+        let bytes = res.bytes().await.map_err(|e| e.to_string())?;
+        let answer: Value = serde_json::from_slice(&bytes).map_err(|e| e.to_string())?;
+        if let Some(err) = answer.get("errors").and_then(|e| e.get(0)).and_then(|e| e.get("message")).and_then(Value::as_str) {
+            if answer.get("data").map_or(true, Value::is_null) {
+                return Err(format!("Twitch: {err}"));
+            }
+        }
+        Ok(answer.get("data").cloned().unwrap_or(Value::Null))
+    }
+
+    pub async fn text(app: &tauri::AppHandle, url: &str) -> Result<String, String> {
+        wait_turn().await;
+        crate::net_guard::check(url)?;
+        let state = app.try_state::<AppState>().ok_or("no app state")?;
+        let res = state.http.get(url).timeout(Duration::from_secs(20)).send().await.map_err(|e| super::super::web_error(&e))?;
+        if !res.status().is_success() {
+            return Err(format!("YouTube answered {}", res.status()));
+        }
+        let bytes = res.bytes().await.map_err(|e| e.to_string())?;
+        if bytes.len() > 2 * 1024 * 1024 {
+            return Err("the answer is too large".into());
+        }
+        Ok(String::from_utf8_lossy(&bytes).into_owned())
+    }
+}
