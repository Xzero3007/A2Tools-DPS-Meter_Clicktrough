+/// libmpv, loaded at run time, drawing into a GL area under the widget's
+/// page (a GTK overlay: the video below, the page above it, transparent).
+#[cfg(target_os = "linux")]
+mod player {
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    use std::ffi::{c_char, c_int, c_void, CStr, CString};
+    use std::sync::{Mutex, OnceLock};
+
+    use gtk::prelude::*;
+    use serde_json::json;
+
+    type Handle = *mut c_void;
+
+    #[repr(C)]
+    struct Event {
+        event_id: c_int,
+        error: c_int,
+        reply_userdata: u64,
+        data: *mut c_void,
+    }
+    #[repr(C)]
+    struct EventProperty {
+        name: *const c_char,
+        format: c_int,
+        data: *mut c_void,
+    }
+    #[repr(C)]
+    struct EventEndFile {
+        reason: c_int,
+        error: c_int,
+    }
+    #[repr(C)]
+    struct RenderParam {
+        kind: c_int,
+        data: *mut c_void,
+    }
+    #[repr(C)]
+    struct GlInitParams {
+        get_proc_address: extern "C" fn(*mut c_void, *const c_char) -> *mut c_void,
+        ctx: *mut c_void,
+    }
+    #[repr(C)]
+    struct GlFbo {
+        fbo: c_int,
+        w: c_int,
+        h: c_int,
+        internal_format: c_int,
+    }
+
+    const EVENT_SHUTDOWN: c_int = 1;
+    const EVENT_START_FILE: c_int = 6;
+    const EVENT_END_FILE: c_int = 7;
+    const EVENT_FILE_LOADED: c_int = 8;
+    const EVENT_PLAYBACK_RESTART: c_int = 21;
+    const EVENT_PROPERTY_CHANGE: c_int = 22;
+    const FORMAT_STRING: c_int = 1;
+    const FORMAT_FLAG: c_int = 3;
+    const FORMAT_DOUBLE: c_int = 5;
+    const END_ERROR: c_int = 4;
+    const END_EOF: c_int = 0;
+    const PARAM_API_TYPE: c_int = 1;
+    const PARAM_GL_INIT: c_int = 2;
+    const PARAM_GL_FBO: c_int = 3;
+    const PARAM_FLIP_Y: c_int = 4;
+    const PARAM_X11_DISPLAY: c_int = 8;
+    const PARAM_WL_DISPLAY: c_int = 9;
+
+    /// libmpv's calls, from the library found at run time.
+    struct Mpv {
+        _lib: libloading::Library,
+        create: unsafe extern "C" fn() -> Handle,
+        initialize: unsafe extern "C" fn(Handle) -> c_int,
+        set_option_string: unsafe extern "C" fn(Handle, *const c_char, *const c_char) -> c_int,
+        set_property_string: unsafe extern "C" fn(Handle, *const c_char, *const c_char) -> c_int,
+        command: unsafe extern "C" fn(Handle, *const *const c_char) -> c_int,
+        observe_property: unsafe extern "C" fn(Handle, u64, *const c_char, c_int) -> c_int,
+        wait_event: unsafe extern "C" fn(Handle, f64) -> *mut Event,
+        terminate_destroy: unsafe extern "C" fn(Handle),
+        error_string: unsafe extern "C" fn(c_int) -> *const c_char,
+        render_create: unsafe extern "C" fn(*mut Handle, Handle, *mut RenderParam) -> c_int,
+        render_set_update_callback: unsafe extern "C" fn(Handle, Option<extern "C" fn(*mut c_void)>, *mut c_void),
+        render_render: unsafe extern "C" fn(Handle, *mut RenderParam) -> c_int,
+        render_free: unsafe extern "C" fn(Handle),
+    }
+    unsafe impl Send for Mpv {}
+    unsafe impl Sync for Mpv {}
+
+    fn mpv() -> Result<&'static Mpv, String> {
+        static MPV: OnceLock<Result<Mpv, String>> = OnceLock::new();
+        MPV.get_or_init(|| unsafe {
+            let lib = ["libmpv.so.2", "libmpv.so.1", "libmpv.so"].iter()
+                .find_map(|n| libloading::Library::new(n).ok())
+                .ok_or("mpv is not installed (its library libmpv was not found)")?;
+            macro_rules! f {
+                ($name:literal) => {
+                    *lib.get(concat!($name, "\0").as_bytes()).map_err(|e| format!("libmpv: {e}"))?
+                };
+            }
+            Ok(Mpv {
+                create: f!("mpv_create"),
+                initialize: f!("mpv_initialize"),
+                set_option_string: f!("mpv_set_option_string"),
+                set_property_string: f!("mpv_set_property_string"),
+                command: f!("mpv_command"),
+                observe_property: f!("mpv_observe_property"),
+                wait_event: f!("mpv_wait_event"),
+                terminate_destroy: f!("mpv_terminate_destroy"),
+                error_string: f!("mpv_error_string"),
+                render_create: f!("mpv_render_context_create"),
+                render_set_update_callback: f!("mpv_render_context_set_update_callback"),
+                render_render: f!("mpv_render_context_render"),
+                render_free: f!("mpv_render_context_free"),
+                _lib: lib,
+            })
+        }).as_ref().map_err(Clone::clone)
+    }
+
+    fn error(code: c_int) -> String {
+        mpv().ok().map(|m| unsafe { CStr::from_ptr((m.error_string)(code)) }.to_string_lossy().into_owned())
+            .unwrap_or_else(|| format!("mpv error {code}"))
+    }
+
+    /// GL's functions by name, for mpv: EGL's lookup (Wayland, and X11
+    /// where GTK uses EGL), else GLX's.
+    extern "C" fn get_proc_address(_: *mut c_void, name: *const c_char) -> *mut c_void {
+        type Lookup = unsafe extern "C" fn(*const c_char) -> *mut c_void;
+        static LOOKUPS: OnceLock<Vec<(libloading::Library, Lookup)>> = OnceLock::new();
+        let lookups = LOOKUPS.get_or_init(|| unsafe {
+            let mut out = Vec::new();
+            for (lib, sym) in [("libEGL.so.1", "eglGetProcAddress\0"), ("libGL.so.1", "glXGetProcAddressARB\0")] {
+                if let Ok(l) = libloading::Library::new(lib) {
+                    if let Ok(f) = l.get::<Lookup>(sym.as_bytes()) {
+                        let f = *f;
+                        out.push((l, f));
+                    }
+                }
+            }
+            out
+        });
+        let egl_current = egl_context_current();
+        for (i, (_, lookup)) in lookups.iter().enumerate() {
+            // EGL's first when an EGL context is current, GLX's otherwise.
+            if (i == 0) != egl_current && lookups.len() > 1 {
+                continue;
+            }
+            let p = unsafe { lookup(name) };
+            if !p.is_null() {
+                return p;
+            }
+        }
+        std::ptr::null_mut()
+    }
+
+    fn egl_context_current() -> bool {
+        type Current = unsafe extern "C" fn() -> *mut c_void;
+        static F: OnceLock<Option<(libloading::Library, Current)>> = OnceLock::new();
+        F.get_or_init(|| unsafe {
+            let l = libloading::Library::new("libEGL.so.1").ok()?;
+            let f = *l.get::<Current>(b"eglGetCurrentContext\0").ok()?;
+            Some((l, f))
+        }).as_ref().is_some_and(|(_, f)| !unsafe { f() }.is_null())
+    }
+
+    /// The display GTK draws on, for mpv's hardware decoding.
+    fn display_param() -> Option<(c_int, *mut c_void)> {
+        let display = gtk::gdk::Display::default()?;
+        let raw = display.as_ptr() as *mut c_void;
+        type Get = unsafe extern "C" fn(*mut c_void) -> *mut c_void;
+        let lib = unsafe { libloading::Library::new("libgdk-3.so.0") }.ok()?;
+        let name = display.type_().name();
+        let (kind, sym): (c_int, &[u8]) = if name.contains("Wayland") {
+            (PARAM_WL_DISPLAY, b"gdk_wayland_display_get_wl_display\0")
+        } else if name.contains("X11") {
+            (PARAM_X11_DISPLAY, b"gdk_x11_display_get_xdisplay\0")
+        } else {
+            return None;
+        };
+        let get = unsafe { lib.get::<Get>(sym) }.ok()?;
+        let p = unsafe { get(raw) };
+        (!p.is_null()).then_some((kind, p))
+    }
+
+    /// One player: its mpv (any thread may use it until it is told to
+    /// quit) and the plugin it tells.
+    struct Player {
+        handle: usize,
+    }
+
+    fn players() -> &'static Mutex<HashMap<String, Player>> {
+        static P: OnceLock<Mutex<HashMap<String, Player>>> = OnceLock::new();
+        P.get_or_init(Mutex::default)
+    }
+
+    /// On GTK's thread: each widget's GL area and its render context.
+    struct View {
+        area: gtk::GLArea,
+        render: Handle,
+        label: Box<String>,
+    }
+    thread_local! {
+        static VIEWS: RefCell<HashMap<String, View>> = RefCell::new(HashMap::new());
+    }
+
+    fn handle_of(label: &str) -> Option<Handle> {
+        players().lock().unwrap_or_else(|p| p.into_inner()).get(label).map(|p| p.handle as Handle)
+    }
+
+    pub fn set(label: &str, name: &str, value: &str) -> Result<(), String> {
+        let m = mpv()?;
+        let h = handle_of(label).ok_or("no video is playing")?;
+        let (n, v) = (CString::new(name).map_err(|e| e.to_string())?, CString::new(value).map_err(|e| e.to_string())?);
+        match unsafe { (m.set_property_string)(h, n.as_ptr(), v.as_ptr()) } {
+            0 => Ok(()),
+            e => Err(error(e)),
+        }
+    }
+
+    fn command(h: Handle, args: &[&str]) -> Result<(), String> {
+        let m = mpv()?;
+        let owned: Vec<CString> = args.iter().map(|a| CString::new(*a).map_err(|e| e.to_string())).collect::<Result<_, _>>()?;
+        let mut ptrs: Vec<*const c_char> = owned.iter().map(|s| s.as_ptr()).collect();
+        ptrs.push(std::ptr::null());
+        match unsafe { (m.command)(h, ptrs.as_ptr()) } {
+            0 => Ok(()),
+            e => Err(error(e)),
+        }
+    }
+
+    fn tell(app: &tauri::AppHandle, id: &str, widget: &str, data: serde_json::Value) {
+        let mut data = data;
+        data["widget"] = json!(widget);
+        super::super::emit_plugin(app, id, json!({ "plugin": id, "event": "video", "data": data }));
+    }
+
+    /// A new mpv for widget `label`, told nothing yet; its events go to the
+    /// plugin until it shuts down.
+    fn start(app: &tauri::AppHandle, id: &str, label: &str, volume: f64) -> Result<Handle, String> {
+        let m = mpv()?;
+        // libmpv wants C's number format.
+        unsafe { libc::setlocale(libc::LC_NUMERIC, c"C".as_ptr()) };
+        let h = unsafe { (m.create)() };
+        if h.is_null() {
+            return Err("mpv could not start".into());
+        }
+        let opt = |k: &str, v: &str| {
+            let (k, v) = (CString::new(k).unwrap_or_default(), CString::new(v).unwrap_or_default());
+            unsafe { (m.set_option_string)(h, k.as_ptr(), v.as_ptr()) }
+        };
+        for (k, v) in [
+            ("config", "no"),
+            ("terminal", "no"),
+            ("vo", "libmpv"),
+            ("hwdec", "auto-safe"),
+            ("input-default-bindings", "no"),
+            ("input-vo-keyboard", "no"),
+            ("osc", "no"),
+            ("idle", "yes"),
+            ("keep-open", "no"),
+            ("ytdl", "yes"),
+            ("cache", "yes"),
+            ("demuxer-max-bytes", "64MiB"),
+            ("audio-client-name", "A2Tools Streams"),
+            ("title", "A2Tools Streams"),
+        ] {
+            opt(k, v);
+        }
+        opt("volume", &format!("{volume:.0}"));
+        let code = unsafe { (m.initialize)(h) };
+        if code < 0 {
+            unsafe { (m.terminate_destroy)(h) };
+            return Err(error(code));
+        }
+        for (name, format) in [("pause", FORMAT_FLAG), ("paused-for-cache", FORMAT_FLAG), ("media-title", FORMAT_STRING),
+                               ("volume", FORMAT_DOUBLE), ("mute", FORMAT_FLAG)] {
+            let n = CString::new(name).unwrap_or_default();
+            unsafe { (m.observe_property)(h, 0, n.as_ptr(), format) };
+        }
+        let (app, id) = (app.clone(), id.to_string());
+        let widget = super::widgets::parse_label(label).map(|(_, w)| w).unwrap_or_default();
+        let raw = h as usize;
+        std::thread::Builder::new().name("video-events".into()).spawn(move || {
+            let h = raw as Handle;
+            loop {
+                let ev = unsafe { &*(m.wait_event)(h, -1.0) };
+                match ev.event_id {
+                    EVENT_SHUTDOWN => break,
+                    EVENT_START_FILE => tell(&app, &id, &widget, json!({ "state": "loading" })),
+                    EVENT_FILE_LOADED | EVENT_PLAYBACK_RESTART => tell(&app, &id, &widget, json!({ "state": "playing" })),
+                    EVENT_END_FILE if !ev.data.is_null() => {
+                        let end = unsafe { &*(ev.data as *const EventEndFile) };
+                        match end.reason {
+                            END_ERROR => tell(&app, &id, &widget, json!({ "state": "error", "error": error(end.error) })),
+                            END_EOF => tell(&app, &id, &widget, json!({ "state": "ended" })),
+                            _ => {}
+                        }
+                    }
+                    EVENT_PROPERTY_CHANGE if !ev.data.is_null() => {
+                        let p = unsafe { &*(ev.data as *const EventProperty) };
+                        if p.data.is_null() {
+                            continue;
+                        }
+                        let name = unsafe { CStr::from_ptr(p.name) }.to_string_lossy().into_owned();
+                        let value = match p.format {
+                            FORMAT_FLAG => json!(unsafe { *(p.data as *const c_int) } != 0),
+                            FORMAT_DOUBLE => json!(unsafe { *(p.data as *const f64) }),
+                            FORMAT_STRING => json!(unsafe { CStr::from_ptr(*(p.data as *const *const c_char)) }.to_string_lossy()),
+                            _ => continue,
+                        };
+                        let key = match name.as_str() {
+                            "media-title" => "title",
+                            "paused-for-cache" => "buffering",
+                            other => other,
+                        };
+                        tell(&app, &id, &widget, json!({ key: value }));
+                    }
+                    _ => {}
+                }
+            }
+            unsafe { (m.terminate_destroy)(h) };
+        }).map_err(|e| e.to_string())?;
+        Ok(h)
+    }
+
+    extern "C" fn on_update(ctx: *mut c_void) {
+        // mpv's thread: draw again on GTK's.
+        let label = unsafe { &*(ctx as *const String) }.clone();
+        gtk::glib::MainContext::default().invoke(move || {
+            VIEWS.with(|v| {
+                if let Some(view) = v.borrow().get(&label) {
+                    view.area.queue_render();
+                }
+            });
+        });
+    }
+
+    /// The render context for widget `label`'s mpv, made with the area's GL
+    /// context current.
+    fn make_render(area: &gtk::GLArea, h: Handle, label_ptr: *mut c_void) -> Result<Handle, String> {
+        let m = mpv()?;
+        area.make_current();
+        if let Some(e) = area.error() {
+            return Err(format!("GL: {e}"));
+        }
+        let api = c"opengl";
+        let mut init = GlInitParams { get_proc_address, ctx: std::ptr::null_mut() };
+        let mut params = vec![
+            RenderParam { kind: PARAM_API_TYPE, data: api.as_ptr() as *mut c_void },
+            RenderParam { kind: PARAM_GL_INIT, data: &mut init as *mut _ as *mut c_void },
+        ];
+        if let Some((kind, p)) = display_param() {
+            params.push(RenderParam { kind, data: p });
+        }
+        params.push(RenderParam { kind: 0, data: std::ptr::null_mut() });
+        let mut render: Handle = std::ptr::null_mut();
+        match unsafe { (m.render_create)(&mut render, h, params.as_mut_ptr()) } {
+            0 => {
+                unsafe { (m.render_set_update_callback)(render, Some(on_update), label_ptr) };
+                Ok(render)
+            }
+            e => Err(error(e)),
+        }
+    }
+
+    fn draw(area: &gtk::GLArea, render: Handle) {
+        let Ok(m) = mpv() else { return };
+        type GetIntegerv = unsafe extern "C" fn(u32, *mut c_int);
+        static GET: OnceLock<usize> = OnceLock::new();
+        let get = *GET.get_or_init(|| get_proc_address(std::ptr::null_mut(), c"glGetIntegerv".as_ptr()) as usize);
+        let mut fbo: c_int = 0;
+        if get != 0 {
+            let f: GetIntegerv = unsafe { std::mem::transmute(get) };
+            const GL_FRAMEBUFFER_BINDING: u32 = 0x8CA6;
+            unsafe { f(GL_FRAMEBUFFER_BINDING, &mut fbo) };
+        }
+        let scale = area.scale_factor();
+        let mut target = GlFbo { fbo, w: area.allocated_width() * scale, h: area.allocated_height() * scale, internal_format: 0 };
+        let mut flip: c_int = 1;
+        let mut params = [
+            RenderParam { kind: PARAM_GL_FBO, data: &mut target as *mut _ as *mut c_void },
+            RenderParam { kind: PARAM_FLIP_Y, data: &mut flip as *mut _ as *mut c_void },
+            RenderParam { kind: 0, data: std::ptr::null_mut() },
+        ];
+        unsafe { (m.render_render)(render, params.as_mut_ptr()) };
+    }
+
+    /// The widget's window, its page put over a GL area: once per widget.
+    fn attach(window: &tauri::WebviewWindow, label: &str) -> Result<gtk::GLArea, String> {
+        if let Some(area) = VIEWS.with(|v| v.borrow().get(label).map(|v| v.area.clone())) {
+            return Ok(area);
+        }
+        let vbox = window.default_vbox().map_err(|e| e.to_string())?;
+        let page = vbox.children().into_iter()
+            .find(|c| c.type_().name().contains("WebView"))
+            .ok_or("the widget has no page")?;
+        vbox.remove(&page);
+        let overlay = gtk::Overlay::new();
+        let area = gtk::GLArea::new();
+        area.set_has_alpha(true);
+        area.set_auto_render(false);
+        overlay.add(&area);
+        overlay.add_overlay(&page);
+        vbox.pack_start(&overlay, true, true, 0);
+        overlay.show_all();
+        area.set_visible(false);
+        let key = label.to_string();
+        // The render context is made at the first draw, the area's GL
+        // context current: a widget just opened isn't on screen yet when
+        // its video starts, and a GL context made then drew nothing.
+        area.connect_render(move |area, _| {
+            let Some((mut render, ptr)) = VIEWS.with(|v| {
+                v.borrow().get(&key).map(|v| (v.render, &*v.label as *const String as *mut c_void))
+            }) else {
+                return gtk::glib::Propagation::Stop;
+            };
+            if render.is_null() {
+                if let Some(h) = handle_of(&key) {
+                    match make_render(area, h, ptr) {
+                        Ok(r) => {
+                            // Its own framebuffer again, whatever mpv bound.
+                            area.attach_buffers();
+                            render = r;
+                            VIEWS.with(|v| {
+                                if let Some(view) = v.borrow_mut().get_mut(&key) {
+                                    view.render = r;
+                                }
+                            });
+                        }
+                        Err(e) => tracing::warn!("Video: no picture ({e})"),
+                    }
+                }
+            }
+            if !render.is_null() {
+                draw(area, render);
+            }
+            gtk::glib::Propagation::Stop
+        });
+        let key = label.to_string();
+        area.connect_unrealize(move |area| free_render(area, &key));
+        VIEWS.with(|v| v.borrow_mut().insert(label.to_string(), View {
+            area: area.clone(),
+            render: std::ptr::null_mut(),
+            label: Box::new(label.to_string()),
+        }));
+        Ok(area)
+    }
+
+    /// The render context goes before its mpv: then mpv is told to quit,
+    /// and its event thread ends it.
+    fn free_render(area: &gtk::GLArea, label: &str) {
+        let render = VIEWS.with(|v| v.borrow_mut().get_mut(label).map(|v| std::mem::replace(&mut v.render, std::ptr::null_mut())));
+        if let (Some(r), Ok(m)) = (render, mpv()) {
+            if !r.is_null() {
+                area.make_current();
+                unsafe { (m.render_free)(r) };
+            }
+        }
+        if let Some(p) = players().lock().unwrap_or_else(|p| p.into_inner()).remove(label) {
+            let _ = command(p.handle as Handle, &["quit"]);
+        }
+    }
+
+    pub fn play(app: &tauri::AppHandle, id: &str, window: &tauri::WebviewWindow, url: &str, format: &str, volume: f64) -> Result<(), String> {
+        mpv()?;
+        let label = window.label().to_string();
+        let (app2, id, window, url, format) = (app.clone(), id.to_string(), window.clone(), url.to_string(), format.to_string());
+        let (tx, rx) = std::sync::mpsc::channel();
+        app.run_on_main_thread(move || {
+            let result = (|| -> Result<(), String> {
+                let area = attach(&window, &label)?;
+                let h = match handle_of(&label) {
+                    Some(h) => h,
+                    None => {
+                        let h = start(&app2, &id, &label, volume)?;
+                        players().lock().unwrap_or_else(|p| p.into_inner()).insert(label.clone(), Player { handle: h as usize });
+                        h
+                    }
+                };
+                if let Some(o) = opacities().lock().unwrap_or_else(|p| p.into_inner()).get(&label) {
+                    area.set_opacity(*o);
+                }
+                area.set_visible(true);
+                area.queue_render();
+                let f = CString::new("ytdl-format").unwrap_or_default();
+                let fv = CString::new(format.as_str()).map_err(|e| e.to_string())?;
+                if let Ok(m) = mpv() {
+                    unsafe { (m.set_property_string)(h, f.as_ptr(), fv.as_ptr()) };
+                }
+                set(&label, "volume", &format!("{volume:.0}"))?;
+                set(&label, "pause", "no")?;
+                command(h, &["loadfile", &url, "replace"])
+            })();
+            let _ = tx.send(result);
+        }).map_err(|e| e.to_string())?;
+        rx.recv_timeout(std::time::Duration::from_secs(10)).map_err(|_| "the video didn't start".to_string())?
+    }
+
+    /// Each widget's video opacity, kept for its next video too.
+    fn opacities() -> &'static Mutex<HashMap<String, f64>> {
+        static O: std::sync::OnceLock<Mutex<HashMap<String, f64>>> = std::sync::OnceLock::new();
+        O.get_or_init(Mutex::default)
+    }
+
+    pub fn opacity(app: &tauri::AppHandle, label: &str, value: f64) -> Result<(), String> {
+        opacities().lock().unwrap_or_else(|p| p.into_inner()).insert(label.to_string(), value);
+        let label = label.to_string();
+        app.run_on_main_thread(move || {
+            VIEWS.with(|v| {
+                if let Some(view) = v.borrow().get(&label) {
+                    view.area.set_opacity(value);
+                }
+            });
+        }).map_err(|e| e.to_string())
+    }
+
+    /// Stop: mpv ends, the area hides, the widget's page alone shows.
+    pub fn stop(app: &tauri::AppHandle, label: &str) -> Result<(), String> {
+        let label = label.to_string();
+        app.run_on_main_thread(move || {
+            if let Some(h) = handle_of(&label) {
+                let _ = command(h, &["stop"]);
+            }
+            VIEWS.with(|v| {
+                if let Some(view) = v.borrow().get(&label) {
+                    view.area.set_visible(false);
+                }
+            });
+        }).map_err(|e| e.to_string())
+    }
+}
