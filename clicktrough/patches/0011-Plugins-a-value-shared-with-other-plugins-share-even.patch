diff --git a/src-tauri/src/plugins/mod.rs b/src-tauri/src/plugins/mod.rs
index 31fd104..05675cf 100644
--- a/src-tauri/src/plugins/mod.rs
+++ b/src-tauri/src/plugins/mod.rs
@@ -379,6 +379,40 @@ pub struct PluginHost {
 static WORLD: Mutex<Option<world::World>> = Mutex::new(None);
 static WORLD_WANTED: AtomicBool = AtomicBool::new(false);
 
+/// Clicktrough: what plugins with "share" shared (`a2.share`), by plugin, for
+/// plugins with "events:shared" (a map showing the pets a tracker follows).
+static SHARED: Mutex<Option<HashMap<String, Value>>> = Mutex::new(None);
+/// A shared value is at most this big (as JSON).
+const MAX_SHARED: usize = 64 * 1024;
+
+fn shared_values() -> serde_json::Map<String, Value> {
+    SHARED.lock().unwrap_or_else(|p| p.into_inner()).as_ref().map(|m| m.clone().into_iter().collect()).unwrap_or_default()
+}
+
+/// Clicktrough: a plugin shares a value with the plugins allowed to hear it
+/// (permission "share"); they hear a2.on("shared", { plugin, value }) at once,
+/// and every value shared so far when they start. `null` withdraws it.
+#[tauri::command]
+pub fn plugin_share(app: tauri::AppHandle, window: tauri::WebviewWindow, plugin: Option<String>, value: String) -> Result<(), String> {
+    let id = window_plugin(&window, plugin.as_deref())?;
+    require(&app, &id, "share")?;
+    if value.len() > MAX_SHARED {
+        return Err(format!("a shared value is at most {MAX_SHARED} bytes"));
+    }
+    let value: Value = serde_json::from_str(&value).map_err(|e| e.to_string())?;
+    {
+        let mut slot = SHARED.lock().unwrap_or_else(|p| p.into_inner());
+        let map = slot.get_or_insert_with(HashMap::new);
+        if value.is_null() {
+            map.remove(&id);
+        } else {
+            map.insert(id.clone(), value.clone());
+        }
+    }
+    host(&app)?.tell_permitted(&app, "events:shared", "shared", serde_json::json!({ "plugin": id, "value": value }));
+    Ok(())
+}
+
 fn with_world<T>(f: impl FnOnce(&mut world::World) -> T) -> T {
     let mut slot = WORLD.lock().unwrap_or_else(|p| p.into_inner());
     f(slot.get_or_insert_with(world::World::default))
@@ -577,6 +611,10 @@ impl PluginHost {
         let any_decoders = loaded.iter().any(|l| !l.decoders.is_empty());
